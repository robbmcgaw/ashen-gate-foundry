{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashen-gate.local/schemas/scene-moods.schema.json",
  "title": "Scene mood presets (reference shape)",
  "description": "Manager has no file import for these yet; presets are added in Manager > Scenes or via api.sceneMoods.savePreset(preset).",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "label",
      "set"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "isDefault": {
        "type": "boolean"
      },
      "set": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "environment.darknessLevel": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "environment.globalLight.enabled": {
            "type": "boolean"
          },
          "environment.base.hue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "environment.base.intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "environment.base.luminosity": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "environment.base.saturation": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "environment.base.shadows": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "environment.dark.hue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "environment.dark.intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "environment.dark.luminosity": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "weather": {
            "type": "string",
            "description": "'' (no weather) or a CONFIG.weatherEffects id, e.g. leaves, rain, rainStorm, fog, snow, blizzard."
          }
        }
      }
    }
  }
}