<div class="agst-shell">
  <header class="ag-header">
    <div class="ag-header__title"><h1><span class="ag-header__brand">Ashen Gate</span> | Skill Trees</h1></div>
    <div class="ag-header__meta"><span class="ag-version">v{{moduleVersion}}</span><button type="button" class="ag-btn ag-btn--ghost ag-btn--sm" data-act="help"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> Help</button></div>
  </header>
  <nav class="ag-tabs ag-tabs--scroll" role="tablist" aria-label="Skill Trees views">
    <button type="button" role="tab" data-act="tab-trees" class="{{#if activeTrees}}active{{/if}}" aria-selected="{{#if activeTrees}}true{{else}}false{{/if}}"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Skill Trees</button>
    {{#if gm}}<button type="button" role="tab" data-act="tab-library" class="ag-tab--gm {{#if activeLibrary}}active{{/if}}" aria-selected="{{#if activeLibrary}}true{{else}}false{{/if}}"><i class="fa-solid fa-book" aria-hidden="true"></i> Tree Library</button><button type="button" role="tab" data-act="tab-setup" class="ag-tab--gm {{#if activeSetup}}active{{/if}}" aria-selected="{{#if activeSetup}}true{{else}}false{{/if}}"><i class="fa-solid fa-gears" aria-hidden="true"></i> GM Setup</button>{{/if}}
  </nav>

  {{#if activeTrees}}{{#if initialized}}
  <div class="agst-layout {{#if sidebarOpen}}agst-sidebar-open{{/if}}">
    <aside class="agst-sidebar" id="agst-sidebar" aria-label="Skill tree menu">
      <section class="agst-side-pin" aria-label="Tree and character">
        <label class="ag-field">Tree<select id="agst-tree-choice" aria-label="Select skill tree">{{#if treeGroups}}{{#each treeGroups}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}{{else}}{{#each trees}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}{{/if}}</select></label>
        {{#if treeTabs}}<div class="agst-tree-tabs">{{{treeTabs}}}</div>{{/if}}
        <label class="ag-field">Character<select id="agst-actor-choice" aria-label="Select character">{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      </section>
      {{#if hasTree}}{{{sideTabs}}}{{/if}}
      <div class="agst-sidebar-scroll">
        {{#if hasTree}}
        <section class="agst-side-panel agst-inspector" {{{sidePanel.perk}}}>
          {{#if selected}}
            <div class="agst-inspector-head">{{#if selected.img}}<img class="agst-inspector-img" src="{{selected.img}}" alt="">{{/if}}<small class="ag-eyebrow">Selected perk</small><h2>{{selected.name}}</h2><span class="ag-badge {{selected.badgeClass}}">{{selected.stateText}}</span></div>
            <div class="agst-inspector-body">{{#if selected.description}}<p>{{selected.description}}</p>{{/if}}<div class="agst-inspector-line"><strong>Points:</strong> {{selected.cost}}</div>
              <div class="agst-inspector-line"><strong>Unlock:</strong> {{selected.reason}}</div>
              {{#if accessGate}}<div class="agst-inspector-line agst-access"><strong>Who can pick:</strong> {{accessGate.text}}{{#if accessGate.gmNote}} (players only; the GM can still unlock and grant){{else}}{{#if accessGate.met}} <span class="agst-ok"><i class="fa-solid fa-check" aria-hidden="true"></i> met</span>{{/if}}{{/if}}</div>{{/if}}
              {{#if selected.rel.all.length}}<div class="agst-rel"><strong>Requires all of</strong><ul>{{#each selected.rel.all}}<li><button type="button" class="ag-link" data-act="select" data-id="{{id}}">{{name}}</button>{{#if unlocked}} <span class="agst-ok"><i class="fa-solid fa-check" aria-hidden="true"></i> unlocked</span>{{/if}}</li>{{/each}}</ul></div>{{/if}}
              {{#each selected.rel.any}}<div class="agst-rel agst-rel-any"><strong>Requires one of (OR group {{index}})</strong><ul>{{#each nodes}}<li><button type="button" class="ag-link" data-act="select" data-id="{{id}}">{{name}}</button>{{#if unlocked}} <span class="agst-ok"><i class="fa-solid fa-check" aria-hidden="true"></i> unlocked</span>{{/if}}</li>{{/each}}</ul></div>{{/each}}
              {{#if selected.rel.excludes.length}}<div class="agst-rel agst-rel-exclude"><strong>Rival perks (choose one)</strong><ul>{{#each selected.rel.excludes}}<li><button type="button" class="ag-link" data-act="select" data-id="{{id}}">{{name}}</button>{{#if unlocked}} <span class="agst-bad">taken</span>{{/if}}</li>{{/each}}</ul></div>{{/if}}
              {{#if selected.rel.leadsTo.length}}<div class="agst-rel"><strong>Opens the way to</strong><ul>{{#each selected.rel.leadsTo}}<li><button type="button" class="ag-link" data-act="select" data-id="{{id}}">{{name}}</button></li>{{/each}}</ul></div>{{/if}}
              {{#if gm}}{{#unless preview}}
                {{#if bindingNote}}<div class="agst-inspector-line"><strong>Perk:</strong> {{bindingName}} {{#if selectedBinding}}<span class="agst-ok"><i class="fa-solid fa-check" aria-hidden="true"></i> in this world</span>{{else}}<span class="agst-warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> not in this world: import it through General Manager</span>{{/if}}
                  <details class="ag-fold" data-ag-fold-key="perk-details"><summary class="ag-fold__summary"><span class="ag-fold__title">Details</span></summary><div class="ag-fold__body"><code>{{bindingNote}}</code> <button type="button" class="ag-btn ag-btn--sm" data-act="copy-id" data-copy="{{bindingNote}}"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></div></details></div>{{/if}}
                {{#if selectedCustom}}<div class="agst-inspector-line agst-warn">Older custom node: no perk assigned, so unlocking gives no Item. Edit layout → Assign perk.</div>{{/if}}
                <div class="agst-inspector-line"><strong>Node status:</strong> {{selected.statusText}} · {{selected.visibilityText}} · {{selected.displayText}}</div>
              {{/unless}}{{/if}}
            </div>
            <div class="agst-inspector-actions">
              {{#if canBuy}}<button type="button" data-act="purchase" class="ag-btn ag-btn--primary"><i class="fa-solid fa-unlock" aria-hidden="true"></i> Unlock for {{actorName}}…</button>{{/if}}
              {{#if canRequest}}<button type="button" data-act="request" class="ag-btn ag-btn--primary"><i class="fa-solid fa-unlock" aria-hidden="true"></i> Unlock ({{selected.cost}} pt)…</button>{{/if}}
              {{#if canOverride}}<button type="button" data-act="override" class="ag-btn" data-tooltip="Give this perk whatever the points, level or prerequisites, with a reason" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-gavel" aria-hidden="true"></i> Grant (GM override)…</button>{{/if}}
              {{#if canKeep}}<button type="button" data-act="keep" class="ag-btn" data-tooltip="Keep this perk although the level no longer covers it" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Keep at this level…</button>{{/if}}
              {{#if canRefund}}<button type="button" data-act="refund" class="ag-btn ag-btn--danger"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{#if isProfession}}Remove (point returned)…{{else}}Refund (removes perk from sheet)…{{/if}}</button>{{/if}}
              {{#if editing}}
                <button type="button" class="ag-btn" data-act="assign-perk"><i class="fa-solid fa-star" aria-hidden="true"></i> {{#if selectedCustom}}Assign perk…{{else}}Change perk…{{/if}}</button>
                <button type="button" class="ag-btn" data-act="edit-node"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Edit properties…</button>
                <button type="button" class="ag-btn" data-act="link"><i class="fa-solid fa-link" aria-hidden="true"></i> Connect prerequisite</button>
                <button type="button" class="ag-btn" data-act="move-node" data-tooltip="Set the node's position; arrow keys on a focused node also move it" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-up-down-left-right" aria-hidden="true"></i> Move node…</button>
                <button type="button" class="ag-btn ag-btn--danger" data-act="remove-node"><i class="fa-solid fa-trash" aria-hidden="true"></i> Remove node…</button>
              {{/if}}
            </div>
          {{else}}
            <div class="ag-empty"><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i><p class="ag-empty__title">No perk selected</p><p class="ag-empty__text">Select a node on the canvas (or in “Tree as a list”) to see what it needs and what it opens.</p></div>
          {{/if}}
          <details class="ag-fold agst-tree-list" data-ag-fold-key="tree-list"><summary class="ag-fold__summary"><span class="ag-fold__title">Tree as a list</span><span class="ag-fold__count">{{nodes.length}}</span></summary>
            <div class="ag-fold__body"><ol>{{#each nodes}}<li><button type="button" class="ag-link" data-act="select" data-id="{{id}}">{{name}}</button> — {{stateText}}{{#unless silhouette}}, {{cost}} pt{{/unless}}{{#if relText}}. {{relText}}{{/if}}</li>{{/each}}</ol></div>
          </details>
        </section>

        <section class="agst-side-panel" {{{sidePanel.character}}}>
          {{#if prof}}
          <div class="agst-pool">
            <span class="agst-stat"><small class="ag-eyebrow">Level</small><b>{{prof.levelText}}</b></span>
            <span class="agst-stat"><small class="ag-eyebrow">To choose</small><b>{{prof.available}}</b></span>
            <span class="agst-stat"><small class="ag-eyebrow">Used</small><b>{{prof.spent}}</b></span>
          </div>
          <p class="agst-help agst-prof-summary">{{prof.spent}} of {{prof.earned}} points used (1 per profession level, {{prof.maxPoints}} at most) · {{prof.nodeCount}} perks in this tree</p>
          {{#if prof.sharedText}}<p class="agst-help agst-prof-shared">{{prof.sharedText}}</p>{{/if}}
          {{else}}
          <div class="agst-pool">
            <span class="agst-stat"><small class="ag-eyebrow">Awarded</small><b>{{progress.awarded}}</b></span>
            <span class="agst-stat"><small class="ag-eyebrow">Available</small><b>{{progress.available}}</b></span>
            <span class="agst-stat"><small class="ag-eyebrow">Unlocked</small><b>{{progress.unlocks}}</b></span>
          </div>
          {{/if}}
          <span class="ag-badge agst-provider">{{mode}}</span>
          {{#if canGrant}}<div class="agst-btn-row"><button type="button" class="ag-btn" data-act="grant"><i class="fa-solid fa-plus" aria-hidden="true"></i> Award points…</button></div>{{/if}}
          {{#if roster.length}}
          <div class="agst-roster">
            <h3 class="ag-eyebrow">Characters</h3>
            <ul class="agst-roster-list">{{#each roster}}<li class="{{#if selected}}is-selected{{/if}}"><button type="button" class="ag-link" data-act="pick-actor" data-id="{{id}}">{{name}}</button>
              <span class="agst-roster-meta">Lvl {{level}} · {{spent}}/{{earned}} pts</span> <span class="ag-badge {{#if review}}ag-badge--warn{{else}}{{#if toChoose}}ag-badge--ok{{/if}}{{/if}}">{{status}}</span></li>{{/each}}</ul>
          </div>
          {{/if}}
          {{#if history.length}}
          <details class="ag-fold agst-history" data-ag-fold-key="history"><summary class="ag-fold__summary"><span class="ag-fold__title">History for {{actorName}}</span><span class="ag-fold__count">{{history.length}}</span></summary>
            <div class="ag-fold__body"><ol>{{#each history}}<li><strong>{{label}}</strong> {{node}}{{#if level}} · level {{level}}{{/if}} · {{byName}} · <small>{{when}}</small>{{#if undone}} <span class="ag-badge">Undone</span>{{/if}}{{#if reason}}<br><small>{{reason}}</small>{{/if}}{{#if canUndo}} <button type="button" class="ag-btn ag-btn--sm" data-act="undo-history" data-id="{{id}}" aria-label="Undo {{label}}: {{node}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Undo…</button>{{/if}}</li>{{/each}}</ol></div>
          </details>
          {{/if}}
          {{#if canReset}}
          <details class="ag-fold agst-reset" data-ag-fold-key="reset"><summary class="ag-fold__summary"><span class="ag-fold__title">Reset this tree…</span></summary>
            <div class="ag-fold__body"><p class="ag-field__hint">Refunds every unlock {{actorName}} has on this tree and removes the perks it gave from the sheet. Points awarded stay.</p>
              <button type="button" class="ag-btn ag-btn--danger" data-act="reset-tree"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Reset tree for {{actorName}}…</button></div>
          </details>
          {{/if}}
        </section>

        {{#if gm}}
        <section class="agst-side-panel" {{{sidePanel.edit}}}>
          {{#if preview}}
            <div class="ag-empty"><i class="fa-solid fa-eye" aria-hidden="true"></i><p class="ag-empty__title">Player preview is on</p><p class="ag-empty__text">Turn off Player preview above the canvas to edit this tree.</p></div>
          {{else}}{{#if editing}}
            <div class="agst-btn-row">
              <button type="button" class="ag-btn ag-btn--sm" data-act="tree-settings"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Tree settings…</button>
              <button type="button" class="ag-btn ag-btn--sm" data-act="appearance" data-tooltip="Node size, canvas background, level/tier bands and icons" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-image" aria-hidden="true"></i> Appearance…</button>
              <button type="button" class="ag-btn ag-btn--sm" data-act="undo" {{#unless canUndoEdit}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Undo</button>
              <button type="button" class="ag-btn ag-btn--sm" data-act="redo" {{#unless canRedoEdit}}disabled{{/unless}}><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Redo</button>
            </div>
            <div class="agst-feature-shelf" role="group" aria-label="Perks in this world"><h3>Perks</h3><p class="agst-help">Drag a perk onto the canvas (from here or the Items sidebar), or press <strong>Add</strong>. The node takes its name, text, picture and point cost from the perk.</p>
              <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="agst-feature-search" type="search" placeholder="Search perks" value="{{search}}" aria-label="Search perks"></label>
              <div class="agst-feature-list">
                {{#each features}}<div class="agst-feature {{#if onTree}}agst-feature-used{{/if}}" draggable="true" data-uuid="{{uuid}}">{{#if img}}<img class="agst-feature-img" src="{{img}}" alt="">{{else}}<i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>{{/if}}<div><strong>{{name}}</strong><small>{{statusText}}</small></div>{{#if onTree}}<span class="ag-badge">On tree</span>{{else}}<button type="button" class="ag-btn ag-btn--sm agst-add-perk" data-act="add-perk" data-uuid="{{uuid}}" aria-label="Add {{name}} to this tree">Add</button>{{/if}}</div>{{else}}<div class="ag-empty"><p class="ag-empty__title">No perks yet</p><p class="ag-empty__text">No perk Items of the right type are in this world. Import perks through General Manager first.</p></div>{{/each}}
              </div>
            </div>
          {{else}}
            <div class="ag-empty"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><p class="ag-empty__title">Editing is off</p><p class="ag-empty__text">Turn on Edit layout above the canvas to add perks, move nodes and change this tree's settings and look.</p></div>
          {{/if}}{{/if}}
        </section>
        {{/if}}
        {{/if}}
      </div>
    </aside>
    <button type="button" class="agst-scrim" data-act="toggle-sidebar" tabindex="-1" aria-label="Close menu"></button>

    <section class="agst-canvas-pane" {{#if treeTabs}}{{{treePanel}}}{{else}}aria-label="Skill tree canvas"{{/if}}>
      <div class="agst-canvas-bar">
        <button type="button" class="ag-btn ag-btn--sm agst-menu-toggle" data-act="toggle-sidebar" aria-controls="agst-sidebar" aria-expanded="{{#if sidebarOpen}}true{{else}}false{{/if}}" data-tooltip="Show or hide the menu" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-bars" aria-hidden="true"></i> Menu</button>
        <span class="agst-canvas-title">{{#if hasTree}}{{tree.name}}{{/if}}</span>
        {{#if gm}}{{#if hasTree}}<span class="agst-modes">
          <button type="button" data-act="player-preview" class="ag-btn ag-btn--ghost ag-btn--sm" aria-pressed="{{#if preview}}true{{else}}false{{/if}}" data-tooltip="Show the sanitized player view" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-eye" aria-hidden="true"></i> Player preview</button>
          {{#unless preview}}<button type="button" data-act="edit-mode" class="ag-btn ag-btn--ghost ag-btn--sm" aria-pressed="{{#if editing}}true{{else}}false{{/if}}" data-tooltip="Add perks, move nodes and change prerequisites" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> Edit layout</button>{{/unless}}
        </span>{{/if}}{{/if}}
        <span class="agst-zoom"><button type="button" class="ag-btn ag-btn--sm ag-btn--icon" data-act="zoom-out" data-tooltip="Zoom out" data-tooltip-class="ag-tooltip" aria-label="Zoom out"><i class="fa-solid fa-minus" aria-hidden="true"></i></button><span class="agst-zoom-label">{{zoomText}}</span><button type="button" class="ag-btn ag-btn--sm ag-btn--icon" data-act="zoom-in" data-tooltip="Zoom in" data-tooltip-class="ag-tooltip" aria-label="Zoom in"><i class="fa-solid fa-plus" aria-hidden="true"></i></button><button type="button" class="ag-btn ag-btn--sm ag-btn--icon" data-act="zoom-reset" data-tooltip="Fit tree to window" data-tooltip-class="ag-tooltip" aria-label="Fit tree to window"><i class="fa-solid fa-expand" aria-hidden="true"></i></button></span>
      </div>
      {{#if ledgerMissing}}<div class="ag-notice ag-notice--warn agst-canvas-notice" role="status"><i class="fa-solid fa-link-slash" aria-hidden="true"></i><span>Profession Ledger is not active, so profession points are unavailable. Nothing is removed; picks wait until it is on again.</span></div>{{/if}}
      {{#if prof.overAllocated}}<div class="ag-notice ag-notice--warn agst-canvas-notice agst-notice-review" role="alert"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span><strong>{{actorName}} needs GM review.</strong> Level {{prof.levelText}} no longer covers {{#if prof.aboveText}}{{prof.aboveText}}{{else}}{{prof.overSpentText}}{{/if}}. Nothing was removed. {{#if gm}}<button type="button" class="ag-btn ag-btn--sm" data-act="resolve"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> Review…</button>{{else}}New picks wait until the GM has looked at it.{{/if}}</span></div>{{/if}}
      {{#if isTest}}<div class="ag-notice ag-notice--info agst-canvas-notice" role="status"><i class="fa-solid fa-flask" aria-hidden="true"></i><span>Test tree. Unlocking adds the perk Item to the sheet; perks with no rules effect do nothing else.</span></div>{{/if}}
      {{#if preview}}<div class="ag-notice ag-notice--info agst-canvas-notice" role="status"><i class="fa-solid fa-eye" aria-hidden="true"></i><span>Player preview: this is the shared sanitized tree, limited to the trees the chosen character holds (change the character to see as another). Test again from a player account to check document permissions.</span></div>{{/if}}
      {{#if linkFrom}}<div class="ag-notice ag-notice--info agst-canvas-notice" role="status"><i class="fa-solid fa-link" aria-hidden="true"></i><span>Connecting from <strong>{{linkFromName}}</strong>: select the node it opens. The arrow points from this node to that one (required). Esc cancels.</span><button type="button" class="ag-btn ag-btn--sm" data-act="cancel-link">Cancel connecting</button></div>{{/if}}
      {{#if hasTree}}
        <div class="agst-stage">
          {{#if bg.fixed}}<div class="agst-bg agst-bg-fixed" style="{{bg.style}}" aria-hidden="true"></div>{{/if}}
          <div class="agst-viewport">
            <div class="agst-board {{sizeClass}}" style="width:{{mapWidth}}px;height:{{mapHeight}}px;" tabindex="0" aria-label="Skill tree. Scroll to move around; Ctrl and mouse wheel zooms.{{#if editing}} In Edit layout, arrow keys move the focused node (Shift for bigger steps).{{/if}}">
              {{#if bg}}{{#unless bg.fixed}}<div class="agst-bg {{#if bg.tile}}agst-bg-tile{{else}}agst-bg-cover{{/if}}" style="{{bg.style}}" aria-hidden="true"></div>{{/unless}}{{/if}}
              {{#each tiers}}<div class="agst-tier {{#if alt}}agst-tier-alt{{/if}}" style="top:{{top}}px;height:{{height}}px;"><span class="agst-tier-badge" style="{{iconStyle}}"><span class="agst-tier-fallback" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span><b>{{level}}</b></span><span class="agst-tier-name">{{text}}</span></div>{{/each}}
              {{#each lanes}}<div class="agst-lane" style="left:{{x}}px;top:{{y}}px;">{{text}}</div>{{/each}}
              <svg class="agst-links" width="{{mapWidth}}" height="{{mapHeight}}" aria-hidden="true">
                <defs>
                  <marker id="agst-arrow-all" class="agst-arrow agst-arrow-all" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto"><path d="M0,0 L10,5 L0,10 z"></path></marker>
                  <marker id="agst-arrow-any" class="agst-arrow agst-arrow-any" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto"><path d="M0,0 L10,5 L0,10 L3,5 z"></path></marker>
                  <marker id="agst-arrow-active" class="agst-arrow agst-arrow-active" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto"><path d="M0,0 L10,5 L0,10 z"></path></marker>
                </defs>
                {{#each edges}}<path data-edge data-from="{{from}}" data-to="{{to}}" d="{{d}}" class="agst-link agst-link-{{kind}} {{#if active}}agst-linked{{/if}}" marker-end="{{marker}}"></path>{{/each}}
                {{#each edges}}{{#if label}}<text data-edge data-from="{{from}}" data-to="{{to}}" x="{{mx}}" y="{{my}}" class="agst-edge-label agst-edge-label-{{kind}}" text-anchor="middle" dominant-baseline="central">{{label}}</text>{{/if}}{{/each}}
              </svg>
              {{#each nodes}}
                <button type="button" class="agst-node {{#if selected}}agst-selected{{/if}} {{#if unlocked}}agst-unlocked{{else}}{{#if eligible}}agst-eligible{{else}}agst-locked{{/if}}{{/if}} {{#if rival}}agst-rival{{/if}} {{#if crossroads}}agst-crossroads{{/if}} {{#if silhouette}}agst-silhouette{{/if}} {{#if perkMissing}}agst-node-warn{{/if}} {{#if overLevel}}agst-node-review{{/if}}" data-act="open-perk" data-id="{{id}}" style="{{style}}" aria-label="{{label}}" aria-current="{{#if selected}}true{{else}}false{{/if}}">
                  <span class="agst-node-icon">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid {{#if silhouette}}fa-question{{else}}fa-star{{/if}}" aria-hidden="true"></i>{{/if}}</span>
                </button>
              {{/each}}
              {{#unless nodes}}<div class="agst-board-empty"><div class="ag-empty"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i><p class="ag-empty__title">No perks on this tree yet</p><p class="ag-empty__text">{{#if gm}}Turn on Edit layout, then add perks from the Edit tab.{{else}}Your GM hasn't revealed any perks on this tree yet.{{/if}}</p></div></div>{{/unless}}
            </div>
          </div>
          <div class="agst-tip" role="status" aria-live="polite" hidden></div>
        </div>
        <div class="agst-legend" role="note" aria-label="Line key">
          <span><svg width="38" height="12" aria-hidden="true"><path class="agst-link agst-link-all" d="M 2 6 L 34 6" marker-end="url(#agst-arrow-all)"></path></svg> Required</span>
          <span><svg width="38" height="12" aria-hidden="true"><path class="agst-link agst-link-any" d="M 2 6 L 34 6" marker-end="url(#agst-arrow-any)"></path></svg> <b>OR</b>: any one</span>
          <span><svg width="38" height="12" aria-hidden="true"><path class="agst-link agst-link-exclude" d="M 2 6 L 36 6"></path></svg> <b>Choose one</b>: rival perks</span>
          <span><i class="agst-key agst-key-locked" aria-hidden="true"></i> Locked</span>
          <span><i class="agst-key agst-key-available" aria-hidden="true"></i> Available</span>
          <span><i class="agst-key agst-key-learned" aria-hidden="true"></i> Learned</span>
          <span><i class="agst-key agst-key-rival" aria-hidden="true"></i> Rival pair</span>
          <span><i class="agst-key agst-key-crossroads" aria-hidden="true"></i> Crossroads</span>
          <span><svg width="38" height="12" aria-hidden="true"><path class="agst-link agst-link-all agst-linked" d="M 2 6 L 34 6" marker-end="url(#agst-arrow-active)"></path></svg> Both unlocked</span>
        </div>
        {{#if editing}}<div class="agst-canvas-help">Drag a node, or focus it and use the arrow keys (Shift: bigger steps), to move it · Add perks from the Edit tab · Click a node to select it, then Connect prerequisite (required) or Edit properties (OR groups, exclusions) · Open perk sheet is on the node's card.</div>{{else}}<div class="agst-canvas-help">Hover or Tab to a perk to read it · Click to open its sheet · Right-click, or press Shift+Enter, to unlock or refund.</div>{{/if}}
      {{else}}
        <div class="agst-pane-pad"><div class="ag-empty"><i class="fa-solid fa-map" aria-hidden="true"></i><p class="ag-empty__title">No skill trees yet</p><p class="ag-empty__text">{{#if gm}}Create one with New tree in the Tree Library tab, or import a tree file through General Manager.{{else}}{{emptyText}}{{/if}}</p></div></div>
      {{/if}}
    </section>
  </div>
  {{/if}}{{!-- initialized --}}
  {{#unless initialized}}
    <div class="agst-pane-pad"><div class="ag-empty"><i class="fa-solid fa-lock" aria-hidden="true"></i><p class="ag-empty__title">No tree workspace yet</p><p class="ag-empty__text">Open {{{libraryLink}}} and choose Initialize GM storage.</p></div></div>
  {{/unless}}
  {{/if}}{{!-- activeTrees --}}

  {{#if activeLibrary}}
  {{#if initialized}}
  <div class="agst-setup" aria-label="Tree Library for Skill Trees">
    {{{libraryTabs}}}
    <div class="agst-setup-main" {{{libraryPanel.trees}}}>
      <div class="ag-toolbar">
        <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-agst-library-search placeholder="Search trees" aria-label="Search trees" value="{{libraryQuery}}"></label>
        <label class="ag-field agst-library-select">Folders<select data-agst-library-group aria-label="Group trees in folders by">{{#each libraryGroupOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="ag-field agst-library-select">Sort<select data-agst-library-sort aria-label="Sort trees by">{{#each librarySortOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <span class="ag-toolbar__count" data-agst-library-count role="status">{{libraryCountText}}</span>
        <div class="ag-toolbar__end"><button type="button" class="ag-btn" data-act="export-all"><i class="fa-solid fa-download" aria-hidden="true"></i> Export all trees</button><button type="button" data-act="create-tree" class="ag-btn"><i class="fa-solid fa-plus" aria-hidden="true"></i> New tree…</button></div>
      </div>
      {{#if libraryHasTrees}}{{{libraryFilters}}}{{/if}}
      <section class="ag-card" aria-label="Trees">
        <div class="ag-card__head"><h2 class="ag-card__title">Trees</h2><span class="ag-card__meta">{{publishedCount}} published to players</span></div>
        <div class="agst-library-region" data-agst-library-region>{{{libraryHtml}}}</div>
        <p class="ag-field__hint">Exports are backups of the GM layouts (<code>ag-skill-trees/0.3</code>). Tree files are imported through <strong>General Manager → Import</strong>, which hands them to Skill Trees.</p>
      </section>
    </div>
    <div class="agst-setup-main" {{{libraryPanel.checks}}}>
      <section class="ag-card" aria-label="Saved data check">
        <h2 class="ag-card__title">Saved data check</h2>
        {{#if hasSetupReport}}<p>These nodes need attention. Nothing has been changed or removed.</p>
          <ul class="agst-report">{{#each setupReport}}<li><strong>{{treeName}}</strong> · {{nodeName}}: {{text}}</li>{{/each}}</ul>
        {{else}}<p>Every node has a perk that is in this world.</p>{{/if}}
        <p>{{#if missingGrants}}<strong>{{missingGrantsText}}</strong> not on their character sheet yet.{{else}}Every unlocked perk is on its character sheet.{{/if}}</p>
        <div class="ag-card__actions"><button type="button" class="ag-btn" data-act="give-missing" {{#unless missingGrants}}disabled{{/unless}}><i class="fa-solid fa-user-plus" aria-hidden="true"></i> Give missing perks…</button></div>
        {{#unless missingGrants}}<p class="ag-field__hint agst-hint-right">Give missing perks: nothing is missing.</p>{{/unless}}
      </section>
      <section class="ag-card" aria-label="Profession perk check">
        <h2 class="ag-card__title">Profession perk check</h2>
        {{#if professionReport.length}}<p>Characters whose profession perks need a look. Nothing has been changed or removed. Open the tree with the character selected to fix it.</p>
          <ul class="agst-report">{{#each professionReport}}<li><strong>{{actorName}}</strong> · {{treeName}} (level {{level}}, {{spent}} of {{earned}} points)<ul>{{#each issues}}<li>{{detail}}</li>{{/each}}</ul>
            <button type="button" class="ag-btn ag-btn--sm" data-act="open-row" data-tree="{{treeId}}" data-actor="{{actorId}}" aria-label="Open {{treeName}} for {{actorName}}"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Open</button></li>{{/each}}</ul>
        {{else}}<p>Every character's profession perks match their level, and every allocated perk is on its sheet.</p>{{/if}}
      </section>
      <section class="ag-card" aria-label="Older saved data">
        <h2 class="ag-card__title">Older saved data</h2>
        <p>One-time moves of older saved data. Each one shows what will happen and asks before it changes anything.</p>
        <div class="ag-card__actions agst-actions-start">
          <button type="button" class="ag-btn" data-act="ledger-import" data-tooltip="Allocate perks chosen in older Profession Ledger data on profession trees; shows what would happen first" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-file-import" aria-hidden="true"></i> Import Ledger perk choices…</button>
          {{#if legacy}}<button type="button" class="ag-btn" data-act="legacy-preview"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> Migrate legacy trees ({{legacy}})…</button><button type="button" data-act="legacy-clear" class="ag-btn ag-btn--danger"><i class="fa-solid fa-box-archive" aria-hidden="true"></i> Back up and clear legacy setting…</button>{{/if}}
        </div>
      </section>
      <section class="ag-card" aria-label="Publication and backups">
        <h2 class="ag-card__title">Publication and backups</h2>
        <p>Players see a separately sanitized copy of each tree. Every tree edit refreshes it; republish only if players see an old tree. Publishing never grants perks, points or character ownership.</p>
        <div class="ag-card__actions agst-actions-start">
          <button type="button" class="ag-btn" data-act="backup-progress"><i class="fa-solid fa-box-archive" aria-hidden="true"></i> Back up character progress</button>
          <button type="button" class="ag-btn" data-act="publish"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Republish player view</button>
        </div>
      </section>
    </div>
  </div>
  {{else}}
    <div class="agst-pane-pad">
      <div class="ag-empty"><i class="fa-solid fa-lock" aria-hidden="true"></i>
        <p class="ag-empty__title">No tree workspace yet</p>
        <p class="ag-empty__text">Tree definitions are stored in a GM-only Journal. Players receive a separate, sanitized view. Nothing old is migrated or overwritten.</p>
        <button data-act="initialize" type="button" class="ag-btn ag-btn--primary"><i class="fa-solid fa-lock" aria-hidden="true"></i> Initialize GM storage…</button></div>
    </div>
  {{/if}}
  {{/if}}{{!-- activeLibrary --}}

  {{#if activeSetup}}
  <div class="agst-setup" role="group" aria-label="GM Setup for Skill Trees" data-agst-setup>
    <div class="agst-setup-main">
      {{#unless initialized}}<div class="ag-notice ag-notice--info" role="status"><i class="fa-solid fa-lock" aria-hidden="true"></i><span>No tree workspace yet. Open {{{libraryLink}}} to initialize GM storage. Player access can be set now.</span></div>{{/unless}}
      <section class="ag-card" aria-label="Player access">
        <h2 class="ag-card__title">Player access</h2>
        <label class="ag-field ag-field--inline"><input type="checkbox" name="playerAccessEnabled" {{#if playerAccessEnabled}}checked{{/if}}> Show Skill Trees to players</label>
        <p class="ag-field__hint">Controls the players' launcher and window only. Points, unlocks and character sheets never change. Saved with Save Changes.</p>
      </section>
      {{#if initialized}}
      <details class="ag-devtools">
        <summary><i class="fa-solid fa-flask" aria-hidden="true"></i> Developer Tools</summary>
        <p>For a disposable test world. Install creates clearly marked [AG QA] test documents and tree layouts; Reset removes only those.</p>
        <div class="ag-card__actions agst-actions-start">
          <button type="button" class="ag-btn" data-act="qa-install"><i class="fa-solid fa-vial" aria-hidden="true"></i> Install QA fixture records…</button>
          <button type="button" data-act="qa-reset" class="ag-btn ag-btn--danger"><i class="fa-solid fa-trash-can" aria-hidden="true"></i> Reset QA fixture…</button>
        </div>
      </details>
      {{/if}}
    </div>
    <footer class="ag-footer">
      <button type="button" class="ag-btn ag-btn--ghost" data-act="setup-cancel">Cancel</button>
      <span class="ag-footer__status" role="status" data-agst-setup-status>{{#if setupDirty}}Unsaved changes{{/if}}</span>
      <button type="button" class="ag-btn ag-btn--primary" data-act="setup-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Changes</button>
    </footer>
  </div>
  {{/if}}{{!-- activeSetup --}}
</div>
