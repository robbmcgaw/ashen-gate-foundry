<div class="agst-shell">
  <header class="ag-header agst-toolbar">
    <div class="agst-title"><span class="agst-mark"><i class="fa-solid fa-diagram-project"></i></span><strong>Ashen Gate | Skill Trees</strong></div>
    <div class="ag-header__meta agst-toolbar-right"><span class="agst-version" aria-label="Skill Trees version">v{{moduleVersion}}</span><button type="button" class="ag-btn ag-btn--sm" data-act="help" title="Skill Trees help"><i class="fa-solid fa-circle-question"></i> Help</button></div>
  </header>
  <nav class="ag-tabs agst-tabs" aria-label="Skill Trees views">
    <button type="button" data-act="tab-trees" class="agst-tab {{#if activeTrees}}agst-active{{/if}}" aria-current="{{#if activeTrees}}page{{else}}false{{/if}}">Skill Trees</button>
    {{#if gm}}<button type="button" data-act="tab-library" class="agst-tab {{#if activeLibrary}}agst-active{{/if}}" aria-current="{{#if activeLibrary}}page{{else}}false{{/if}}">Tree Library</button><button type="button" data-act="tab-cinders" class="agst-tab {{#if activeCinders}}agst-active{{/if}}" aria-current="{{#if activeCinders}}page{{else}}false{{/if}}">Cinders</button><button type="button" data-act="tab-setup" class="agst-tab {{#if activeSetup}}agst-active{{/if}}" aria-current="{{#if activeSetup}}page{{else}}false{{/if}}">GM Setup</button>{{/if}}
  </nav>
  {{#if gmPanel}}{{#unless initialized}}
    <section class="agst-start"><h3>Set up your private Skill Tree workspace</h3><p>Tree definitions are stored in a GM-only Journal. Players receive a separate, sanitized view. This does not migrate or overwrite existing v0.1 trees or Actor flags.</p>
      <button data-act="initialize" type="button" class="ag-btn ag-btn--primary"><i class="fa-solid fa-lock"></i> Initialize GM Storage</button></section>
  {{/unless}}{{/if}}

  {{#if activeTrees}}{{#if initialized}}
  <div class="agst-layout {{#if sidebarOpen}}agst-sidebar-open{{/if}}">
    <aside class="agst-sidebar" id="agst-sidebar" aria-label="Skill tree menu">
      <div class="agst-sidebar-scroll">
        <section class="agst-side-section" aria-label="Tree and character">
          <label class="ag-field">Tree<select id="agst-tree-choice" aria-label="Select skill tree">{{#each trees}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
          <label class="ag-field">Character<select id="agst-actor-choice" aria-label="Select character">{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        </section>
        {{#if hasTree}}
        <section class="agst-side-section" aria-label="Points">
          {{#if prof}}
          <div class="agst-pool">
            <span class="agst-stat"><small>LEVEL</small><b>{{prof.levelText}}</b></span>
            <span class="agst-stat"><small>TO CHOOSE</small><b>{{prof.available}}</b></span>
            <span class="agst-stat"><small>USED</small><b>{{prof.spent}}</b></span>
          </div>
          <p class="agst-help agst-prof-summary">{{prof.spent}} of {{prof.earned}} points used (1 per profession level, {{prof.maxPoints}} at most) · {{prof.nodeCount}} perks in this tree</p>
          {{else}}
          <div class="agst-pool">
            <span class="agst-stat"><small>AWARDED</small><b>{{progress.awarded}}</b></span>
            <span class="agst-stat"><small>AVAILABLE</small><b>{{progress.available}}</b></span>
            <span class="agst-stat"><small>UNLOCKED</small><b>{{progress.unlocks}}</b></span>
          </div>
          {{/if}}
          <span class="ag-badge agst-provider" title="Provider owns the progression rules">{{mode}}</span>
          {{#if canGrant}}<button type="button" class="ag-btn ag-btn--primary" data-act="grant"><i class="fa-solid fa-plus"></i> Award Points</button>{{/if}}
          {{#if canReset}}<button type="button" class="ag-btn ag-btn--danger" data-act="reset-tree" title="Refund every unlock on this tree and remove its perks from the sheet"><i class="fa-solid fa-rotate-left"></i> Reset Tree for {{actorName}}</button>{{/if}}
        </section>
        {{/if}}
        {{#if roster.length}}
        <section class="agst-side-section agst-roster" aria-label="Characters on this profession tree">
          <h3>Characters <small>(GM)</small></h3>
          <ul class="agst-roster-list">{{#each roster}}<li class="{{#if selected}}agst-active{{/if}}"><button type="button" class="agst-linklike" data-act="pick-actor" data-id="{{id}}">{{name}}</button>
            <span class="agst-roster-meta">Lvl {{level}} · {{spent}}/{{earned}} pts</span> <span class="ag-badge {{#if review}}ag-badge--warn{{else}}{{#if toChoose}}ag-badge--ok{{/if}}{{/if}}">{{status}}</span></li>{{/each}}</ul>
        </section>
        {{/if}}
        {{#if history.length}}
        <details class="agst-side-section agst-history"><summary>History for {{actorName}} ({{history.length}})</summary>
          <ol>{{#each history}}<li><strong>{{label}}</strong> {{node}}{{#if level}} · level {{level}}{{/if}} · {{byName}} · <small>{{when}}</small>{{#if undone}} <span class="ag-badge">undone</span>{{/if}}{{#if reason}}<br><small>{{reason}}</small>{{/if}}{{#if canUndo}} <button type="button" class="ag-btn ag-btn--sm" data-act="undo-history" data-id="{{id}}" title="Undo this change"><i class="fa-solid fa-rotate-left"></i> Undo</button>{{/if}}</li>{{/each}}</ol>
        </details>
        {{/if}}
        {{#if gm}}
        <section class="agst-side-section" aria-label="GM tools">
          <div class="agst-btn-row">
            <button type="button" data-act="player-preview" class="ag-btn ag-btn--sm {{#if preview}}agst-active{{/if}}" title="Show the sanitized public projection"><i class="fa-solid fa-eye"></i> {{#if preview}}Exit Preview{{else}}Player Preview{{/if}}</button>
            {{#unless preview}}<button type="button" data-act="edit-mode" class="ag-btn ag-btn--sm {{#if editing}}agst-active{{/if}}"><i class="fa-solid fa-pen-to-square"></i> {{#if editing}}Finish Editing{{else}}Edit Layout{{/if}}</button>{{/unless}}
          </div>
          {{#if editing}}<div class="agst-btn-row">
            <button type="button" class="ag-btn ag-btn--sm" data-act="appearance" title="Node size, canvas background, level/tier bands and icons"><i class="fa-solid fa-image"></i> Appearance</button>
            <button type="button" class="ag-btn ag-btn--sm" data-act="tree-settings"><i class="fa-solid fa-sliders"></i> Tree Settings</button>
            <button type="button" class="ag-btn ag-btn--sm" data-act="undo"><i class="fa-solid fa-rotate-left"></i> Undo</button>
            <button type="button" class="ag-btn ag-btn--sm" data-act="redo"><i class="fa-solid fa-rotate-right"></i> Redo</button>
          </div>{{/if}}
        </section>
        {{/if}}
        {{#if hasTree}}
        <section class="agst-side-section agst-inspector" aria-label="Selected perk">
          {{#if selected}}
            <div class="agst-inspector-head">{{#if selected.img}}<img class="agst-inspector-img" src="{{selected.img}}" alt="">{{/if}}<small>SELECTED PERK</small><h2>{{selected.name}}</h2><span class="ag-badge agst-state">{{selected.flag}}</span></div>
            <div class="agst-inspector-body">{{#if selected.description}}<p>{{selected.description}}</p>{{/if}}<div class="agst-inspector-line"><strong>Points:</strong> {{selected.cost}}</div>
              <div class="agst-inspector-line"><strong>Unlock:</strong> {{selected.reason}}</div>
              {{#if selected.rel.all.length}}<div class="agst-rel"><strong>Requires all of</strong><ul>{{#each selected.rel.all}}<li><button type="button" class="agst-linklike" data-act="select" data-id="{{id}}">{{name}}</button>{{#if unlocked}} <span class="agst-ok">✓ unlocked</span>{{/if}}</li>{{/each}}</ul></div>{{/if}}
              {{#each selected.rel.any}}<div class="agst-rel agst-rel-any"><strong>Requires one of (OR group {{index}})</strong><ul>{{#each nodes}}<li><button type="button" class="agst-linklike" data-act="select" data-id="{{id}}">{{name}}</button>{{#if unlocked}} <span class="agst-ok">✓ unlocked</span>{{/if}}</li>{{/each}}</ul></div>{{/each}}
              {{#if selected.rel.excludes.length}}<div class="agst-rel agst-rel-exclude"><strong>Cannot be taken with</strong><ul>{{#each selected.rel.excludes}}<li><button type="button" class="agst-linklike" data-act="select" data-id="{{id}}">{{name}}</button>{{#if unlocked}} <span class="agst-bad">taken</span>{{/if}}</li>{{/each}}</ul></div>{{/if}}
              {{#if selected.rel.leadsTo.length}}<div class="agst-rel"><strong>Opens the way to</strong><ul>{{#each selected.rel.leadsTo}}<li><button type="button" class="agst-linklike" data-act="select" data-id="{{id}}">{{name}}</button></li>{{/each}}</ul></div>{{/if}}
              {{#if gm}}{{#unless preview}}
                {{#if bindingNote}}<div class="agst-inspector-line"><strong>Perk:</strong><br><code>{{bindingNote}}</code> {{#if selectedBinding}}✓ in this world{{else}}⚠ not in this world: import it through General Manager{{/if}}</div>{{/if}}
                {{#if selectedCustom}}<div class="agst-inspector-line agst-warn">Older custom node: no perk assigned, so unlocking gives no Item. Edit Layout → Assign Perk.</div>{{/if}}
                <div class="agst-inspector-line"><strong>Node status:</strong> {{selected.status}} · {{selected.visibility}} · {{selected.display}}</div>
              {{/unless}}{{/if}}
            </div>
            {{#if cinderPush}}
            <section class="agst-cinder-push" aria-label="Push this power">
              <h3>Push</h3>
              <p class="agst-cinder-strain">Strain <strong>{{cinderPush.strain}}</strong> · {{cinderPush.band}} · Backfire {{cinderPush.chance}}%</p>
              {{#if cinderPush.normalUseBackfires}}<p class="agst-bad">At this Strain every use of this power backfires, Push or not.</p>{{/if}}
              {{#if cinderPush.hasModes}}<ul class="agst-cinder-modes">{{#each cinderPush.modes}}<li>
                <div><strong>{{label}}</strong> <small>+{{cost}} Strain → {{after}} · Backfire {{chance}}%{{#if guaranteed}} (guaranteed){{/if}}</small>{{#if effect}}<p>{{effect}}</p>{{/if}}</div>
                <button type="button" class="ag-btn ag-btn--sm" data-act="push" data-power="{{../cinderPush.powerId}}" data-mode="{{id}}"><i class="fa-solid fa-fire"></i> Push</button>
              </li>{{/each}}</ul>{{else}}<p>No Push available for this power yet.</p>{{/if}}
            </section>
            {{/if}}
            <div class="agst-inspector-actions">
              {{#if canBuy}}<button type="button" data-act="purchase" class="ag-btn ag-btn--primary"><i class="fa-solid fa-unlock"></i> Unlock for {{actorName}}</button>{{/if}}
              {{#if canRequest}}<button type="button" data-act="request" class="ag-btn ag-btn--primary"><i class="fa-solid fa-unlock"></i> Unlock ({{selected.cost}} pt)</button>{{/if}}
              {{#if canOverride}}<button type="button" data-act="override" class="ag-btn" title="Give this perk whatever the points, level or prerequisites, with a reason"><i class="fa-solid fa-gavel"></i> Grant (GM override)</button>{{/if}}
              {{#if canKeep}}<button type="button" data-act="keep" class="ag-btn" title="Keep this perk although the level no longer covers it"><i class="fa-solid fa-thumbtack"></i> Keep at this level</button>{{/if}}
              {{#if canRefund}}<button type="button" data-act="refund" class="ag-btn ag-btn--danger"><i class="fa-solid fa-rotate-left"></i> {{#if isProfession}}Remove (point returned){{else}}Refund (removes perk from sheet){{/if}}</button>{{/if}}
              {{#if editing}}
                <button type="button" class="ag-btn" data-act="assign-perk"><i class="fa-solid fa-star"></i> {{#if selectedCustom}}Assign Perk{{else}}Change Perk{{/if}}</button>
                <button type="button" class="ag-btn" data-act="edit-node"><i class="fa-solid fa-sliders"></i> Edit Properties</button>
                <button type="button" class="ag-btn" data-act="link"><i class="fa-solid fa-link"></i> Connect Prerequisite</button>
                <button type="button" class="ag-btn ag-btn--danger" data-act="remove-node"><i class="fa-solid fa-trash"></i> Remove Node</button>
              {{/if}}
            </div>
          {{else}}
            <div class="agst-no-selection"><i class="fa-regular fa-hand-pointer"></i><h3>Choose a perk</h3><p>Select a node on the canvas (or in “Tree as a list”) to see what it needs and what it opens.</p></div>
          {{/if}}
          {{#if linkFrom}}<div class="agst-link-alert">Connecting: select the node this one opens. The arrow will point from this node to it (required).</div>{{/if}}
        </section>
        {{/if}}
        {{#if editing}}
        <section class="agst-side-section agst-feature-shelf" aria-label="Perks in this world"><h3>Perks</h3><p class="agst-help">Drag a perk onto the canvas (from here or the Items sidebar), or press <strong>Add</strong>. The node takes its name, text, picture and point cost from the perk.</p>
          <input id="agst-feature-search" type="search" placeholder="Search perks / IDs" value="{{search}}" aria-label="Search perks">
          <div class="agst-feature-list">
            {{#each features}}<div class="agst-feature {{#if onTree}}agst-feature-used{{/if}}" draggable="true" data-uuid="{{uuid}}" title="{{id}}">{{#if img}}<img class="agst-feature-img" src="{{img}}" alt="">{{else}}<i class="fa-solid fa-grip-vertical"></i>{{/if}}<div><strong>{{name}}</strong><small>{{id}} · {{status}}</small></div>{{#if onTree}}<span class="agst-on-tree">On tree</span>{{else}}<button type="button" class="ag-btn ag-btn--sm agst-add-perk" data-act="add-perk" data-uuid="{{uuid}}" aria-label="Add {{name}} to this tree">Add</button>{{/if}}</div>{{else}}<p class="agst-empty">No perk Items of the right type in this world. Import perks through General Manager first.</p>{{/each}}
          </div>
        </section>
        {{/if}}
        {{#if hasTree}}
        <details class="agst-tree-list agst-side-section" {{#if listOpen}}open{{/if}}><summary>Tree as a list ({{nodes.length}})</summary>
          <ol>{{#each nodes}}<li><button type="button" class="agst-linklike" data-act="select" data-id="{{id}}">{{name}}</button> — {{flag}}{{#unless silhouette}}, {{cost}} pt{{/unless}}{{#if relText}}. {{relText}}{{/if}}</li>{{/each}}</ol>
        </details>
        {{/if}}
      </div>
    </aside>
    <button type="button" class="agst-scrim" data-act="toggle-sidebar" tabindex="-1" aria-label="Close menu"></button>

    <section class="agst-canvas-pane" aria-label="Skill tree canvas">
      <div class="agst-canvas-bar">
        <button type="button" class="ag-btn ag-btn--sm agst-menu-toggle" data-act="toggle-sidebar" aria-controls="agst-sidebar" aria-expanded="{{#if sidebarOpen}}true{{else}}false{{/if}}" title="Show or hide the menu"><i class="fa-solid fa-bars"></i> Menu</button>
        <span class="agst-canvas-title">{{#if hasTree}}{{tree.name}}{{/if}}</span>
        <span class="agst-zoom"><button type="button" class="ag-btn ag-btn--sm" data-act="zoom-out" title="Zoom out" aria-label="Zoom out">−</button><span class="agst-zoom-label">{{zoomText}}</span><button type="button" class="ag-btn ag-btn--sm" data-act="zoom-in" title="Zoom in" aria-label="Zoom in">+</button><button type="button" class="ag-btn ag-btn--sm" data-act="zoom-reset" title="Reset zoom" aria-label="Reset zoom">⟲</button></span>
      </div>
      {{#if ledgerMissing}}<div class="agst-banner"><i class="fa-solid fa-link-slash"></i> Profession Ledger is not active, so profession points are unavailable. Nothing is removed; picks wait until it is on again.</div>{{/if}}
      {{#if prof.overAllocated}}<div class="agst-banner agst-banner-review" role="alert"><i class="fa-solid fa-triangle-exclamation"></i> <strong>{{actorName}} needs GM review.</strong> Level {{prof.levelText}} no longer covers {{#if prof.aboveText}}{{prof.aboveText}}{{else}}{{prof.overSpent}} point(s) used{{/if}}. Nothing was removed. {{#if gm}}<button type="button" class="ag-btn ag-btn--sm ag-btn--primary" data-act="resolve"><i class="fa-solid fa-scale-balanced"></i> Review</button>{{else}}New picks wait until the GM has looked at it.{{/if}}</div>{{/if}}
      {{#if isTest}}<div class="agst-banner agst-banner-test"><i class="fa-solid fa-flask"></i> Test tree. Unlocking adds the perk Item to the sheet; perks with no rules effect do nothing else.</div>{{/if}}
      {{#if preview}}<div class="agst-banner agst-banner-info">GM player preview shows the shared sanitized tree. Test again from an actual player account to verify document permissions.</div>{{/if}}
      {{#if hasTree}}
        <div class="agst-stage">
          {{#if bg.fixed}}<div class="agst-bg agst-bg-fixed" style="{{bg.style}}" aria-hidden="true"></div>{{/if}}
          <div class="agst-viewport">
            <div class="agst-board {{sizeClass}}" style="width:{{mapWidth}}px;height:{{mapHeight}}px;" tabindex="0" aria-label="Skill tree. Scroll to move around; Ctrl and mouse wheel zooms.">
              {{#if bg}}{{#unless bg.fixed}}<div class="agst-bg {{#if bg.tile}}agst-bg-tile{{else}}agst-bg-cover{{/if}}" style="{{bg.style}}" aria-hidden="true"></div>{{/unless}}{{/if}}
              {{#each tiers}}<div class="agst-tier {{#if alt}}agst-tier-alt{{/if}}" style="top:{{top}}px;height:{{height}}px;"><span class="agst-tier-badge" style="{{iconStyle}}" title="{{text}}"><span class="agst-tier-fallback" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span><b>{{level}}</b></span><span class="agst-tier-name">{{text}}</span></div>{{/each}}
              <svg class="agst-links" width="{{mapWidth}}" height="{{mapHeight}}" aria-hidden="true">
                <defs>
                  <marker id="agst-arrow-all" class="agst-arrow agst-arrow-all" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto"><path d="M0,0 L10,5 L0,10 z"></path></marker>
                  <marker id="agst-arrow-any" class="agst-arrow agst-arrow-any" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto"><path d="M0,0 L10,5 L0,10 L3,5 z"></path></marker>
                  <marker id="agst-arrow-active" class="agst-arrow agst-arrow-active" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" markerUnits="strokeWidth" orient="auto"><path d="M0,0 L10,5 L0,10 z"></path></marker>
                </defs>
                {{#each edges}}<path data-edge data-from="{{from}}" data-to="{{to}}" d="{{d}}" class="agst-link agst-link-{{kind}} {{#if active}}agst-linked{{/if}}" marker-end="{{marker}}"></path>{{/each}}
                {{#each edges}}{{#if label}}<text data-edge data-from="{{from}}" data-to="{{to}}" x="{{mx}}" y="{{my}}" class="agst-edge-label agst-edge-label-{{kind}}" text-anchor="middle" dominant-baseline="central">{{label}}</text>{{/if}}{{/each}}
              </svg>
              {{#each nodes}}
                <button type="button" class="agst-node {{#if selected}}agst-selected{{/if}} {{#if eligible}}agst-eligible{{/if}} {{#if unlocked}}agst-unlocked{{/if}} {{#if silhouette}}agst-silhouette{{/if}} {{#if perkMissing}}agst-node-warn{{/if}} {{#if overLevel}}agst-node-review{{/if}}" data-act="select" data-id="{{id}}" style="{{style}}" aria-label="{{label}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" title="{{name}} · {{reason}}">
                  <span class="agst-node-icon">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid {{#if silhouette}}fa-question{{else}}fa-star{{/if}}"></i>{{/if}}</span>
                  <span class="agst-node-main"><strong>{{name}}</strong><small><i class="fa-solid {{#if unlocked}}fa-check{{else}}{{#if eligible}}fa-unlock{{else}}fa-lock{{/if}}{{/if}}" aria-hidden="true"></i><span class="agst-flag"> {{flag}}</span>{{#unless silhouette}} · {{cost}} pt{{/unless}}{{#if levelText}} · {{levelText}}{{/if}}{{#if overLevel}} · ⚠<span class="agst-flag"> review</span>{{/if}}{{#if perkMissing}} · ⚠<span class="agst-flag"> perk missing</span>{{/if}}{{#if custom}}<span class="agst-flag"> · custom</span>{{/if}}</small></span>
                </button>
              {{/each}}
              {{#unless nodes}}<div class="agst-board-hint">Empty tree. Enter Edit Layout and add perks from the Perks list.</div>{{/unless}}
            </div>
          </div>
          <div class="agst-tip" role="status" aria-live="polite" hidden></div>
        </div>
        <div class="agst-legend" role="note" aria-label="Line key">
          <span><svg width="38" height="12" aria-hidden="true"><path class="agst-link agst-link-all" d="M 2 6 L 34 6" marker-end="url(#agst-arrow-all)"></path></svg> Required</span>
          <span><svg width="38" height="12" aria-hidden="true"><path class="agst-link agst-link-any" d="M 2 6 L 34 6" marker-end="url(#agst-arrow-any)"></path></svg> <b>OR</b>: any one</span>
          <span><svg width="38" height="12" aria-hidden="true"><path class="agst-link agst-link-exclude" d="M 2 6 L 36 6"></path></svg> <b>✕</b>: not both</span>
          <span><svg width="38" height="12" aria-hidden="true"><path class="agst-link agst-link-all agst-linked" d="M 2 6 L 34 6" marker-end="url(#agst-arrow-active)"></path></svg> Both unlocked</span>
        </div>
        {{#if editing}}<div class="agst-canvas-help">Drag nodes to move them · Add perks from the Perks list · Select a node, then Connect Prerequisite (required) or Edit Properties (OR groups, exclusions).</div>{{/if}}
      {{else}}
        <div class="agst-no-tree"><i class="fa-regular fa-map"></i><h3>No visible tree layouts</h3><p>{{#if gm}}Initialize, add demo trees, or create a new draft.{{else}}A GM has not published any player-visible trees yet.{{/if}}</p></div>
      {{/if}}
    </section>
  </div>

  {{/if}}{{!-- initialized --}}
  {{#unless initialized}}
    <section class="agst-start agst-start-inline"><h3>No tree workspace is available yet</h3><p>{{#if gm}}Open <strong>GM Setup</strong> or <strong>Tree Library</strong> to initialize the private tree library.{{else}}The GM has not published any accessible tree layouts.{{/if}}</p></section>
  {{/unless}}
  {{/if}}{{!-- activeTrees --}}

  {{#if activeLibrary}}
  {{#if initialized}}
  <div class="agst-setup-main" aria-label="Tree Library for Skill Trees">
    <section class="agst-setup-card">
      <h2>Tree management</h2>
      <p>Manage the private layout library. This module does not import Profession XP or overwrite General Manager source definitions.</p>
      <div class="agst-setup-meta"><span><strong>{{privateCount}}</strong> private layouts</span><span><strong>{{publishedCount}}</strong> public tree projections</span><span><strong>v{{moduleVersion}}</strong> Alpha release</span></div>
      <div class="agst-setup-actions">
        <button type="button" data-act="create-tree" class="ag-btn ag-btn--primary"><i class="fa-solid fa-plus"></i> New Tree</button>
        <button type="button" class="ag-btn" data-act="export" {{#unless hasPrivateTree}}disabled title="Select a tree in the Skill Trees tab first"{{/unless}}><i class="fa-solid fa-file-export"></i> Export Selected Tree</button>
        <button type="button" class="ag-btn" data-act="export-all"><i class="fa-solid fa-download"></i> Export All Trees</button>
      </div>
      <p class="agst-help">Exports are backups of the GM layouts (<code>ag-skill-trees/0.3</code>). Tree files are imported through <strong>General Manager → Import</strong>, which hands them to Skill Trees.</p>
    </section>
    <section class="agst-setup-card" aria-label="Saved data check">
      <h2>Saved data check</h2>
      {{#if hasSetupReport}}<p>These nodes need attention. Nothing has been changed or removed.</p>
        <ul class="agst-report">{{#each setupReport}}<li><strong>{{treeName}}</strong> · {{nodeName}} <small>({{nodeId}})</small>: {{text}}</li>{{/each}}</ul>
      {{else}}<p>Every node has a perk that is in this world.</p>{{/if}}
      <p>{{#if missingGrants}}<strong>{{missingGrants}}</strong> unlocked perk(s) are not on their character sheet yet.{{else}}Every unlocked perk is on its character sheet.{{/if}}</p>
      <div class="agst-setup-actions"><button type="button" class="ag-btn" data-act="give-missing" {{#unless missingGrants}}disabled{{/unless}}><i class="fa-solid fa-user-plus"></i> Give Missing Perks</button></div>
    </section>
    <section class="agst-setup-card" aria-label="Profession perk check">
      <h2>Profession perk check</h2>
      {{#if professionReport.length}}<p>Characters whose profession perks need a look. Nothing has been changed or removed. Open the tree with the character selected to fix it.</p>
        <ul class="agst-report">{{#each professionReport}}<li><strong>{{actorName}}</strong> · {{treeName}} (level {{level}}, {{spent}} of {{earned}} points)<ul>{{#each issues}}<li><code>{{code}}</code> {{detail}}</li>{{/each}}</ul>
          <button type="button" class="ag-btn ag-btn--sm" data-act="open-row" data-tree="{{treeId}}" data-actor="{{actorId}}"><i class="fa-solid fa-diagram-project"></i> Open</button></li>{{/each}}</ul>
      {{else}}<p>Every character's profession perks match their level, and every allocated perk is on its sheet.</p>{{/if}}
    </section>
    <section class="agst-setup-card">
      <h2>Publication and backups</h2>
      <p>Player views use a separately sanitized tree projection. Publish does not grant Features, XP, or Actor ownership.</p>
      <div class="agst-setup-actions">
        <button type="button" data-act="publish" class="ag-btn ag-btn--primary"><i class="fa-solid fa-arrows-rotate"></i> Publish Player View</button>
        <button type="button" class="ag-btn" data-act="backup-progress"><i class="fa-solid fa-box-archive"></i> Backup Actor Tree Progress</button>
      </div>
    </section>
  </div>
  {{/if}}
  {{/if}}{{!-- activeLibrary --}}
  {{#if activeCinders}}{{#if cinderPanel}}
  <div class="agst-setup-main" aria-label="Cinders">
    <section class="agst-setup-card">
      <div class="agst-cinder-toolbar"><h2>Cinders</h2><button type="button" class="ag-btn ag-btn--primary" data-act="cinder-new" {{#unless cinderPanel.definitions}}disabled title="Import Cinder (MUT-*) definitions through General Manager first"{{/unless}}><i class="fa-solid fa-plus"></i> New Cinder</button></div>
      <p>Each Cinder keeps its own points and unlocked powers and moves between bearers with them. A bearer cannot release a Cinder; only the GM binds, transfers or unbinds it. Strain stays with each character. Limit: {{cinderPanel.limit}} per character · starting points: {{cinderPanel.initial}} (first binding only; change both in Configure Settings).</p>
      {{#if cinderPanel.migrate}}<div class="agst-inline-setting"><span><strong>{{cinderPanel.migrate}}</strong> character(s) have Cinder progress from before Cinders.</span><button type="button" class="ag-btn" data-act="cinder-migrate"><i class="fa-solid fa-right-left"></i> Move existing Cinder progress</button></div>{{/if}}
      {{#if cinderPanel.hasCinders}}
        {{#each cinderPanel.groups}}<h3 class="agst-cinder-group">{{name}} <small>({{definitionId}})</small></h3>
        <table class="agst-cinder-table"><thead><tr><th scope="col">Bearer</th><th scope="col">Points</th><th scope="col">Powers</th><th scope="col">Actions</th></tr></thead><tbody>
          {{#each rows}}<tr><td>{{#if bearerName}}{{bearerName}}{{else}}<em>{{#if lost}}Lost{{else}}Unbound{{/if}}</em>{{#if lastName}} <small>(last: {{lastName}})</small>{{/if}}{{/if}}{{#if migrated}} <small>moved from older data</small>{{/if}}</td>
            <td>{{spent}} of {{awarded}} spent</td><td>{{unlocks}} unlocked</td>
            <td class="agst-cinder-actions">{{#if bound}}<button type="button" class="ag-btn ag-btn--sm" data-act="cinder-transfer" data-instance="{{instanceId}}"><i class="fa-solid fa-right-left"></i> Transfer</button><button type="button" class="ag-btn ag-btn--sm ag-btn--danger" data-act="cinder-unbind" data-instance="{{instanceId}}">Unbind</button>{{else}}<button type="button" class="ag-btn ag-btn--sm" data-act="cinder-bind" data-instance="{{instanceId}}"><i class="fa-solid fa-link"></i> Bind</button>{{/if}}</td></tr>{{/each}}
        </tbody></table>{{/each}}
      {{else}}<p>No Cinders yet. Click <strong>New Cinder</strong>, then <strong>Bind</strong> it to a character.</p>{{/if}}
    </section>
    <section class="agst-setup-card" aria-label="Cinder check">
      <h2>Check</h2>
      {{#if cinderPanel.hasReport}}<ul class="agst-report">{{#each cinderPanel.report}}<li><strong>{{name}}</strong>: {{text}}</li>{{/each}}</ul>
        {{#if cinderPanel.canRepair}}<div class="agst-setup-actions"><button type="button" class="ag-btn" data-act="cinder-repair"><i class="fa-solid fa-screwdriver-wrench"></i> Repair</button></div><p><small>Repair copies each Cinder's progress back to its bearer, gives missing powers and removes Cinder powers from characters who don't bear that Cinder. It never changes a Cinder's points or unlocks.</small></p>{{/if}}
      {{else}}<p>Every Cinder, bearer and power Item agrees.</p>{{/if}}
    </section>
  </div>
  {{/if}}{{/if}}{{!-- activeCinders --}}
  {{#if activeSetup}}
  {{#if initialized}}
  <div class="agst-setup-main" aria-label="GM Setup for Skill Trees">
    <div class="agst-inline-setting" role="group" aria-label="GM-controlled Player Access">
      <span><strong>Player Access:</strong> {{#if playerAccessEnabled}}Visible{{else}}Hidden{{/if}} <small>Controls player launcher and window only; not Actor progress or document permissions.</small></span>
      <button type="button" class="ag-btn" data-act="toggle-player-access">{{#if playerAccessEnabled}}Hide from Players{{else}}Show to Players{{/if}}</button>
    </div>
    {{#if strainSetup}}
    <section class="agst-setup-card" aria-label="Strain settings">
      <h2>Strain</h2>
      <p>One Strain value per character, shared by every system that adds or removes it. These are the band names and Backfire chances; character Strain is never changed here. Campaign band names come in with a Strain config file (also importable through General Manager).</p>
      <table class="agst-strain-bands">
        <thead><tr><th scope="col">Strain</th><th scope="col">Band</th><th scope="col">Backfire chance</th></tr></thead>
        <tbody>{{#each strainSetup.bands}}<tr><td>{{range}}</td><td>{{label}}</td><td>{{chance}}</td></tr>{{/each}}</tbody>
      </table>
      <ul class="agst-strain-rules">
        <li>A Push at Strain {{strainSetup.guaranteeAt}} or more always backfires{{#if strainSetup.prevention}} unless a modifier prevents it{{/if}}.</li>
        <li>A normal use backfires at Strain {{strainSetup.normalUseAt}} or more.</li>
        <li>Maximum Strain: {{strainSetup.hardMax}}.</li>
        <li>Rest recovery: long rest −{{strainSetup.restLong}}, short rest −{{strainSetup.restShort}}.</li>
        <li>Backfire effect roll bonus from Strain (higher = more severe): {{strainSetup.effectBonus}}.</li>
      </ul>
      <div class="agst-setup-actions">
        <button type="button" class="ag-btn" data-act="strain-import"><i class="fa-solid fa-file-import"></i> Import Strain Config</button>
        <button type="button" class="ag-btn" data-act="strain-export"><i class="fa-solid fa-file-export"></i> Export Strain Config</button>
        <button type="button" class="ag-btn ag-btn--danger" data-act="strain-reset"><i class="fa-solid fa-rotate-left"></i> Reset to Defaults</button>
      </div>
    </section>
    {{/if}}
    <details class="agst-dev-tools">
      <summary><i class="fa-solid fa-flask"></i> Developer Tools — Experimental / GM only</summary>
      <div class="agst-dev-content"><p>Use a disposable world. QA installation creates real, clearly marked native Foundry documents and private tree layouts; they are not approved Cinder or Profession content.</p>
        <div class="agst-setup-actions">
          <button type="button" class="ag-btn" data-act="qa-install"><i class="fa-solid fa-vial"></i> Install QA Fixture Records</button>
          <button type="button" data-act="qa-reset" class="ag-btn ag-btn--danger"><i class="fa-solid fa-trash-can"></i> Reset QA Fixture</button>
          <button type="button" class="ag-btn" data-act="ledger-import" title="Allocate perks chosen in older Profession Ledger data on profession trees; shows what would happen first"><i class="fa-solid fa-file-import"></i> Import Ledger perk choices</button>
          {{#if legacy}}<button type="button" class="ag-btn" data-act="legacy-preview"><i class="fa-solid fa-clock-rotate-left"></i> Review Legacy ({{legacy}})</button><button type="button" data-act="legacy-clear" class="ag-btn ag-btn--danger">Backup &amp; Clear Legacy</button>{{/if}}
        </div>
      </div>
    </details>
  </div>
  {{/if}}
  {{/if}}{{!-- activeSetup --}}
</div>
