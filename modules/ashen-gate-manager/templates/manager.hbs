              {{#each fields}}
              <div class="agscenes-field{{#if touched}} is-touched{{/if}}"><span>{{label}}</span>
                {{#if isNumber}}<input type="range" aria-label="{{label}}" data-ag-draft="{{path}}" min="{{min}}" max="{{max}}" step="{{step}}" value="{{value}}"><output data-ag-draft-out="{{path}}">{{display}}</output>{{/if}}
                {{#if isBoolean}}<input type="checkbox" aria-label="{{label}}" data-ag-draft="{{path}}" {{#if checked}}checked{{/if}}>{{/if}}
                {{#if isWeather}}<select aria-label="{{label}}" data-ag-draft="{{path}}">{{#each weatherOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
                {{#if isColor}}<span class="agscenes-color"><input type="color" aria-label="{{label}}" data-ag-draft="{{path}}" value="{{colorValue}}"><label class="agmanager-tiny"><input type="checkbox" data-ag-draft-none="{{path}}" {{#if isNone}}checked{{/if}}> none</label></span>{{/if}}
              </div>
              {{/each}}
            </fieldset>
            {{/each}}
          </div>
          {{#if moods.missingFields}}<p class="agmanager-tiny">Not in this Foundry version, so not shown: {{moods.missingFields}}.</p>{{/if}}
          <footer class="agmanager-row agmanager-mood-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="draft-cancel">Cancel</button>
            <div class="agmanager-row"><button type="button" class="ag-btn" data-ag-action="draft-save-layer">Save as layer…</button><button type="button" class="ag-btn" data-ag-action="draft-save-mood">Save as mood…</button><button type="button" class="ag-btn ag-btn--primary" data-ag-action="draft-apply"><i class="fa-solid fa-check"></i> Apply to scene</button></div>
          </footer>
          {{else}}<p class="agmanager-tiny">View or activate a scene first.</p>{{/if}}
        </section>
      </div>

      <aside class="ag-card agscenes-stack" aria-label="On this scene now">
        <div class="agmanager-row agmanager-moods-head"><h4 class="agscenes-sect">On this scene now</h4><span class="agmanager-tiny">{{moods.layerCount}}</span></div>
        {{#each moods.stack}}
        <div class="agscenes-entry{{#if isMood}} is-mood{{/if}}">
          <div class="agmanager-row agmanager-moods-head"><div><span class="agscenes-kind">{{#if isMood}}Base mood{{else}}Layer{{/if}}</span><strong>{{label}}</strong></div>
            <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-effect-remove="{{kind}}:{{id}}" aria-label="Remove {{label}}" title="Remove {{label}}"><i class="fa-solid fa-xmark"></i></button></div>
          <div class="agmanager-tiny">{{#each fields}}{{#if covered}}<s title="A layer above decides this">{{label}} {{value}}</s>{{else}}{{label}} {{value}}{{/if}}{{#unless @last}} · {{/unless}}{{/each}}</div>
        </div>
        {{else}}<p class="agmanager-tiny">Normal: no mood or layer applied.</p>
        {{/each}}
        <p class="agmanager-tiny agscenes-status" role="status">{{moods.message}}</p>
        <p class="agmanager-tiny">Removing a layer puts back only the fields it changed. If you changed one of those fields since (Scene config or Fine-tune), your change stays and the message says so.</p>
        <p class="agmanager-tiny">Everyone on the scene sees changes. Weather can slow weaker player machines: use <strong>No weather</strong> if that happens. Core Foundry lighting and weather only.</p>
      </aside>
    </div>
    {{/if}}

    {{#if moods.library}}
    <section class="ag-card" aria-label="Moods and layers">
      <div class="agmanager-row agmanager-row-wrap">
        <input type="search" class="aglib-search agscenes-search" data-ag-mood-search value="{{moods.search}}" placeholder="Search moods and layers" aria-label="Search moods and layers">
        <div class="aglib-chips" role="group" aria-label="Show">{{#each moods.filters}}<button type="button" class="aglib-chip {{#if selected}}active{{/if}}" data-ag-mood-filter="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}</div>
        <span class="agscenes-spacer"></span>
        <button type="button" class="ag-btn" data-ag-action="mood-new"><i class="fa-solid fa-plus"></i> New mood</button>
        <button type="button" class="ag-btn" data-ag-action="layer-new"><i class="fa-solid fa-plus"></i> New layer</button>
      </div>
      {{#each moods.libraryGroups}}
      <h4 class="agscenes-sect">{{label}}</h4>
      <div class="agmanager-mood-list">
        {{#each items}}
        <div class="agmanager-mood-row{{#if unavailable}} is-unavailable{{/if}}">
          <div><strong>{{label}}</strong> {{#if isDefault}}<span class="ag-badge">Default</span>{{/if}}{{#if unavailable}} <span class="ag-badge ag-badge--warn">Weather "{{unavailable}}" missing</span>{{/if}}<div class="agmanager-tiny">{{summary}}</div></div>
          <div class="agmanager-row">
            {{#if isMood}}<button type="button" class="ag-btn ag-btn--sm{{#if favourite}} ag-btn--primary{{/if}}" data-ag-mood-favourite="{{id}}" {{#unless @root.moods.hasScene}}disabled{{/unless}} aria-pressed="{{#if favourite}}true{{else}}false{{/if}}" title="Favourite on {{@root.moods.sceneName}}"><i class="fa-solid fa-star"></i></button>{{/if}}
            <button type="button" class="ag-btn ag-btn--sm" data-ag-mood-edit="{{kind}}:{{id}}">Edit</button>
            <button type="button" class="ag-btn ag-btn--sm" data-ag-mood-duplicate="{{kind}}:{{id}}">Duplicate</button>
          </div>
        </div>
        {{else}}<p class="agmanager-tiny">Nothing matches.</p>
        {{/each}}
      </div>
      {{/each}}
      {{#unless moods.hasWeather}}<p class="agmanager-tiny"><strong>No weather effects found</strong> in this Foundry (CONFIG.weatherEffects is empty); presets that set weather will refuse to apply.</p>{{/unless}}
      <p class="agmanager-tiny">Defaults are a starting point; editing one makes it yours. Remove is inside Edit. <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="mood-reset">Reset moods and layers to defaults…</button></p>
    </section>

    {{#if moods.edit}}
    <section class="ag-card agmanager-mood-editor" aria-label="Edit preset">
      <h3>{{#if moods.edit.isNew}}New {{moods.edit.noun}}{{else}}Edit {{moods.edit.noun}}: {{moods.edit.label}}{{/if}}</h3>
      <div class="agmanager-row agmanager-row-wrap">
        {{#if moods.edit.isNew}}<label>Id <input type="text" data-ag-mood-id value="{{moods.edit.id}}" placeholder="e.g. foggy-dawn" maxlength="40"></label>{{/if}}
        <label>Label <input type="text" data-ag-mood-label value="{{moods.edit.label}}"></label>
        <label>Transition <select data-ag-mood-edit-transition>{{#each moods.edit.transitions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      </div>
      <p class="agmanager-tiny">Tick the fields this {{moods.edit.noun}} sets. Unticked fields are left as the scene has them. Transition fades darkness when the Live transition is "Preset default".</p>
      {{#each moods.edit.groups}}
      <fieldset class="agscenes-grp"><legend>{{label}}</legend>
      <div class="agmanager-mood-fields">
      {{#each fields}}
        <label class="agmanager-mood-field"><input type="checkbox" data-ag-mood-use="{{path}}" {{#if used}}checked{{/if}}> <span>{{label}}</span>
          {{#if isNumber}}<input type="number" data-ag-mood-value="{{path}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}"> <small>{{min}} to {{max}}</small>{{/if}}
          {{#if isBoolean}}<input type="checkbox" data-ag-mood-value="{{path}}" {{#if checked}}checked{{/if}}> <small>on</small>{{/if}}
          {{#if isWeather}}<select data-ag-mood-value="{{path}}">{{#each weatherOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
          {{#if isColor}}<input type="color" data-ag-mood-value="{{path}}" value="{{colorValue}}"> <input type="checkbox" data-ag-mood-none="{{path}}" {{#if isNone}}checked{{/if}} aria-label="No colour" title="No colour"> <small>none</small>{{/if}}
        </label>
      {{/each}}
      </div>
      </fieldset>
      {{/each}}
      <footer class="agmanager-row agmanager-mood-footer">
        <div class="agmanager-row"><button type="button" class="ag-btn ag-btn--ghost" data-ag-action="mood-cancel">Cancel</button>{{#unless moods.edit.isNew}}<button type="button" class="ag-btn ag-btn--danger" data-ag-action="mood-remove">Remove…</button>{{/unless}}</div>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="mood-save"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
      </footer>
    </section>
    {{/if}}
    {{/if}}

    {{#if moods.share}}
    <section class="ag-card" aria-label="Export moods file">
      <h3>Export</h3>
      <div class="agmanager-row agmanager-row-wrap">
        <label class="agmanager-toggle"><input type="checkbox" data-ag-mood-export="moods" {{#if moods.exportMoods}}checked{{/if}}> Moods ({{moods.moodCount}})</label>
        <label class="agmanager-toggle"><input type="checkbox" data-ag-mood-export="layers" {{#if moods.exportLayers}}checked{{/if}}> Layers ({{moods.layerTotal}})</label>
        <span class="agscenes-spacer"></span>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="mood-export"><i class="fa-solid fa-file-export"></i> Export moods file</button>
      </div>
      <p class="agmanager-tiny">Saves <code>ashen-gate-moods.json</code>: presets only, never scene data or favourites. Format: <code>docs/scene-moods-schema.md</code>.</p>
    </section>
    <section class="ag-card" aria-label="Import moods file">
      <h3>Import</h3>
      <label class="agmanager-row">Moods file <input type="file" accept=".json,application/json" data-ag-mood-import-file></label>
      {{#if moods.import}}
      <p class="agmanager-tiny">Preview of <strong>{{moods.import.filename}}</strong>. Nothing changes until Import. Scenes are never changed.</p>
      <div class="agmanager-mood-list">
        {{#each moods.import.items}}
        <div class="agmanager-mood-row">
          <div><strong>{{label}}</strong> <span class="ag-badge">{{kind}}</span> {{#if isNew}}<span class="ag-badge ag-badge--ok">New</span>{{/if}}{{#if isSame}}<span class="ag-badge">Already the same</span>{{/if}}{{#if isConflict}}<span class="ag-badge ag-badge--warn">Same id, different values</span>{{/if}}{{#if isInvalid}}<span class="ag-badge ag-badge--danger">Skipped</span>{{/if}}
            {{#if unavailable}}<span class="ag-badge ag-badge--warn">Weather "{{unavailable}}" missing here</span>{{/if}}
            {{#if problems}}<div class="agmanager-tiny">{{problems}}</div>{{/if}}</div>
          {{#if isConflict}}<select data-ag-mood-import-choice="{{kind}}:{{id}}" aria-label="What to do with {{label}}"><option value="keep" {{#if keep}}selected{{/if}}>Keep mine</option><option value="replace" {{#if replace}}selected{{/if}}>Replace mine</option><option value="both" {{#if both}}selected{{/if}}>Keep both</option></select>{{/if}}
        </div>
        {{/each}}
      </div>
      <footer class="agmanager-row agmanager-mood-footer">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="mood-import-cancel">Cancel</button>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="mood-import-apply"><i class="fa-solid fa-file-import"></i> Import</button>
      </footer>
      {{/if}}
      <p class="agmanager-tiny agscenes-status" role="status">{{moods.message}}</p>
    </section>
    {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if setupActive}}
  <div class="agmanager-panel agmanager-organize">
    <p class="agmanager-tiny">Looking for something else? The world default skin is in the <strong>Appearance</strong> dropdown at the top, next to Help. Showing or hiding each module from players is on the <strong>Modules</strong> tab.</p>
    <section class="ag-card" aria-label="NPC Codex">
      <h3>NPC Codex <span class="agmanager-beta">GM only</span></h3>
      <label class="agmanager-toggle"><input type="checkbox" data-ag-codex-access {{#if codexPlayerAccess}}checked{{/if}}> Let players open the NPC Codex</label>
      <p class="agmanager-tiny"><strong>On:</strong> players get an <strong>Open NPC Codex</strong> button (Game Settings → Configure Settings → Ashen Gate | General Manager). It shows only the NPCs, and only the details, you have revealed to the whole party or to that player's character. Hidden NPCs and your GM notes are never sent to them.</p>
      <p class="agmanager-tiny"><strong>Off</strong> (default): players cannot open the codex at all. You still can, and your reveals are kept for when you turn it on. The change saves as soon as you tick or untick.</p>
    </section>
    <section class="ag-card" aria-label="Core sources">
      <h3>Core sources <span class="agmanager-beta">GM only</span></h3>
      <p class="agmanager-tiny">These boxes only tell <strong>Items → Core links</strong> where to find official 2024 (5.5e) items to compare your Ashen Gate items with. They are GM-only, players never see them, and ticking or unticking them never changes or moves any item. Old 2014 items are always ignored.</p>
      <label class="agmanager-toggle"><input type="checkbox" data-ag-setup-auto {{#if setup.auto}}checked{{/if}}> Find 2024 items automatically (recommended)</label>
      <p class="agmanager-tiny"><strong>On:</strong> Core Links looks in world items imported by Plutonium or marked 2024, in your world compendiums, and in the dnd5e 2024 compendiums. <strong>Off:</strong> it looks only in the compendiums and folders you tick below.</p>
      <h4>Also use these compendiums</h4>
      <p class="agmanager-tiny">Tick a compendium to always include it, for example one your D&amp;D Beyond importer filled. <span class="ag-badge">detected</span> means automatic search already uses it.</p>
      <div class="agmanager-row agmanager-row-wrap">{{#each setup.packs}}<label class="agmanager-toggle"><input type="checkbox" data-ag-setup-pack="{{id}}" {{#if configured}}checked{{/if}}> {{label}} <code>{{id}}</code>{{#if detected}} <span class="ag-badge">detected</span>{{/if}}</label>{{/each}}</div>
      <h4>Also use world Item folders</h4>
      <p class="agmanager-tiny">Tick a sidebar Item folder to include the items in it.</p>
      <div class="agmanager-row agmanager-row-wrap">{{#each setup.folders}}<label class="agmanager-toggle"><input type="checkbox" data-ag-setup-folder="{{id}}" {{#if configured}}checked{{/if}}> {{name}}</label>{{else}}<span class="agmanager-tiny">No Item folders.</span>{{/each}}</div>
      <p class="agmanager-tiny" role="status">{{setupMessage}}</p>
      <footer class="agmanager-row agmanager-mood-footer"><span></span>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="setup-save"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button></footer>
    </section>
  </div>
  {{/if}}

  {{#if historyActive}}
  <div class="agmanager-panel">
    <h3>Recent import operations</h3>
    <p>History is a compact activity log, <strong>not</strong> an undo system. The manager downloads pre-change snapshots for updates and destructive operations. Keep a Foundry world backup.</p>
    {{#if hasHistory}}
      {{#each history}}
      <details class="agmanager-history">
        <summary><strong>{{packageId}}</strong> · v{{packageVersion}} · {{at}} · {{results.length}} record(s)</summary>
        <div class="agmanager-history-records">
        {{#each results}}
          <div><span class="agmanager-badge">{{status}}</span> <code>{{id}}</code> {{action}} {{message}} {{uuid}}</div>
        {{/each}}
        </div>
      </details>
      {{/each}}
    {{else}}<p>No imports recorded yet.</p>{{/if}}
  </div>
  {{/if}}
</section>
