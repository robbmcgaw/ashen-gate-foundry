          <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-codex-search value="{{codex.search}}" placeholder="Search NPC name, role, ID" aria-label="Search NPCs" /></label>
          <div class="ag-chip-group" role="group" aria-label="Show">
