    {{#if libraryAdoptActive}}
    <section class="ag-section aglib-section agmanager-adopt" aria-label="Adopt and export world Items for review">
    <div class="ag-section__head"><h3 class="ag-section__title">Adopt &amp; export world Items for review</h3></div>
    <p>Assign <strong>review tags</strong> to world Items without editing their contents. A tag records a stable capture ID and suggested classification; <strong>it does not approve a record or make it importer-managed.</strong></p>
    <dl class="agmanager-package">
      <div><dt>World Items</dt><dd class="aglib-num">{{worldItemCount}}</dd></div>
      <div><dt>Tagged for review</dt><dd class="aglib-num">{{taggedCount}}</dd></div>
      <div><dt>Visible rows</dt><dd class="aglib-num">{{captureVisibleCount}}</dd></div>
    </dl>
    <div class="ag-toolbar">
      <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-capture-filter value="{{captureSearch}}" placeholder="Find Item: name or type" aria-label="Find Item" /></label>
      <div class="ag-toolbar__filters"><label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-capture-tagged-only {{#if captureTaggedOnly}}checked{{/if}}> Tagged only</label></div>
      <div class="ag-toolbar__end">
        <button type="button" class="ag-btn ag-btn--sm" data-ag-action="capture-select-visible">Select visible</button>
        <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="capture-clear">Clear selection</button>
      </div>
    </div>
    <div class="ag-table-wrap">
      <table class="ag-table">
        <thead><tr><th scope="col">Select</th><th scope="col">Item / Foundry UUID</th><th scope="col">Item type</th><th scope="col">Capture status</th></tr></thead>
        <tbody>
          {{#each captureRows}}
          <tr>
            <td><input type="checkbox" data-ag-capture-select="{{id}}" {{#if selected}}checked{{/if}} aria-label="Select {{name}}" /></td>
            <td><strong{{{tooltip}}}>{{name}}</strong><code class="agm-id">{{uuid}}</code></td>
            <td>{{type}}</td>
            <td>{{#if tagged}}<span class="ag-badge ag-badge--ok">Tagged</span> {{kindLabel}}<code class="agm-id">{{capture.captureId}}</code>{{else}}<span class="ag-badge">Not tagged</span>{{/if}}{{#if source}}<div class="agmanager-tiny">Imported binding: {{source.sourceId}}</div>{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <div class="ag-cluster agm-gap-top">
      <label class="agmanager-search-label">Classify selected as
        <select data-ag-capture-kind>
          {{#each captureKindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
        </select>
      </label>
      <button type="button" class="ag-btn" data-ag-action="capture-tag" {{#unless hasCaptureSelected}}disabled{{/unless}}><i class="fa-solid fa-tag" aria-hidden="true"></i> Tag selected</button>
      <button type="button" class="ag-btn ag-btn--danger" data-ag-action="capture-untag" {{#unless hasCaptureSelected}}disabled{{/unless}}>Remove selected tags</button>
    </div>
    <p class="ag-notice ag-notice--info" role="status"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{captureMessage}}</p>
    <p class="agmanager-tiny">Exports <strong>all tagged world Items</strong>, not just the visible/selected rows. Exported data is <strong>unreviewed</strong> until reconciled for the repo. No Actors or macros are included. Export includes system rules, active effects and other module flags. Review copyright/third-party content and hidden GM details before uploading.</p>
    <div class="ag-cluster agmanager-capture-footer">
      <button type="button" class="ag-btn ag-btn--primary" data-ag-action="capture-export" {{#unless canCaptureExport}}disabled{{/unless}}><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export all tagged Items (JSON)</button>
    </div>
    </section>
    {{/if}}
    {{#if libraryCodexActive}}
    <div class="aglib-split agcodex">
