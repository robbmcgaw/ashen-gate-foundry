    <section class="ag-section" aria-label="Import moods file">
      <div class="ag-section__head"><h3 class="ag-section__title">Import</h3></div>
      <div class="ag-cluster">{{{fileButtons.moods}}}</div>
      {{#if moods.import}}
      <p class="agmanager-tiny">Preview of <strong>{{moods.import.filename}}</strong>. Nothing changes until Import. Scenes are never changed.</p>
      <div class="ag-rows agmanager-mood-list">
        {{#each moods.import.items}}
        <div class="ag-row agmanager-mood-row">
          <div class="ag-row__main"><span class="ag-row__title">{{label}} <span class="ag-badge">{{kind}}</span> {{#if isNew}}<span class="ag-badge ag-badge--ok">New</span>{{/if}}{{#if isSame}}<span class="ag-badge">Already the same</span>{{/if}}{{#if isConflict}}<span class="ag-badge ag-badge--warn">Same id, different values</span>{{/if}}{{#if isInvalid}}<span class="ag-badge ag-badge--danger">Skipped</span>{{/if}}
            {{#if unavailable}}<span class="ag-badge ag-badge--warn">Weather "{{unavailable}}" missing here</span>{{/if}}</span>
            {{#if problems}}<span class="ag-row__meta">{{problems}}</span>{{/if}}</div>
          {{#if isConflict}}<div class="ag-row__end"><select data-ag-mood-import-choice="{{kind}}:{{id}}" aria-label="What to do with {{label}}"><option value="keep" {{#if keep}}selected{{/if}}>Keep mine</option><option value="replace" {{#if replace}}selected{{/if}}>Replace mine</option><option value="both" {{#if both}}selected{{/if}}>Keep both</option></select></div>{{/if}}
        </div>
        {{/each}}
      </div>
      <footer class="ag-footer">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="mood-import-cancel">Cancel</button>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="mood-import-apply"><i class="fa-solid fa-file-import" aria-hidden="true"></i> Import ({{moods.import.items.length}})</button>
      </footer>
      {{/if}}
      <p class="agmanager-tiny agscenes-status" role="status">{{moods.message}}</p>
    </section>
    {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if setupActive}}
  <div class="agm-setup">
    {{{setupTabsHtml}}}
    <div class="agm-setup-form" data-ag-setup-form>
    <div {{{setupPanels.general}}} class="agm-subpanel">
      <section class="ag-section" aria-label="World appearance">
        <div class="ag-section__head"><h3 class="ag-section__title">World appearance</h3></div>
        <p class="agmanager-tiny">The skin every player sees until they pick their own in My Appearance. Players see a saved change live.</p>
        <div class="agm-skin-picker" role="radiogroup" aria-label="World default appearance" data-ag-skin-picker="world" data-ag-setup-skin>
          {{#each setupSkins}}<button type="button" role="radio" class="agm-skin-card{{#if selected}} is-selected{{/if}}{{#if current}} is-current{{/if}}" aria-checked="{{#if selected}}true{{else}}false{{/if}}" tabindex="{{#if selected}}0{{else}}-1{{/if}}" data-ag-skin-value="{{id}}" aria-describedby="ag-wskin-desc-{{id}}"><span class="agm-swatch" aria-hidden="true">{{#each swatch}}<i style="background:{{this}}"></i>{{/each}}</span><span class="agm-skin-card__text"><span class="agm-skin-card__name">{{label}}</span><small id="ag-wskin-desc-{{id}}" class="agm-skin-card__desc">{{description}}</small>{{#if current}}<small class="agm-skin-card__now">Saved world default</small>{{/if}}</span></button>{{/each}}
        </div>
        <p class="agmanager-tiny">Your own skin and size: {{{gotoMyAppearance}}}.</p>
      </section>
      <section class="ag-section" aria-label="NPC Codex">
        <div class="ag-section__head"><h3 class="ag-section__title">NPC Codex</h3></div>
        <p>Players {{#if codexPlayerAccess}}<strong>can</strong>{{else}}<strong>cannot</strong>{{/if}} open the NPC Codex. Reveal or hide it on the {{{gotoModules}}} tab, with the other modules' player windows.</p>
        <p class="agmanager-tiny">Players see only the NPCs and details you have revealed to the party or to their character. Your reveals are kept while it is hidden.</p>
      </section>
    </div>
    <div {{{setupPanels.sources}}} class="agm-subpanel">
      <section class="ag-section" aria-label="Core sources">
        <div class="ag-section__head"><h3 class="ag-section__title">Core sources</h3></div>
        <p class="agmanager-tiny">Where <strong>Items → Core links</strong> looks for official 2024 (5.5e) items. Ticking a box never changes or moves any item; 2014 items are always ignored.</p>
        <label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-setup-auto {{#if setup.auto}}checked{{/if}}> Find 2024 items automatically (recommended)</label>
        <p class="agmanager-tiny"><strong>On:</strong> world items imported by Plutonium or marked 2024, your world compendiums and the dnd5e 2024 compendiums. <strong>Off:</strong> only what you tick below.</p>
        <h4>Also use these compendiums</h4>
        <p class="agmanager-tiny"><span class="ag-badge">detected</span> means automatic search already uses it.</p>
        <div class="agm-checks">{{#each setup.packs}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-setup-pack="{{id}}" {{#if configured}}checked{{/if}}> {{label}} <code>{{id}}</code>{{#if detected}} <span class="ag-badge">detected</span>{{/if}}</label>{{/each}}</div>
        <h4>Also use world Item folders</h4>
        <div class="agm-checks">{{#each setup.folders}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-setup-folder="{{id}}" {{#if configured}}checked{{/if}}> {{name}}</label>{{else}}<span class="agmanager-tiny">No Item folders.</span>{{/each}}</div>
      </section>
    </div>
    </div>
    <div {{{setupPanels.developer}}} class="agm-subpanel">
      <div class="ag-devtools agm-devtools">
        <p class="ag-notice ag-notice--warn"><i class="fa-solid fa-flask" aria-hidden="true"></i> <span>Developer Tools: sample files and repo-review tools. Not needed to run a game.</span></p>
        <section class="ag-section" aria-label="Sample files">
          <div class="ag-section__head"><h3 class="ag-section__title">Sample files</h3></div>
          <div class="ag-cluster">
            <button type="button" class="ag-btn ag-btn--sm" data-ag-action="demo"><i class="fa-solid fa-flask" aria-hidden="true"></i> Load example package</button>
            <button type="button" class="ag-btn ag-btn--sm" data-ag-action="template-example"><i class="fa-solid fa-download" aria-hidden="true"></i> Download sample template package</button>
            <button type="button" class="ag-btn ag-btn--sm" data-ag-action="import-format-example"><i class="fa-solid fa-download" aria-hidden="true"></i> Download v0.2 Import JSON starter</button>
            <button type="button" class="ag-btn ag-btn--sm" data-ag-action="source-manifest-template"><i class="fa-solid fa-download" aria-hidden="true"></i> Download canonical source manifest</button>
          </div>
          <p class="agmanager-tiny">Load example package puts the included demonstration on the Import tab for a dry run; nothing changes until you Import. Package templates (<code>templates</code> + <code>template_ref</code>) compile on load. Folder destinations use <code>foundry.folder_path</code> (e.g. <code>Ashen Gate/Professions/Recipes</code>); explicit links use an <code>[[AGREF:…|Label]]</code> marker.</p>
        </section>
        <section class="ag-section agmanager-adopt" aria-label="Adopt and tag world Items">
          <div class="ag-section__head"><h3 class="ag-section__title">Adopt &amp; tag world Items for review</h3></div>
          <p class="agmanager-tiny">A review tag records a stable capture ID and a suggested classification without editing the Item. It does not approve a record or make it importer-managed.</p>
          <dl class="agmanager-package">
            <div><dt>World Items</dt><dd class="aglib-num">{{worldItemCount}}</dd></div>
            <div><dt>Tagged for review</dt><dd class="aglib-num">{{taggedCount}}</dd></div>
            <div><dt>Visible rows</dt><dd class="aglib-num">{{captureVisibleCount}}</dd></div>
          </dl>
          <div class="ag-toolbar">
            <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-capture-filter value="{{captureSearch}}" placeholder="Find Item: name or type" aria-label="Find Item" /></label>
            <div class="ag-toolbar__filters"><label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-capture-tagged-only {{#if captureTaggedOnly}}checked{{/if}}> Tagged only</label></div>
            <div class="ag-toolbar__end">
              <button type="button" class="ag-btn ag-btn--sm" data-ag-action="capture-select-visible">Select visible</button>
              <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="capture-clear">Clear selection</button>
            </div>
          </div>
          <div class="ag-table-wrap agm-scrollcap">
            <table class="ag-table">
              <thead><tr><th scope="col">Select</th><th scope="col">Item</th><th scope="col">Item type</th><th scope="col">Capture status</th></tr></thead>
              <tbody>
                {{#each captureRows}}
                <tr>
                  <td><input type="checkbox" data-ag-capture-select="{{id}}" {{#if selected}}checked{{/if}} aria-label="Select {{name}}" /></td>
                  <td><strong{{{tooltip}}}>{{name}}</strong></td>
                  <td>{{type}}</td>
                  <td>{{#if tagged}}<span class="ag-badge ag-badge--ok">Tagged</span> {{kindLabel}}{{else}}<span class="ag-badge">Not tagged</span>{{/if}}{{#if source}}<div class="agmanager-tiny">Linked to an imported record.</div>{{/if}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          <div class="ag-cluster agm-gap-top">
            <label class="agmanager-search-label">Classify selected as
              <select data-ag-capture-kind>
                {{#each captureKindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
              </select>
            </label>
            <button type="button" class="ag-btn" data-ag-action="capture-tag" {{#unless hasCaptureSelected}}disabled{{/unless}}><i class="fa-solid fa-tag" aria-hidden="true"></i> Tag selected</button>
            <button type="button" class="ag-btn ag-btn--danger" data-ag-action="capture-untag" {{#unless hasCaptureSelected}}disabled{{/unless}}>Remove selected tags…</button>
            <button type="button" class="ag-btn agm-push-end" data-ag-action="capture-export" {{#unless canCaptureExport}}disabled{{/unless}}><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export all tagged Items (JSON)</button>
          </div>
          <p class="ag-notice ag-notice--info" role="status"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{captureMessage}}</p>
          <p class="agmanager-tiny">Export includes <strong>all tagged world Items</strong> (rules, effects and module flags; no Actors or macros), unreviewed until reconciled for the repo. Check copyright and hidden GM details before uploading.</p>
        </section>
      </div>
    </div>
  </div>
  {{/if}}
  </div>
  {{#if importActive}}{{#if drawer.any}}
  <aside class="agm-drawer{{#if drawer.open}} is-open{{/if}}" aria-label="Import messages">
    <div class="agm-drawer__bar">
      <button type="button" class="ag-btn ag-btn--ghost ag-btn--sm" data-ag-drawer-toggle aria-expanded="{{#if drawer.open}}true{{else}}false{{/if}}" aria-controls="agm-drawer-body"><i class="fa-solid {{#if drawer.open}}fa-chevron-down{{else}}fa-chevron-up{{/if}}" aria-hidden="true"></i> {{#if drawer.open}}Hide messages{{else}}Show messages{{/if}}</button>
      <div class="ag-chip-group" role="group" aria-label="Message kinds">
        {{#each drawer.tabs}}<button type="button" class="ag-chip" data-ag-drawer-tab="{{id}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" aria-controls="agm-drawer-body" {{#unless count}}disabled{{/unless}}>{{label}} <span class="ag-badge{{#if count}}{{#if tone}} ag-badge--{{tone}}{{/if}}{{/if}}">{{count}}</span></button>{{/each}}
      </div>
    </div>
    {{#if drawer.open}}<div id="agm-drawer-body" class="agm-drawer__body ag-scroll" role="region" aria-label="{{drawer.label}}">
      {{#if drawer.errors}}<div class="ag-notice ag-notice--danger" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><div><strong>Validation failed — import blocked</strong><ul>{{#each errors}}<li>{{message}}</li>{{/each}}</ul></div></div>{{/if}}
      {{#if drawer.warnings}}<div class="ag-notice ag-notice--warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><div><strong>Import review notes</strong><ul>{{#each warnings}}<li>{{message}}</li>{{/each}}</ul></div></div>{{/if}}
      {{#if drawer.links}}<div class="ag-notice ag-notice--info" role="status"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><div><strong>Links to other Ashen Gate modules</strong> (for information; those records are imported separately and their ids are kept)<ul>{{#each moduleLinks}}<li>{{message}}</li>{{/each}}</ul></div></div>{{/if}}
      {{#if drawer.results}}
      <section class="agmanager-result-panel" aria-label="Import results" aria-live="polite">
        <div class="ag-section__head"><h3 class="ag-section__title">Import results</h3><button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="clear-results">Clear results</button></div>
        {{#each importReports}}
        <article class="ag-card ag-card--compact agmanager-result agmanager-result-{{tone}}">
          <header class="ag-card__head"><span><span class="ag-badge {{#if isError}}ag-badge--danger{{else}}{{#if isWarn}}ag-badge--warn{{else}}ag-badge--ok{{/if}}{{/if}}">{{toneLabel}}</span> <strong>{{file}}</strong></span> <small class="ag-card__meta">{{at}}</small></header>
          <p class="agmanager-result-headline">{{headline}}</p>
          {{#each notes}}<p class="agmanager-tiny">{{this}}</p>{{/each}}
          {{#each sections}}
          <div class="agmanager-result-module">
            <h4>{{module}} <small>{{countText}}</small></h4>
            {{#if where}}<p class="agmanager-tiny"><strong>Find it:</strong> {{where}}</p>{{/if}}
            <ul>
              {{#each lines}}
              <li class="agmanager-result-line agmanager-line-{{outcome}}"><span class="ag-badge">{{label}}</span> {{#if name}}{{name}} {{/if}}{{#if id}}<details class="agm-tech" data-ag-technical><summary>Details</summary><code class="agm-id">{{id}}</code> <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-copy-id="{{id}}" aria-label="Copy id for this record"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></details>{{/if}}{{#if message}} — {{message}}{{/if}}{{#if fix}}<br><strong>Fix:</strong> {{fix}}{{/if}}</li>
              {{/each}}
            </ul>
          </div>
          {{/each}}
        </article>
        {{/each}}
      </section>
      {{/if}}
    </div>{{/if}}
  </aside>
  {{/if}}{{/if}}
  {{#if setupActive}}
  <footer class="ag-footer agm-setup-footer">
    <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="setup-cancel">Cancel</button>
    <span class="ag-footer__status" role="status" data-ag-setup-status>{{setupMessage}}</span>
    <button type="button" class="ag-btn ag-btn--primary" data-ag-action="setup-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Changes</button>
  </footer>
  {{/if}}
</section>
