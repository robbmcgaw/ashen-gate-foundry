<section class="agmanager-body">
  <header class="ag-header agmanager-top">
    <i class="agmanager-emblem fa-solid fa-dungeon" aria-hidden="true"></i>
    <div class="agmanager-heading"><h2>Ashen Gate | General Manager <small>v0.20.0 Beta</small></h2></div>
    <button type="button" class="agmanager-help" data-ag-action="help" aria-label="Manager Help"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> Help</button><span class="agmanager-chip">GM only</span>
  </header>
  <nav class="ag-tabs agmanager-nav" aria-label="Manager tabs">
    <button type="button" data-ag-tab="import" class="{{#if importActive}}active{{/if}}"><i class="fa-solid fa-file-import"></i> Import</button>
    <button type="button" data-ag-tab="library" class="{{#if libraryActive}}active{{/if}}"><i class="fa-solid fa-layer-group"></i> Library</button>
    <button type="button" data-ag-tab="modules" class="{{#if modulesActive}}active{{/if}}"><i class="fa-solid fa-grip"></i> Modules</button>
    <button type="button" data-ag-tab="appearance" class="{{#if appearanceActive}}active{{/if}}"><i class="fa-solid fa-palette"></i> Appearance</button>
    <button type="button" data-ag-tab="history" class="{{#if historyActive}}active{{/if}}"><i class="fa-solid fa-clock-rotate-left"></i> History</button>
  </nav>

  {{#if importActive}}
  <div class="agmanager-panel">
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-filelabel"><i class="fa-solid fa-folder-open"></i> Choose JSON or ZIP package <input type="file" data-ag-file accept=".json,.zip,application/json,application/zip" /></label>
      <button type="button" data-ag-action="demo"><i class="fa-solid fa-flask"></i> Load example</button>
      <button type="button" data-ag-action="reset" class="agmanager-muted">Clear</button>
      <button type="button" data-ag-action="export" class="agmanager-muted" {{#unless hasPackage}}disabled{{/unless}}>Download report</button>
    </div>
    <div class="agmanager-package">
      <div><span>Package</span><strong>{{packageId}}</strong></div>
      <div><span>Version</span><strong>{{packageVersion}}</strong></div>
      <div><span>Schema</span><strong>{{schemaVersion}}</strong></div>
      <div><span>Records</span><strong>{{recordCount}}</strong></div>
    </div>
    <p class="agmanager-tiny"><strong>Source:</strong> {{packageSource}}. Supported: a Manager package (Item, Journal, Actor, RollTable, Macro, Location) or a Quest, Skill Tree, Headquarters facility or Factions file, which Manager recognises and hands to that module. ZIPs must contain exactly one <code>ag-foundry-import/0.2</code> JSON; source JSON and executable scripts are not run.</p>
    {{#if hasPackage}}<div class="agmanager-row agmanager-row-wrap">{{#each typeSummary}}<span class="agmanager-chip">{{name}}: {{count}}</span>{{/each}}</div>{{/if}}
    {{#if hasZipPortraits}}<label class="agmanager-toggle"><input type="checkbox" data-ag-upload-assets {{#if uploadZipArtwork}}checked{{/if}}> Upload matching ZIP portraits into this world's <code>ashen-gate-imports</code> folder before creating documents ({{zipPortraitCount}} images available).</label>{{/if}}
    <details><summary>Advanced import options</summary>
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-search-label">Import profile
        <select data-ag-profile>
          <option value="development" {{#if developmentProfile}}selected{{/if}}>Development — include unapproved</option>
          <option value="session-safe" {{#if sessionProfile}}selected{{/if}}>Session-safe — approved only</option>
        </select>
      </label>
      <span class="agmanager-tiny">Profiles change preview defaults only; they never apply changes automatically.</span>
    </div>
    <p class="agmanager-tiny"><strong>Advanced / sample files.</strong> Package templates (<code>templates</code> + <code>template_ref</code> in the JSON) are compiled automatically on load; they do not rewrite existing Items.</p>
    <div class="agmanager-row agmanager-row-wrap"><button type="button" data-ag-action="template-example">Download sample template package</button><button type="button" data-ag-action="import-format-example">Download v0.2 Import JSON starter</button><button type="button" data-ag-action="source-manifest-template">Download canonical source manifest</button></div>
    </details>
    {{#unless isSpecialist}}<label class="agmanager-toggle"><input type="checkbox" data-ag-drafts {{#if includeDrafts}}checked{{/if}}> Include <strong>draft / proposed / example</strong> records (sandbox testing only)</label>{{/unless}}
    {{#if isSpecialist}}{{#if specialistCanUpdate}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}}> <strong>Update existing {{specialistNoun}}</strong> (otherwise ones already in the world are kept as they are)</label>{{else}}<p class="agmanager-tiny">{{specialistLabel}} keeps {{specialistNoun}} that are already in the world; this file only adds new ones.</p>{{/if}}
    {{else}}{{#if hasLocationRecords}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}}> <strong>Update existing locations</strong> (otherwise locations already in the world are kept as they are)</label>{{/if}}
    {{#if hasActorRecords}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-actors {{#if updateActors}}checked{{/if}}> <strong>Update existing actors</strong> (name, image, token settings and package items only; HP, XP, level, conditions, player items, notes, ownership, folders and other modules' data are always kept. Off: actors already in the world are kept as they are)</label>{{/if}}{{/if}}
    <div class="agmanager-row">
      <button type="button" data-ag-action="preview" {{#unless hasPackage}}disabled{{/unless}}><i class="fa-solid fa-shield-halved"></i> Validate &amp; Preview</button>
      <button type="button" data-ag-action="select" class="agmanager-muted" {{#unless hasPreview}}disabled{{/unless}}>Select eligible</button>
      <button type="button" data-ag-action="clear" class="agmanager-muted" {{#unless hasPreview}}disabled{{/unless}}>Deselect all</button>
    </div>
    <p class="agmanager-tiny">Folder destinations: <code>foundry.folder_path</code> (e.g. <code>Ashen Gate/Professions/Recipes</code>). Explicit links: <code>[[AGREF:MAT-EXAMPLE|Material]]</code> (provisional, pending Tim confirmation). Missing/ambiguous UUID targets are reported in History.</p>
    <p class="agmanager-tiny">Importer accepts versioned Foundry projection JSON, or a ZIP with one valid projection. Locations and campaign state remain with their specialist modules. Imported Macros are not executed.</p>
    <p class="agmanager-notice">{{message}}</p>
    {{#if hasImportReports}}
    <section class="agmanager-result-panel" aria-label="Import results" aria-live="polite">
      <div class="agmanager-row agmanager-row-wrap"><h3>Import results</h3><button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="clear-results">Clear results</button></div>
      {{#each importReports}}
      <article class="agmanager-result agmanager-result-{{tone}}">
        <header><span class="ag-badge {{#if isError}}ag-badge--danger{{else}}{{#if isWarn}}ag-badge--warn{{else}}ag-badge--ok{{/if}}{{/if}}">{{toneLabel}}</span> <strong>{{file}}</strong> <small>{{at}}</small></header>
        <p class="agmanager-result-headline">{{headline}}</p>
        {{#each notes}}<p class="agmanager-tiny">{{this}}</p>{{/each}}
        {{#each sections}}
        <div class="agmanager-result-module">
          <h4>{{module}} <small>{{countText}}</small></h4>
          {{#if where}}<p class="agmanager-tiny"><strong>Find it:</strong> {{where}}</p>{{/if}}
          <ul>
            {{#each lines}}
            <li class="agmanager-result-line agmanager-line-{{outcome}}"><span class="agmanager-badge">{{label}}</span> {{#if name}}{{name}} {{/if}}{{#if id}}<code>{{id}}</code>{{/if}}{{#if message}} — {{message}}{{/if}}{{#if fix}}<br><strong>Fix:</strong> {{fix}}{{/if}}</li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
      </article>
      {{/each}}
    </section>
    {{/if}}
    {{#if hasWarnings}}<div class="agmanager-warnings"><strong>Import review notes</strong><ul>{{#each warnings}}<li>{{message}}</li>{{/each}}</ul></div>{{/if}}
    {{#if hasErrors}}
      <div class="agmanager-errors"><strong>Validation failed — import blocked</strong><ul>{{#each errors}}<li>{{message}}</li>{{/each}}</ul></div>
    {{/if}}
  </div>

  {{#if hasPreview}}
  <div class="agmanager-panel agmanager-results">
    <div class="agmanager-summary">
      <span class="new"><strong>{{summary.create}}</strong> new</span>
      <span class="update"><strong>{{summary.update}}</strong> update</span>
      <span class="update"><strong>{{summary.metadata}}</strong> metadata refresh</span>
      <span><strong>{{summary.unchanged}}</strong> unchanged</span>
      <span class="conflict"><strong>{{summary.conflict}}</strong> conflict</span>
      <span class="blocked"><strong>{{summary.blocked}}</strong> blocked</span>
      <span><strong>{{summary.skipped}}</strong> excluded</span>
      <span><strong>{{summary.local}}</strong> local edits</span>
    </div>
    <div class="agmanager-table-scroll">
    <table class="agmanager-table">
      <thead><tr><th>Apply?</th><th>ID / Name</th><th>Type</th><th>Status</th><th>Reason</th></tr></thead>
      <tbody>
      {{#each rows}}
      <tr>
        <td><input type="checkbox" data-ag-select="{{id}}" {{#if selected}}checked{{/if}} {{#unless canSelect}}disabled{{/unless}} aria-label="Select {{name}}" /></td>
        <td><strong>{{name}}</strong><code>{{id}}</code></td>
        <td>{{kind}}<div class="agmanager-tiny">{{lifecycle}}</div></td>
        <td><span class="agmanager-badge agmanager-{{action}}">{{badge}}</span></td>
        <td>{{reason}}{{#if changes.length}}<ul class="agmanager-changes">{{#each changes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</td>
      </tr>
      {{/each}}
      </tbody>
    </table>
    </div>
    <div class="agmanager-footer">
      <div><strong>GM-controlled.</strong> New Actors, Tables and Macros can be created. Existing Actors change only with <strong>Update existing actors</strong> ticked; character progress is never overwritten. Back up your test world first.
        {{#if actorUpdateCount}}<div><button type="button" data-ag-action="backup-actors"><i class="fa-solid fa-download"></i> Download backup of {{actorUpdateCount}} actor(s) to update</button></div>{{/if}}</div>
      <button type="button" data-ag-action="apply" class="agmanager-primary" {{#unless canApply}}disabled{{/unless}}>
        <i class="fa-solid fa-check"></i> Import Selected Documents
      </button>
    </div>
  </div>
  {{/if}}
  {{/if}}

  {{#if libraryActive}}
  <div class="agmanager-panel">
    <h3>Content Library <span class="agmanager-beta">BETA</span></h3>
    <p>Browse <strong>imported world Items and Journals</strong> using permanent Ashen Gate IDs. Filters, inspection and reference navigation are read-only; existing lifecycle operations still require confirmation.</p>
    <div class="agmanager-stats">
      <div><strong>{{libraryTotal}}</strong><span>Managed records</span></div>
      <div><strong>{{libraryActiveCount}}</strong><span>Active</span></div>
      <div><strong>{{libraryEditedCount}}</strong><span>Locally edited</span></div>
      <div><strong>{{librarySystemCount}}</strong><span>Categories</span></div>
      <div><strong>{{librarySelectedCount}}</strong><span>Selected</span></div>
    </div>
    <div class="agmanager-row agmanager-row-wrap agmanager-browser-filters">
      <label class="agmanager-search-label">Find <input type="search" data-ag-library-filter value="{{librarySearch}}" placeholder="Name, ID, package, type" /></label>
      <label class="agmanager-search-label">System <select data-ag-library-system>{{#each librarySystemOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
      <label class="agmanager-search-label">Status <select data-ag-library-status>{{#each libraryStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
      <label class="agmanager-search-label">Package <select data-ag-library-package>{{#each libraryPackageOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
      <label class="agmanager-toggle"><input type="checkbox" data-ag-library-show-archived {{#if libraryShowArchived}}checked{{/if}}> Archived</label>
    </div>
    <div class="agmanager-row agmanager-row-wrap agmanager-browser-toolbar">
      <span class="agmanager-tiny">Showing {{libraryPageLabel}} · {{libraryFilteredCount}} match</span>
      <button type="button" data-ag-action="library-previous" class="agmanager-muted" {{#unless libraryHasPrevious}}disabled{{/unless}}>◀ Previous</button>
      <button type="button" data-ag-action="library-next" class="agmanager-muted" {{#unless libraryHasNext}}disabled{{/unless}}>Next ▶</button>
      <button type="button" data-ag-action="library-select-visible">Select shown</button>
      <button type="button" data-ag-action="library-clear" class="agmanager-muted">Clear selection</button>
    </div>
    <div class="agmanager-table-scroll agmanager-browser-scroll"><table class="agmanager-table">
      <thead><tr><th>Select</th><th>Name / ID</th><th>System</th><th>Type</th><th>Status</th><th>Version</th><th>Edits</th><th>Inspect</th></tr></thead>
      <tbody>{{#each libraryRows}}<tr>
        <td><input type="checkbox" data-ag-library-select="{{uuid}}" {{#if selected}}checked{{/if}} /></td>
        <td><strong>{{name}}</strong><code>{{sourceId}}</code>{{#if archived}}<span class="agmanager-badge agmanager-blocked">ARCHIVED</span>{{/if}}</td>
        <td>{{systemLabel}}</td><td>{{entityType}}<span class="agmanager-tiny agmanager-block">{{kind}}</span></td>
        <td><span class="agmanager-badge agmanager-status-{{status}}">{{status}}</span></td><td>{{version}}</td><td>{{edited}}</td>
        <td><button type="button" data-ag-library-inspect="{{uuid}}" class="agmanager-inspect-button">Details</button></td>
      </tr>{{else}}<tr><td colspan="8">No matching managed records. Try adjusting the filters, or import an Ashen Gate package first.</td></tr>{{/each}}</tbody>
    </table></div>
    {{#if libraryHasDetail}}
    <section class="agmanager-inspector" aria-label="Selected library document details">
      <div class="agmanager-inspector-heading"><h3>{{libraryDetail.name}}</h3>
        <button type="button" data-ag-library-open="{{libraryDetail.uuid}}">Open Foundry sheet</button>
        <button type="button" data-ag-action="library-inspect-clear" class="agmanager-muted">Close</button></div>
      <p class="agmanager-tiny"><code>{{libraryDetail.sourceId}}</code> · {{libraryDetail.systemLabel}} · {{libraryDetail.entityType}} · v{{libraryDetail.version}} · {{libraryDetail.status}}</p>
      <div class="agmanager-detail-grid"><div><span>Package</span><strong>{{libraryDetail.packageId}}</strong></div>
        <div><span>Visibility</span><strong>{{libraryDetail.visibility}}</strong></div>
        <div><span>Scope</span><strong>{{libraryDetail.scope}}</strong></div>
        <div><span>Foundry UUID</span><code>{{libraryDetail.uuid}}</code></div>
        <div><span>References</span><strong>{{libraryDetail.refCount}} outward · {{libraryDetail.inboundCount}} inward</strong></div>
        <div><span>Edited fields</span><strong>{{libraryDetail.edited}}</strong></div></div>
      <p class="agmanager-tiny">Source: {{libraryDetail.provenanceSummary}}</p>
      <div class="agmanager-relations">
        <div><h4>References from this record ({{libraryDetail.refCount}})</h4>
          {{#each libraryDetail.outgoing}}<div class="agmanager-relation">
            {{#if uuid}}<button type="button" data-ag-library-jump="{{uuid}}">{{name}}</button>{{else}}<span class="agmanager-missing">{{targetId}} — {{name}}</span>{{/if}}
            <div class="agmanager-tiny">{{relation}} · {{mode}} · {{targetId}}</div></div>
          {{else}}<p class="agmanager-tiny">No outgoing typed references.</p>{{/each}}
        </div>
        <div><h4>Records linking here ({{libraryDetail.inboundCount}})</h4>
          {{#each libraryDetail.incoming}}<div class="agmanager-relation"><button type="button" data-ag-library-jump="{{uuid}}">{{name}}</button>
            <div class="agmanager-tiny">{{relation}} · {{sourceId}}</div></div>
          {{else}}<p class="agmanager-tiny">No managed records link to this ID.</p>{{/each}}
        </div>
      </div>
      {{#if libraryDetail.editedFields.length}}<p class="agmanager-tiny">Locally edited fields (not overwritten by browsing): {{#each libraryDetail.editedFields}}{{this}} · {{/each}}</p>{{/if}}
    </section>
    {{/if}}
    <section class="ag-card agmanager-worldexport">
      <h3>Export Ashen Gate data</h3>
      <p class="agmanager-tiny">One JSON file of all Ashen Gate tagged world records plus the other modules' definitions (no play state). GM only.</p>
      <div class="agmanager-row agmanager-row-wrap">
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="world-export-everything"><i class="fa-solid fa-file-export"></i> Export everything</button>
        <button type="button" class="ag-btn" data-ag-action="world-export-changed"><i class="fa-solid fa-file-circle-exclamation"></i> Export changed since last export</button>
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="world-export-copy"><i class="fa-solid fa-copy"></i> Copy summary</button>
      </div>
      {{#if worldExportSummary}}<pre class="agmanager-tiny agmanager-worldexport-summary">{{worldExportSummary}}</pre>{{/if}}
    </section>
    <div class="agmanager-row agmanager-row-wrap agmanager-commands">
      <button type="button" data-ag-action="library-check"><i class="fa-solid fa-magnifying-glass"></i> Check library</button>
      <button type="button" data-ag-action="library-export" {{#unless hasLibrarySelected}}disabled{{/unless}}>Export selected / local edits</button>
      <button type="button" data-ag-action="library-replace" {{#unless hasLibrarySelected}}disabled{{/unless}}>Replace from loaded JSON</button>
      <button type="button" data-ag-action="library-archive" {{#unless hasLibrarySelected}}disabled{{/unless}}>Archive</button>
      <button type="button" data-ag-action="library-restore" {{#unless hasLibrarySelected}}disabled{{/unless}}>Restore</button>
      <button type="button" data-ag-action="library-stage" {{#unless hasLibrarySelected}}disabled{{/unless}}>Copy to staging compendium</button>
      <button type="button" data-ag-action="library-delete" class="agmanager-danger" {{#unless hasLibrarySelected}}disabled{{/unless}}>Delete archived</button>
    </div>
    <details class="agmanager-adopt" data-ag-adopt {{#if adoptOpen}}open{{/if}}>
    <summary><strong>Adopt &amp; export world Items for review</strong></summary>

    
    <p>Assign <strong>review tags</strong> to world Items without editing their contents. A tag records a stable capture ID and suggested classification; <strong>it does not approve a record or make it importer-managed.</strong></p>
    <div class="agmanager-package">
      <div><span>World Items</span><strong>{{worldItemCount}}</strong></div>
      <div><span>Tagged for review</span><strong>{{taggedCount}}</strong></div>
      <div><span>Visible rows</span><strong>{{captureVisibleCount}}</strong></div>
    </div>
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-search-label">Find Item <input type="search" data-ag-capture-filter value="{{captureSearch}}" placeholder="Name or type" /></label>
      <label class="agmanager-toggle"><input type="checkbox" data-ag-capture-tagged-only {{#if captureTaggedOnly}}checked{{/if}}> Tagged only</label>
      <button type="button" data-ag-action="capture-select-visible">Select visible</button>
      <button type="button" data-ag-action="capture-clear" class="agmanager-muted">Clear selection</button>
    </div>
    <div class="agmanager-table-scroll agmanager-captures-scroll">
      <table class="agmanager-table">
        <thead><tr><th>Select</th><th>Item / Foundry UUID</th><th>Item type</th><th>Capture status</th></tr></thead>
        <tbody>
          {{#each captureRows}}
          <tr>
            <td><input type="checkbox" data-ag-capture-select="{{id}}" {{#if selected}}checked{{/if}} /></td>
            <td><strong>{{name}}</strong><code>{{uuid}}</code></td>
            <td>{{type}}</td>
            <td>{{#if tagged}}<span class="agmanager-badge agmanager-captured">TAGGED</span> {{kindLabel}}<code>{{capture.captureId}}</code>{{else}}<span class="agmanager-badge">Not tagged</span>{{/if}}{{#if source}}<div class="agmanager-tiny">Imported binding: {{source.sourceId}}</div>{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-search-label">Classify selected as
        <select data-ag-capture-kind>
          {{#each captureKindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
        </select>
      </label>
      <button type="button" data-ag-action="capture-tag" {{#unless hasCaptureSelected}}disabled{{/unless}}><i class="fa-solid fa-tag"></i> Tag selected</button>
      <button type="button" data-ag-action="capture-untag" class="agmanager-muted" {{#unless hasCaptureSelected}}disabled{{/unless}}>Remove selected tags</button>
    </div>
    <p class="agmanager-notice">{{captureMessage}}</p>
    <div class="agmanager-footer agmanager-capture-footer">
      <div>Exports <strong>all tagged world Items</strong>, not just the visible/selected rows. Exported data is <strong>unreviewed</strong> until reconciled for the repo. No Actors or macros are included.</div>
      <button type="button" class="agmanager-primary" data-ag-action="capture-export" {{#unless canCaptureExport}}disabled{{/unless}}><i class="fa-solid fa-file-export"></i> Export all tagged Items (JSON)</button>
    </div>
    <p class="agmanager-tiny">Export includes system rules, active effects and other module flags. Review copyright/third-party content and hidden GM details before uploading.</p>
      </details>
    {{#if hasAudit}}<div class="agmanager-audit" aria-label="Library check results">
    {{#each audit}}<div class="agmanager-auditrow agmanager-{{level}}"><span>{{level}}</span> {{message}}</div>{{/each}}
    </div>{{/if}}
    <p class="agmanager-notice">{{libraryMessage}}</p>
    <p class="agmanager-tiny">Only Manager-managed projected world documents appear here; this is <strong>not</strong> the live Profession Ledger, Skill Tree or campaign-state browser. Unclassified/Shared is intentional where content ownership is ambiguous. Delete retains existing safeguards and requires a world backup.</p>
  </div>
  {{/if}}

  {{#if modulesActive}}
  <div class="agmanager-panel">
    <h3>Ashen Gate Modules <span class="agmanager-beta">BETA</span></h3>
    <p>Open other Ashen Gate modules from one place. The Manager discovers <strong>installed modules</strong> and uses their published <code>api.open()</code> launcher or registered Foundry settings window; it doesn't assume a module has an interface.</p>
    <div class="agmanager-module-grid">
    {{#each launcherRows}}
      <article class="agmanager-module-card">
        <div><h4>{{title}}</h4><code>{{id}}</code><p class="agmanager-tiny">v{{version}} · {{state}} · Player access: {{playerAccessState}} (GM launcher remains available)</p><p class="agmanager-tiny">{{role}}</p></div>
        <button type="button" data-ag-module-open="{{id}}" {{#unless canOpen}}disabled{{/unless}}>Open</button>
      </article>
    {{else}}<p>No other Ashen Gate modules were detected in this world. Enable a module and reopen this tab.</p>
    {{/each}}
    </div>
    <p class="agmanager-tiny">Disabled means the module is inactive or has not exposed an Open API / settings menu. Other workstreams can support direct opening by exposing <code>game.modules.get(moduleId).api.open()</code>. This tab never installs, enables or changes another module.</p>
  </div>
  {{/if}}

  {{#if appearanceActive}}
  <div class="agmanager-panel agmanager-appearance">
    <h3>Appearance <span class="agmanager-beta">GM world default</span></h3>
    <p>Choose the default skin for every player who has not picked their own (players see it live; anyone who has not reloaded since a module update needs one refresh, F5). Colour skins change interface colours; Stone Tablet and Tome Pages also reshape panels, tabs and buttons. It never changes Player Access, Actor progress, permissions or content.</p>
    <div class="agmanager-row agmanager-row-wrap">
      <label>World default
        <select data-ag-world-skin aria-label="Ashen Gate world default appearance">
          {{#each appearanceSkinRows}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} — {{description}}</option>{{/each}}
        </select>
      </label>
      <button type="button" class="ag-btn ag-btn--primary" data-ag-action="appearance-save-world" {{#if busy}}disabled{{/if}}>Save World Default</button>
      <button type="button" data-ag-action="appearance-my-appearance" class="agmanager-muted">Open My Appearance</button>
    </div>
    <p role="status" class="agmanager-notice">{{appearanceMessage}}</p>
    <p class="agmanager-tiny">Effective on your screen: {{appearanceCurrent.effective}} · Your override: {{#if appearanceCurrent.userOverride}}{{appearanceCurrent.userOverride}}{{else}}Inherit GM default{{/if}}</p>
    <p class="agmanager-tiny">For all players: Foundry Game Settings → <strong>Ashen Gate | My Appearance</strong>. The separate player-safe screen cannot open this GM-only Manager.</p>
    <section class="agmanager-access-compact" aria-label="Player module access">
      <h4>Player access <span class="agmanager-beta">show or hide modules from players</span></h4>
      <div class="agmanager-row agmanager-row-wrap agmanager-access-actions">
        <button type="button" data-ag-action="player-access-refresh" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Refresh</button>
        <button type="button" data-ag-action="player-access-hide-all" {{#unless playerAccessHasVisible}}disabled{{/unless}}><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide all ({{playerAccessVisibleCount}})</button>
      </div>
      <p class="agmanager-notice" role="status">{{playerAccessMessage}}</p>
      <ul class="agmanager-access-list">
        {{#each playerAccessRows}}
        <li title="{{reason}}"><span class="agmanager-access-name"><strong>{{title}}</strong> <span class="agmanager-access-version">v{{version}}</span></span>
          <span class="agmanager-access-state">{{state}}</span>
          {{#if canToggle}}
            {{#if playerAccessEnabled}}<button type="button" data-ag-player-access-toggle="{{id}}" data-ag-player-access-enabled="false" {{#if @root.busy}}disabled{{/if}} aria-label="Hide {{title}} from players">Hide</button>
            {{else}}<button type="button" data-ag-player-access-toggle="{{id}}" data-ag-player-access-enabled="true" {{#if @root.busy}}disabled{{/if}} aria-label="Show {{title}} to players">Show</button>{{/if}}
          {{else}}<span class="agmanager-tiny">{{reason}}</span>{{/if}}
        </li>
        {{else}}<li>No Ashen Gate modules detected.</li>{{/each}}
      </ul>
      {{#if playerAccessReport}}
        <details open class="agmanager-access-report"><summary>Hide all: {{playerAccessReport.changed.length}} hidden; {{playerAccessReport.failed.length}} failed; {{playerAccessReport.skipped.length}} skipped</summary>
          {{#each playerAccessReport.failed}}<p class="agmanager-missing">Failed: {{title}} — {{error}}</p>{{/each}}
          {{#each playerAccessReport.skipped}}<p>Skipped: {{title}} ({{reason}})</p>{{/each}}
        </details>
      {{/if}}
      <p class="agmanager-tiny">Each module saves its own setting. Needs <code>ag-player-access/1</code>; older modules show Unsupported. Hiding never deletes progress.</p>
    </section>
  </div>
  {{/if}}

  {{#if historyActive}}
  <div class="agmanager-panel">
    <h3>Recent import operations</h3>
    <p>History is a compact activity log, <strong>not</strong> an undo system. The manager downloads pre-change snapshots for updates and destructive operations. Keep a Foundry world backup.</p>
    {{#if hasHistory}}
      {{#each history}}
      <details class="agmanager-history">
        <summary><strong>{{packageId}}</strong> · v{{packageVersion}} · {{at}} · {{results.length}} record(s)</summary>
        <div class="agmanager-history-records">
        {{#each results}}
          <div><span class="agmanager-badge">{{status}}</span> <code>{{id}}</code> {{action}} {{message}} {{uuid}}</div>
        {{/each}}
        </div>
      </details>
      {{/each}}
    {{else}}<p>No imports recorded yet.</p>{{/if}}
  </div>
  {{/if}}
</section>
