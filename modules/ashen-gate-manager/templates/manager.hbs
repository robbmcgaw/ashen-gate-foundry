<section class="agmanager-body">
  <header class="ag-header agmanager-top">
    <i class="agmanager-emblem fa-solid fa-dungeon" aria-hidden="true"></i>
    <div class="agmanager-heading"><h2>Ashen Gate | General Manager <small>v0.42.1</small></h2></div>
    <div class="agmanager-appearance-menu" data-ag-appearance-menu>
      <button type="button" class="agmanager-help agmanager-appearance-toggle" data-ag-appearance-toggle aria-haspopup="dialog" aria-controls="agmanager-appearance-pop" aria-expanded="{{#if appearanceOpen}}true{{else}}false{{/if}}"><i class="fa-solid fa-palette" aria-hidden="true"></i> Appearance <i class="fa-solid fa-caret-down" aria-hidden="true"></i></button>
      <div id="agmanager-appearance-pop" class="agmanager-appearance-pop agmanager-appearance" role="dialog" aria-label="Appearance: GM world default" data-ag-appearance-pop {{#unless appearanceOpen}}hidden{{/unless}}>
        <h3>Appearance <span class="agmanager-beta">GM world default</span></h3>
        <p class="agmanager-tiny">The default skin for every player who has not picked their own (players see it live; anyone who has not reloaded since a module update needs one refresh, F5). Colour skins change interface colours; Stone Tablet and Tome Pages also reshape panels, tabs and buttons. It never changes Player Access, Actor progress, permissions or content.</p>
        <div class="ag-skin-picker" role="radiogroup" aria-label="Ashen Gate world default appearance" data-ag-skin-picker="world">
          {{#each appearanceSkinRows}}<button type="button" role="radio" class="ag-skin-card{{#if selected}} is-selected{{/if}}" aria-checked="{{#if selected}}true{{else}}false{{/if}}" tabindex="{{#if selected}}0{{else}}-1{{/if}}" data-ag-skin-value="{{id}}" aria-describedby="ag-wskin-desc-{{id}}"><span class="ag-swatch" aria-hidden="true">{{#each swatch}}<i style="background:{{this}}"></i>{{/each}}</span><span class="ag-skin-card__text"><span class="ag-skin-card__name">{{label}}</span><small id="ag-wskin-desc-{{id}}" class="ag-my-appearance-desc">{{description}}</small></span></button>{{/each}}
        </div>
        <p role="status" class="agmanager-notice">{{appearanceMessage}}</p>
        <p class="agmanager-tiny">Effective on your screen: {{appearanceCurrent.effective}} · Your override: {{#if appearanceCurrent.userOverride}}{{appearanceCurrent.userOverride}}{{else}}Inherit GM default{{/if}}</p>
        <div class="ag-field" data-ag-size-field="gm">
          <span id="ag-size-label-gm">Size</span>
          <div><div class="ag-segmented" role="radiogroup" aria-labelledby="ag-size-label-gm" aria-describedby="ag-size-hint-gm" data-ag-size-picker="gm">{{#each appearanceSizes}}<button type="button" role="radio" aria-checked="{{#if selected}}true{{else}}false{{/if}}" tabindex="{{#if selected}}0{{else}}-1{{/if}}" data-ag-size-value="{{id}}">{{label}}</button>{{/each}}</div></div>
          <small id="ag-size-hint-gm" class="ag-field__hint">Comfortable makes text and controls larger on this device only.</small>
        </div>
        <p class="agmanager-tiny">For all players: Foundry Game Settings → <strong>Ashen Gate | My Appearance</strong>. The separate player-safe screen cannot open this GM-only Manager.</p>
        <div class="agmanager-row agmanager-appearance-actions">
          <button type="button" data-ag-action="appearance-my-appearance" class="agmanager-muted">Open My Appearance</button>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-action="appearance-save-world" {{#if busy}}disabled{{/if}}>Save World Default</button>
        </div>
      </div>
    </div>
    <button type="button" class="agmanager-help" data-ag-action="help" aria-label="Manager Help"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> Help</button><span class="agmanager-chip">GM only</span>
  </header>
  <nav class="ag-tabs agmanager-nav" aria-label="Manager tabs">
    <button type="button" data-ag-tab="import" class="{{#if importActive}}active{{/if}}"><i class="fa-solid fa-file-import"></i> Import</button>
    <button type="button" data-ag-tab="items" class="{{#if itemsActive}}active{{/if}}"><i class="fa-solid fa-boxes-stacked"></i> Items</button>
    <button type="button" data-ag-tab="modules" class="{{#if modulesActive}}active{{/if}}"><i class="fa-solid fa-grip"></i> Modules</button>
    <button type="button" data-ag-tab="scenes" class="{{#if scenesActive}}active{{/if}}"><i class="fa-solid fa-cloud-sun"></i> Scenes</button>
    <button type="button" data-ag-tab="setup" class="{{#if setupActive}}active{{/if}}"><i class="fa-solid fa-gear"></i> GM Setup</button>
    <button type="button" data-ag-tab="history" class="{{#if historyActive}}active{{/if}}"><i class="fa-solid fa-clock-rotate-left"></i> History</button>
  </nav>

  {{#if importActive}}
  <div class="agmanager-panel">
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-filelabel"><i class="fa-solid fa-folder-open"></i> Choose JSON or ZIP package <input type="file" data-ag-file accept=".json,.zip,application/json,application/zip" /></label>
      <button type="button" data-ag-action="demo"><i class="fa-solid fa-flask"></i> Load example</button>
      <button type="button" data-ag-action="reset" class="agmanager-muted">Clear</button>
      <button type="button" data-ag-action="export" class="agmanager-muted" {{#unless hasPackage}}disabled{{/unless}}>Download report</button>
    </div>
    <div class="agmanager-package">
      <div><span>Package</span><strong>{{packageId}}</strong></div>
      <div><span>Version</span><strong>{{packageVersion}}</strong></div>
      <div><span>Schema</span><strong>{{schemaVersion}}</strong></div>
      <div><span>Records</span><strong>{{recordCount}}</strong></div>
    </div>
    {{#if zipBundle}}<div class="agmanager-zip-contents" aria-label="ZIP contents">
      <h3>ZIP contents: {{zipBundle.source}}</h3>
      <p class="agmanager-tiny">{{zipBundle.summary}} Files import one at a time in this order (Manager packages first), each through the normal preview and Apply; nothing changes until you confirm each Apply.</p>
      <table class="agmanager-table"><thead><tr><th>Import</th><th>File</th><th>Type</th><th>Records</th><th>Status</th></tr></thead><tbody>
      {{#each zipBundle.rows}}<tr class="{{#if isCurrent}}agmanager-current{{/if}}">
        <td><input type="checkbox" data-ag-zip-pick="{{filename}}" {{#if picked}}{{#unless isError}}checked{{/unless}}{{/if}} {{#unless canPick}}disabled{{/unless}} aria-label="Import {{filename}}" /></td>
        <td><code>{{filename}}</code></td><td>{{label}}</td><td>{{count}}</td>
        <td>{{status}}{{#if notice}}<div class="agmanager-tiny">{{notice}}</div>{{/if}}</td></tr>{{/each}}
      {{#each zipBundle.skipped}}<tr><td></td><td><code>{{filename}}</code></td><td>Skipped</td><td>—</td><td class="agmanager-tiny">{{reason}}</td></tr>{{/each}}
      </tbody></table>
      <div class="agmanager-row agmanager-row-wrap">
        {{#if zipBundle.running}}<button type="button" data-ag-action="zip-cancel" class="agmanager-muted">Stop ZIP import</button><button type="button" data-ag-action="zip-skip">Skip this file</button>
        {{else}}<button type="button" data-ag-action="zip-start" class="agmanager-primary" {{#unless zipBundle.pickedCount}}disabled{{/unless}}><i class="fa-solid fa-list-check"></i> Import selected files ({{zipBundle.pickedCount}})</button>{{/if}}
      </div>
    </div>{{/if}}
    <p class="agmanager-tiny"><strong>Source:</strong> {{packageSource}}. Supported: a Manager package (Item, Journal, Actor, RollTable, Macro, Location) or a Quest, Skill Tree, Headquarters facility or Factions file, which Manager recognises and hands to that module. A ZIP can hold one Manager package, or several import files (Manager packages plus Quest, Skill Tree, Headquarters and Factions files) that you pick from a ZIP contents list; source JSON and executable scripts are not run.</p>
    {{#if hasPackage}}<div class="agmanager-row agmanager-row-wrap">{{#each typeSummary}}<span class="agmanager-chip">{{name}}: {{count}}</span>{{/each}}</div>{{/if}}
    {{#if hasZipPortraits}}<label class="agmanager-toggle"><input type="checkbox" data-ag-upload-assets {{#if uploadZipArtwork}}checked{{/if}}> Upload matching ZIP portraits into this world's <code>ashen-gate-imports</code> folder before creating documents ({{zipPortraitCount}} images available).</label>{{/if}}
    <details><summary>Advanced import options</summary>
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-search-label">Import profile
        <select data-ag-profile>
          <option value="development" {{#if developmentProfile}}selected{{/if}}>Development — include unapproved</option>
          <option value="session-safe" {{#if sessionProfile}}selected{{/if}}>Session-safe — approved only</option>
        </select>
      </label>
      <span class="agmanager-tiny">Profiles change preview defaults only; they never apply changes automatically.</span>
    </div>
    <p class="agmanager-tiny"><strong>Advanced / sample files.</strong> Package templates (<code>templates</code> + <code>template_ref</code> in the JSON) are compiled automatically on load; they do not rewrite existing Items.</p>
    <div class="agmanager-row agmanager-row-wrap"><button type="button" data-ag-action="template-example">Download sample template package</button><button type="button" data-ag-action="import-format-example">Download v0.2 Import JSON starter</button><button type="button" data-ag-action="source-manifest-template">Download canonical source manifest</button></div>
    </details>
    {{#unless isSpecialist}}<label class="agmanager-toggle"><input type="checkbox" data-ag-drafts {{#if includeDrafts}}checked{{/if}}> Include <strong>draft / proposed / example</strong> records (sandbox testing only)</label>{{/unless}}
    {{#if isSpecialist}}{{#if specialistCanUpdate}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}}> <strong>Update existing {{specialistNoun}}</strong> (otherwise ones already in the world are kept as they are)</label>{{else}}<p class="agmanager-tiny">{{specialistLabel}} keeps {{specialistNoun}} that are already in the world; this file only adds new ones.</p>{{/if}}
    {{else}}{{#if hasLocationRecords}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}}> <strong>Update existing locations and routes</strong> (otherwise those already in the world are kept as they are; discovery, reveal and journey state are always kept)</label>{{/if}}
    {{#if hasActorRecords}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-actors {{#if updateActors}}checked{{/if}}> <strong>Update existing actors</strong> (name, image, token settings and package items only; HP, XP, level, conditions, player items, notes, ownership, folders and other modules' data are always kept. Off: actors already in the world are kept as they are)</label>{{/if}}{{/if}}
    <div class="agmanager-row">
      <button type="button" data-ag-action="preview" {{#unless hasPackage}}disabled{{/unless}}><i class="fa-solid fa-shield-halved"></i> Validate &amp; Preview</button>
      <button type="button" data-ag-action="select" class="agmanager-muted" {{#unless hasPreview}}disabled{{/unless}}>Select eligible</button>
      <button type="button" data-ag-action="clear" class="agmanager-muted" {{#unless hasPreview}}disabled{{/unless}}>Deselect all</button>
    </div>
    <p class="agmanager-tiny">Folder destinations: <code>foundry.folder_path</code> (e.g. <code>Ashen Gate/Professions/Recipes</code>). Explicit links: <code>[[AGREF:MAT-EXAMPLE|Material]]</code>. Missing/ambiguous UUID targets are reported in History.</p>
    <p class="agmanager-tiny">Importer accepts versioned Foundry projection JSON, or a ZIP with one valid projection. Locations and campaign state remain with their specialist modules. Imported Macros are not executed.</p>
    <p class="agmanager-notice">{{message}}</p>
    {{#if hasImportReports}}
    <section class="agmanager-result-panel" aria-label="Import results" aria-live="polite">
      <div class="agmanager-row agmanager-row-wrap"><h3>Import results</h3><button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="clear-results">Clear results</button></div>
      {{#each importReports}}
      <article class="agmanager-result agmanager-result-{{tone}}">
        <header><span class="ag-badge {{#if isError}}ag-badge--danger{{else}}{{#if isWarn}}ag-badge--warn{{else}}ag-badge--ok{{/if}}{{/if}}">{{toneLabel}}</span> <strong>{{file}}</strong> <small>{{at}}</small></header>
        <p class="agmanager-result-headline">{{headline}}</p>
        {{#each notes}}<p class="agmanager-tiny">{{this}}</p>{{/each}}
        {{#each sections}}
        <div class="agmanager-result-module">
          <h4>{{module}} <small>{{countText}}</small></h4>
          {{#if where}}<p class="agmanager-tiny"><strong>Find it:</strong> {{where}}</p>{{/if}}
          <ul>
            {{#each lines}}
            <li class="agmanager-result-line agmanager-line-{{outcome}}"><span class="agmanager-badge">{{label}}</span> {{#if name}}{{name}} {{/if}}{{#if id}}<code>{{id}}</code>{{/if}}{{#if message}} — {{message}}{{/if}}{{#if fix}}<br><strong>Fix:</strong> {{fix}}{{/if}}</li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
      </article>
      {{/each}}
    </section>
    {{/if}}
    {{#if hasWarnings}}<div class="agmanager-warnings"><strong>Import review notes</strong><ul>{{#each warnings}}<li>{{message}}</li>{{/each}}</ul></div>{{/if}}
    {{#if hasErrors}}
      <div class="agmanager-errors"><strong>Validation failed — import blocked</strong><ul>{{#each errors}}<li>{{message}}</li>{{/each}}</ul></div>
    {{/if}}
  </div>

  {{#if hasPreview}}
  <div class="agmanager-panel agmanager-results">
    <div class="agmanager-summary">
      <span class="new"><strong>{{summary.create}}</strong> new</span>
      <span class="update"><strong>{{summary.update}}</strong> update</span>
      <span class="update"><strong>{{summary.metadata}}</strong> metadata refresh</span>
      <span><strong>{{summary.unchanged}}</strong> unchanged</span>
      <span class="conflict"><strong>{{summary.conflict}}</strong> conflict</span>
      <span class="blocked"><strong>{{summary.blocked}}</strong> blocked</span>
      <span><strong>{{summary.skipped}}</strong> excluded</span>
      <span><strong>{{summary.local}}</strong> local edits</span>
    </div>
    <div class="agmanager-table-scroll">
    <table class="agmanager-table">
      <thead><tr><th>Apply?</th><th>ID / Name</th><th>Type</th><th>Status</th><th>Reason</th></tr></thead>
      <tbody>
      {{#each rows}}
      <tr>
        <td><input type="checkbox" data-ag-select="{{id}}" {{#if selected}}checked{{/if}} {{#unless canSelect}}disabled{{/unless}} aria-label="Select {{name}}" /></td>
        <td><strong>{{name}}</strong><code>{{id}}</code></td>
        <td>{{kind}}<div class="agmanager-tiny">{{lifecycle}}</div></td>
        <td><span class="agmanager-badge agmanager-{{action}}">{{badge}}</span></td>
        <td>{{reason}}{{#if changes.length}}<ul class="agmanager-changes">{{#each changes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{#if effectRows.length}}<ul class="agmanager-changes agmanager-effects" aria-label="Effects">{{#each effectRows}}<li><strong>{{label}}</strong> {{name}}{{#if effId}} <code>{{effId}}</code>{{/if}}: {{reason}}</li>{{/each}}</ul>{{/if}}</td>
      </tr>
      {{/each}}
      </tbody>
    </table>
    </div>
    <div class="agmanager-footer">
      <div><strong>GM-controlled.</strong> New Actors, Tables and Macros can be created. Existing Actors change only with <strong>Update existing actors</strong> ticked; character progress is never overwritten. Back up your test world first.
        {{#if actorUpdateCount}}<div><button type="button" data-ag-action="backup-actors"><i class="fa-solid fa-download"></i> Download backup of {{actorUpdateCount}} actor(s) to update</button></div>{{/if}}</div>
      <button type="button" data-ag-action="apply" class="agmanager-primary" {{#unless canApply}}disabled{{/unless}}>
        <i class="fa-solid fa-check"></i> Import Selected Documents
      </button>
    </div>
  </div>
  {{/if}}
  {{/if}}

  {{#if itemsActive}}
  <div class="agitems">
    <div class="ag-toolbar agitems-filters" role="search" aria-label="Item filters (kept across the rail)">
      <input type="search" class="agitems-query" data-ag-items-query value="{{itemFilters.query}}" placeholder="Search name, id, tag, text… (id:MAT-HERB, type:weapon, tag:, status:)" aria-label="Search items" />
      <label>Source <select data-ag-items-filter="source">{{#each itemFilters.sources}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Type <select data-ag-items-filter="type">{{#each itemFilters.types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Origin <select data-ag-items-filter="origin">{{#each itemFilters.origins}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Rarity <select data-ag-items-filter="rarity" class="ag-rarity-select">{{#each itemFilters.rarities}}<option value="{{value}}" class="ag-rarity-option--{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Folder <select data-ag-items-filter="folder">{{#each itemFilters.folders}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="agitems-check"><input type="checkbox" data-ag-items-coreref {{#if itemFilters.coreRef}}checked{{/if}}> Has core_ref</label>
      <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-items-clear {{#unless itemFilters.active}}disabled{{/unless}}>Clear filters ({{itemFilters.active}})</button>
    </div>
    {{#if itemFilters.packsNote}}<p class="agmanager-tiny agitems-note">{{itemFilters.packsNote}} <button type="button" class="ag-btn ag-btn--sm" data-ag-items-packs><i class="fa-solid fa-book-atlas" aria-hidden="true"></i> Load compendiums</button></p>{{/if}}
  <div class="aglib">
    <nav class="aglib-rail" aria-label="Items sections">
      {{#each itemsViews}}<button type="button" class="aglib-rail__tab {{#if active}}active{{/if}}" data-ag-items-view="{{id}}" title="{{label}}" aria-label="{{label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}"><i class="{{icon}}" aria-hidden="true"></i></button>{{/each}}
    </nav>
    <div class="aglib-main">
    <h3 class="agitems-title">{{itemsViewLabel}}</h3>
    {{#if itemsAll}}
    <div class="agbrowse" data-ag-browse></div>
    {{/if}}
    {{#if libraryRecordsActive}}
    <div class="aglib-split">
      <section class="aglib-list" aria-label="Managed records">
        <div class="aglib-tools">
          <div class="aglib-chips" role="group" aria-label="System">
            {{#each librarySystemChips}}<button type="button" class="aglib-chip {{#if selected}}active{{/if}}" data-ag-library-system-chip="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{label}} <span class="aglib-num">{{count}}</span></button>{{/each}}
          </div>
          <details class="aglib-filters" {{#if libraryHasFilters}}open{{/if}}>
            <summary>More filters{{#if libraryHasFilters}} <span class="ag-badge ag-badge--accent">{{libraryFilterCount}}</span>{{/if}}</summary>
            <div class="aglib-filter-grid">
              <label>Status <select data-ag-library-status>{{#each libraryStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
              <label>Package <select data-ag-library-package>{{#each libraryPackageOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
              <label class="aglib-check"><input type="checkbox" data-ag-library-show-archived {{#if libraryShowArchived}}checked{{/if}}> Show archived</label>
            </div>
          </details>
          {{#if libraryNarrowed}}<p class="agmanager-tiny">The filters above leave {{libraryInScope}} of {{libraryTotal}} records.</p>{{/if}}
          <div class="aglib-count"><span>{{libraryFilteredCount}} of {{libraryTotal}} records</span><span>{{libraryEditedCount}} edited · {{libraryActiveCount}} active</span></div>
        </div>
        <div class="aglib-rows">
          {{#each libraryGroups}}
          <div class="aglib-group"><span>{{label}}</span><span class="aglib-num">{{count}}</span></div>
          {{#each rows}}<div class="aglib-row {{#if focused}}is-focused{{/if}}">
            <input type="checkbox" data-ag-library-select="{{uuid}}" {{#if selected}}checked{{/if}} aria-label="Select {{name}}" />
            <button type="button" class="aglib-row__main" data-ag-library-inspect="{{uuid}}" {{#if focused}}aria-current="true"{{/if}}{{{tooltip}}}>
              <span class="aglib-row__name">{{name}}</span>
              <span class="aglib-row__meta"><code>{{sourceId}}</code><span class="aglib-pill aglib-status-{{status}}">{{status}}</span>{{#if archived}}<span class="aglib-pill aglib-pill--danger">archived</span>{{/if}}{{#if version}}<span class="aglib-pill">v{{version}}</span>{{/if}}{{#if edited}}<span class="aglib-pill aglib-pill--warn">{{edited}} edit(s)</span>{{/if}}</span>
            </button>
          </div>{{/each}}
          {{else}}{{#if libraryTotal}}<p class="ag-empty aglib-empty">No matching managed records. Clear the search or filters.</p>{{else}}<p class="ag-empty aglib-empty">Ashen Gate records lists only records imported through the Import tab, so it is empty until you import an Ashen Gate package. Items from D&amp;D Beyond, Plutonium or compendiums are not listed here: use All items to search them.</p>{{/if}}{{/each}}
        </div>
        <div class="aglib-selbar">
          {{#if hasLibrarySelected}}<strong class="aglib-num">{{librarySelectedCount}} selected</strong>
          <details class="aglib-menu">
            <summary class="ag-btn ag-btn--sm">Actions <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
            <div class="aglib-menu__pop" role="menu">
              <button type="button" role="menuitem" data-ag-action="library-export"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export selected / local edits</button>
              <button type="button" role="menuitem" data-ag-action="library-replace"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Replace from loaded JSON</button>
              <button type="button" role="menuitem" data-ag-action="library-stage"><i class="fa-solid fa-box-archive" aria-hidden="true"></i> Copy to staging compendium</button>
              <hr>
              <button type="button" role="menuitem" data-ag-action="library-archive"><i class="fa-solid fa-folder-minus" aria-hidden="true"></i> Archive</button>
              <button type="button" role="menuitem" data-ag-action="library-restore"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i> Restore</button>
              <hr>
              <button type="button" role="menuitem" data-ag-action="library-delete" class="aglib-danger"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete archived… <small>asks first</small></button>
            </div>
          </details>
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="library-clear">Clear</button>
          {{else}}<span class="agmanager-tiny">Tick records to act on them.</span>{{/if}}
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost aglib-end" data-ag-action="library-select-visible">Select shown</button>
        </div>
        <div class="aglib-pager">
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="library-previous" aria-label="Previous page" {{#unless libraryHasPrevious}}disabled{{/unless}}><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
          <span class="aglib-num">{{libraryPageLabel}}</span>
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="library-next" aria-label="Next page" {{#unless libraryHasNext}}disabled{{/unless}}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
        </div>
      </section>
      <section class="aglib-detail" aria-label="Selected library document details">
        {{#if libraryHasDetail}}
        <div class="aglib-detail__head">
          <div class="aglib-detail__title"><h3>{{libraryDetail.name}}</h3>
            <div class="aglib-row__meta"><code>{{libraryDetail.sourceId}}</code><span class="aglib-pill aglib-status-{{libraryDetail.status}}">{{libraryDetail.status}}</span><span class="aglib-pill">{{libraryDetail.kind}} · {{libraryDetail.entityType}}</span>{{#if libraryDetail.archived}}<span class="aglib-pill aglib-pill--danger">archived</span>{{/if}}{{#if libraryDetail.edited}}<span class="aglib-pill aglib-pill--warn">{{libraryDetail.edited}} local edit(s)</span>{{/if}}</div>
          </div>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-library-open="{{libraryDetail.uuid}}"><i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Open sheet</button>
          <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="library-inspect-clear" aria-label="Close details"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        {{#if libraryDetail.isItem}}<div class="agpreview" data-ag-item-preview="{{libraryDetail.uuid}}" aria-live="polite"><p class="agmanager-tiny">Loading item card…</p></div>{{/if}}
        <div class="aglib-kv">
          <div><span>System</span><strong>{{libraryDetail.systemLabel}}</strong></div>
          <div><span>Version</span><strong class="aglib-num">{{libraryDetail.version}}</strong></div>
          <div><span>Package</span><strong>{{libraryDetail.packageId}}</strong></div>
          <div><span>Visibility</span><strong>{{libraryDetail.visibility}}</strong></div>
          <div><span>Scope</span><strong>{{libraryDetail.scope}}</strong></div>
          <div><span>References</span><strong class="aglib-num">{{libraryDetail.refCount}} out · {{libraryDetail.inboundCount}} in</strong></div>
          <div class="aglib-kv__wide"><span>Foundry UUID</span><code>{{libraryDetail.uuid}}</code></div>
        </div>
        <div class="aglib-refs">
          <div><h4>Uses <span class="aglib-num">({{libraryDetail.refCount}})</span></h4>
            {{#each libraryDetail.outgoing}}<div class="aglib-ref">
              {{#if uuid}}<button type="button" class="aglib-link" data-ag-library-jump="{{uuid}}">{{name}}</button>{{else}}<span class="aglib-missing">Not in this world</span>{{/if}}
              <code>{{targetId}}</code><span class="agmanager-tiny">{{relation}} · {{mode}}</span></div>
            {{else}}<p class="agmanager-tiny">No outgoing typed references.</p>{{/each}}
          </div>
          <div><h4>Used by <span class="aglib-num">({{libraryDetail.inboundCount}})</span></h4>
            {{#each libraryDetail.incoming}}<div class="aglib-ref"><button type="button" class="aglib-link" data-ag-library-jump="{{uuid}}">{{name}}</button>
              <code>{{sourceId}}</code><span class="agmanager-tiny">{{relation}}</span></div>
            {{else}}<p class="agmanager-tiny">No managed records link to this ID.</p>{{/each}}
          </div>
        </div>
        {{#if libraryDetail.editedFields.length}}<div><h4>Local edits <span class="aglib-num">({{libraryDetail.edited}})</span></h4><p class="agmanager-tiny aglib-wrap">{{#each libraryDetail.editedFields}}<code>{{this}}</code> {{/each}}</p><p class="agmanager-tiny">Re-import keeps these. Replace from loaded JSON overwrites them.</p></div>{{/if}}
        <p class="agmanager-tiny aglib-wrap">Source: {{libraryDetail.provenanceSummary}}</p>
        {{else}}
        <div class="ag-empty aglib-empty"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><p>Choose a record to see its details, references and local edits.</p>
          <p class="agmanager-tiny">Only Manager-managed world documents appear here. Live Profession Ledger, Skill Tree and other campaign state stays in those modules. Unclassified / Shared is used where content ownership is ambiguous.</p></div>
        {{/if}}
        <p class="aglib-status" role="status">{{libraryMessage}}</p>
      </section>
    </div>
    {{/if}}

    {{#if libraryCheckActive}}
    <section class="ag-card aglib-section" aria-label="Check library">
      <h3>Check library</h3>
      <p class="agmanager-tiny">Looks for missing references, duplicate IDs and other problems in managed records. Read-only.</p>
      <div class="aglib-actions"><button type="button" class="ag-btn ag-btn--primary" data-ag-action="library-check"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Check library</button></div>
      {{#if hasAudit}}<div class="agmanager-audit" aria-label="Library check results">
      {{#each audit}}<div class="agmanager-auditrow agmanager-{{level}}"><span>{{level}}</span> {{message}}</div>{{/each}}
      </div>{{/if}}
      <p class="aglib-status" role="status">{{libraryMessage}}</p>
    </section>
    <section class="ag-card aglib-section" aria-label="Housekeeping report">
      <div class="agmanager-row agmanager-row-wrap"><h3>Housekeeping report</h3>
        <button type="button" class="ag-btn" data-ag-action="org-housekeeping"><i class="fa-solid fa-clipboard-list"></i> Run report</button></div>
      <p class="agmanager-tiny">Read-only. Lists Ashen Gate ids found more than once (world and all compendiums) and likely temporary records so you can decide. Nothing is changed or deleted. Checks always look at everything; the filters above do not apply.</p>
      {{#if housekeeping.report}}
        <h4>Duplicate ids ({{housekeeping.report.duplicates.length}})</h4>
        {{#if housekeeping.report.hasDuplicates}}<ul>{{#each housekeeping.report.duplicates}}<li><code>{{sourceId}}</code> ×{{count}}: {{#each rows}}{{name}} ({{where}}, {{documentName}}){{#unless @last}}; {{/unless}}{{/each}}</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">None.</p>{{/if}}
        <h4>Likely temporary ({{housekeeping.report.temporary.length}})</h4>
