          {{#unless org.whereWritable}}<p class="ag-notice ag-notice--warn"><i class="fa-solid fa-lock" aria-hidden="true"></i> <span>Inspect only: {{org.whereReason}}</span></p>{{/unless}}
          <fieldset class="agitems-scope"><legend>Which documents</legend>
            <label class="ag-field--inline agmanager-toggle"><input type="radio" name="ag-org-scope" value="all" data-ag-org-scope {{#if org.scopeAll}}checked{{/if}}> Everything in {{org.whereLabel}}</label>
            <label class="ag-field--inline agmanager-toggle"><input type="radio" name="ag-org-scope" value="selection" data-ag-org-scope {{#if org.scopeSelection}}checked{{/if}} {{#unless org.filtered}}disabled{{/unless}}> This selection or folder: {{#if org.filtered}}<strong class="aglib-num">{{org.selectedCount}}</strong> document(s) matching the filters above{{#if org.folderFilter}} (the chosen folder and its sub-folders){{/if}}{{else}}set a filter or a Folder above first{{/if}}</label>
            {{#if org.packsMissing}}<p class="ag-notice ag-notice--warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> <span>This compendium's index is not loaded yet, so the selection is empty. Press <strong>Load compendiums</strong> above.</span></p>{{/if}}
          </fieldset>
          <div class="ag-cluster">
            {{#each org.types}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-org-type="{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}
            <label class="agmanager-search-label">Move <select data-ag-org-mode>
              <option value="misfiled" {{#if org.modeMisfiled}}selected{{/if}}>Only unfiled and misfiled</option>
              <option value="all" {{#if org.modeAll}}selected{{/if}}>Refile everything (also from your own folders)</option>
            </select></label>
            <button type="button" class="ag-btn" data-ag-action="org-preview"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Preview</button>
          </div>
          <p class="agmanager-tiny" role="status">{{org.message}}</p>
          <p class="agmanager-tiny">To organize one folder, pick it under <strong>Folder</strong> above (in Filters) and choose <strong>This selection or folder</strong>. Only the folder changes: nothing is renamed, edited or deleted. Help explains how the rules decide.</p>

          {{#if org.preview}}
          <div class="ag-cluster">
            <span class="ag-badge">Would move: {{org.preview.totals.moves}}</span>
            <span class="ag-badge">New folders: {{org.preview.totals.createFolders}}</span>
            <span class="ag-badge">Already in place: {{org.preview.totals.inPlace}}</span>
            <span class="ag-badge">Skipped: {{org.preview.totals.skipped}}</span>
            <span class="ag-badge">No rule: {{org.preview.totals.unmatched}}</span>
          </div>
          {{#each org.preview.parts}}
          <div class="agmanager-org-part">
            <h4>{{label}} — {{moveCount}} to move{{#if ../org.preview.narrowed}} <span class="ag-badge">selection only</span>{{/if}}</h4>
            {{#unless writable}}<p class="ag-notice ag-notice--warn"><i class="fa-solid fa-lock" aria-hidden="true"></i> <span><strong>Inspect only:</strong> {{blockedReason}}.</span></p>{{/unless}}
            {{#each groups}}
            <details class="agmanager-org-group"><summary><strong>{{path}}</strong> ({{count}})</summary>
              <div class="ag-table-wrap agm-scrollcap"><table class="ag-table"><thead><tr><th scope="col">Document</th><th scope="col">From</th><th scope="col">Why</th><th scope="col" class="is-actions"><span class="ag-sr-only">Actions</span></th></tr></thead><tbody>
              {{#each rows}}<tr><td>{{name}}</td><td>{{from}}</td><td>{{why}}{{#if weak}} <span class="ag-badge ag-badge--warn">weak evidence: check it</span>{{/if}}</td><td class="is-actions">{{#if @root.org.world}}<button type="button" class="ag-btn ag-btn--sm" data-ag-org-keep="{{id}}" data-ag-org-doctype="{{documentName}}" aria-label="Keep {{name}} here" data-tooltip="Never move this document" data-tooltip-class="ag-tooltip">Keep here</button>{{/if}}</td></tr>{{/each}}
              </tbody></table></div>
            </details>
            {{/each}}
            {{#if hasCreates}}<details class="agmanager-org-group"><summary>Folders to create ({{createFolders.length}})</summary><ul>{{#each createFolders}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}
            {{#if hasSkipped}}<details class="agmanager-org-group"><summary>Skipped ({{skipped.length}})</summary><ul class="agm-scrollcap">{{#each skipped}}<li><strong>{{name}}</strong> in {{from}}{{#if to}} (rule says {{to}}){{/if}} — {{reason}}</li>{{/each}}</ul></details>{{/if}}
            {{#if hasUnmatched}}<details class="agmanager-org-group"><summary>No matching rule, left where they are ({{unmatched.length}})</summary><ul class="agm-scrollcap">{{#each unmatched}}<li><strong>{{name}}</strong> in {{from}}</li>{{/each}}</ul></details>{{/if}}
          </div>
          {{/each}}
          <footer class="ag-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="org-clear">Cancel</button>
            <span class="ag-btn-group">
              <button type="button" class="ag-btn" data-ag-action="org-backup" {{#unless org.preview.totals.moves}}disabled{{/unless}}><i class="fa-solid fa-download" aria-hidden="true"></i> Download backup</button>
              <button type="button" class="ag-btn ag-btn--primary" data-ag-action="org-apply" {{#unless org.preview.canApply}}disabled{{/unless}}><i class="fa-solid fa-folder-tree" aria-hidden="true"></i> Apply ({{org.preview.totals.moves}})…</button>
            </span>
          </footer>
          {{/if}}
          {{#if org.result}}<p class="agmanager-tiny"><strong>Last apply:</strong> {{org.result.message}}</p>
            {{#if org.hasEmpty}}<details class="agmanager-org-group"><summary>Empty folders (report only, nothing deleted): {{org.result.emptyFolders.length}}</summary><ul>{{#each org.result.emptyFolders}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}{{/if}}
          </div>
        </details>

        <details class="ag-fold" data-ag-fold-key="folders-rules">
          <summary class="ag-fold__summary"><span class="ag-fold__title">Rules &amp; protected folders</span>{{#if org.schemaIsDefault}}<span class="ag-fold__hint">Default rules</span>{{else}}<span class="ag-fold__hint">Your own rules</span>{{/if}}</summary>
          <div class="ag-fold__body">
          {{#if org.world}}
          <h4>Protected folders</h4>
          <p class="agmanager-tiny">Nothing in a protected folder or its sub-folders is ever moved.</p>
          <div class="ag-cluster">
            <select data-ag-org-folder aria-label="Folder to protect">{{#each org.openFolders}}<option value="{{id}}">{{label}}</option>{{/each}}</select>
            <button type="button" class="ag-btn" data-ag-org-protect><i class="fa-solid fa-lock" aria-hidden="true"></i> Protect folder</button>
          </div>
          {{#if org.protectedFolders.length}}<ul class="ag-list">{{#each org.protectedFolders}}<li><span>{{label}}</span> <button type="button" class="ag-btn ag-btn--sm" data-ag-org-unprotect="{{id}}" aria-label="Unprotect {{label}}">Unprotect</button></li>{{/each}}</ul>{{/if}}
          {{/if}}
          <div class="ag-section__head"><h4>Rules {{#if org.schemaIsDefault}}<span class="ag-badge">Default</span>{{/if}}</h4>
            <span class="ag-btn-group">
              <button type="button" class="ag-btn ag-btn--sm" data-ag-action="org-schema-edit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit rules (JSON)</button>
              <button type="button" class="ag-btn ag-btn--sm" data-ag-action="org-schema-export"><i class="fa-solid fa-download" aria-hidden="true"></i> Export</button>
              {{{fileButtons.rules}}}
            </span></div>
          <p class="agmanager-tiny">Checked top to bottom; the first rule that matches decides the folder. <code>{tier}</code>, <code>{rarity}</code>, <code>{spellLevel}</code>, <code>{creatureType}</code>, <code>{crBand}</code> and <code>{entityType}</code> fill in from the document.</p>
          {{#if org.editing}}
            <textarea data-ag-org-schema-text rows="18" class="agmanager-org-json" aria-label="Organize rules JSON">{{org.schemaText}}</textarea>
            <footer class="ag-footer">
              <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="org-schema-cancel">Cancel</button>
              <button type="button" class="ag-btn ag-btn--primary" data-ag-action="org-schema-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Changes</button>
            </footer>
          {{else}}
          <div class="ag-table-wrap agm-scrollcap"><table class="ag-table"><thead><tr><th scope="col" class="is-num">#</th><th scope="col">Rule</th><th scope="col">For</th><th scope="col">When</th><th scope="col">Folder</th></tr></thead><tbody>
            {{#each org.rules}}<tr><td class="is-num">{{n}}</td><td>{{label}}</td><td>{{types}}</td><td><code>{{match}}</code></td><td>{{#if leave}}<em>leave where it is</em>{{else}}{{path}}{{/if}}</td></tr>{{/each}}
          </tbody></table></div>
          {{/if}}
          <p class="agm-gap-top"><button type="button" class="ag-btn ag-btn--sm ag-btn--danger" data-ag-action="org-schema-reset">Reset rules to defaults…</button></p>
          </div>
        </details>

        <details class="ag-fold" data-ag-fold-key="folders-history">
          <summary class="ag-fold__summary"><span class="ag-fold__title">History</span><span class="ag-fold__count">{{org.history.length}}</span><span class="ag-fold__hint">The last 5 organize runs, for Undo.</span></summary>
          <div class="ag-fold__body">
          <div class="ag-cluster"><button type="button" class="ag-btn" data-ag-action="org-undo" {{#unless org.history.length}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Undo last organize…</button></div>
          {{#if org.history.length}}<ul>{{#each org.history}}<li>{{at}} · {{source}} · {{mode}} · {{moved}} moved</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">No organize runs yet.</p>{{/if}}
          </div>
        </details>
      </div>
      {{/if}}

      {{#if coreLinksActive}}
      <div class="agmanager-organize">
        <section class="ag-section" aria-label="Core links">
          <div class="ag-section__head"><h3 class="ag-section__title">Core links</h3>
            <button type="button" class="ag-btn" data-ag-action="cl-scan"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Scan</button></div>
          <p class="agmanager-tiny" role="status">{{cl.message}}</p>
          {{#if cl.noRefs}}<div class="ag-empty"><p class="ag-empty__title">Nothing to link</p><p class="ag-empty__text">No Ashen Gate item in this world has a <code>core_ref</code>. Add one in the source data and re-import, or ignore this section.</p></div>{{/if}}
          <p class="agmanager-tiny">Checks Ashen Gate world Items with <code>core_ref</code> against 2024 (5.5e) items; where it looks is set in {{{gotoSources}}}. <strong>Adopt</strong> takes the core item's image and data and keeps the name, id, folder, ownership and module data. Player inventories are never touched.</p>
          {{#if cl.preview}}
          <div class="ag-cluster">
            <span class="ag-badge">Core items found: {{cl.preview.poolSize}}</span>
            <span class="ag-badge">Ashen Gate items without core_ref (untouched): {{cl.preview.withoutRef}}</span>
            <span class="ag-badge">Ticked: {{cl.preview.tickedCount}}</span>
          </div>
          {{#if cl.preview.hiddenByFilters}}<p class="agmanager-tiny">{{cl.preview.hiddenByFilters}} scanned item(s) are hidden by the filters above. Apply and Download backup use only the ticked items shown here.</p>{{/if}}
          {{#each cl.preview.notes}}<p class="ag-notice ag-notice--warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> <span>{{this}}</span></p>{{/each}}
          {{#each cl.preview.groups}}
          <div class="agmanager-org-part">
            <h4>{{label}} ({{rows.length}})</h4>
            <div class="ag-table-wrap agm-scrollcap"><table class="ag-table"><thead><tr><th scope="col"><span class="ag-sr-only">Link</span></th><th scope="col">Ashen Gate item</th><th scope="col">core_ref</th><th scope="col">Core match</th><th scope="col">Notes</th></tr></thead><tbody>
            {{#each rows}}<tr>
              <td>{{#if selectable}}<input type="checkbox" data-ag-cl-tick="{{id}}" {{#if ticked}}checked{{/if}} aria-label="Link {{name}}">{{/if}}</td>
              <td><strong>{{name}}</strong><details class="agm-tech" data-ag-technical><summary>Details</summary><code class="agm-id">{{sourceId}}</code> <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-copy-id="{{sourceId}}" aria-label="Copy id for {{name}}"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></details></td>
              <td>{{refText}}</td>
              <td>{{#if best}}<strong>{{best.name}}</strong> <span class="ag-badge">{{best.confidence}}</span><div class="agmanager-tiny">{{best.sourceLabel}} · matched on {{matchedOn}}</div>
                {{#if hasOthers}}<details><summary class="agmanager-tiny">Other candidates ({{others.length}})</summary><ul>{{#each others}}<li>{{name}} — {{confidence}}, {{sourceLabel}}</li>{{/each}}</ul></details>{{/if}}{{else}}—{{/if}}</td>
              <td>{{reason}}
                {{#if selectable}}{{#if canAdopt}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-cl-linkonly="{{id}}" {{#if linkOnly}}checked{{/if}}> Link only (keep my data)</label>{{/if}}{{/if}}
                {{#if diffCount}}<details><summary class="agmanager-tiny">What Adopt changes ({{diffCount}} field(s))</summary>
                  <div class="ag-table-wrap"><table class="ag-table"><thead><tr><th scope="col">Field</th><th scope="col">Now</th><th scope="col">Core</th></tr></thead><tbody>{{#each diff}}<tr><td><code>{{path}}</code></td><td>{{before}}</td><td>{{after}}</td></tr>{{/each}}</tbody></table></div></details>{{/if}}</td>
            </tr>{{/each}}
            </tbody></table></div>
          </div>
          {{/each}}
          <footer class="ag-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="cl-clear">Cancel</button>
            <span class="ag-btn-group">
              <button type="button" class="ag-btn" data-ag-action="cl-backup" {{#unless cl.preview.tickedCount}}disabled{{/unless}}><i class="fa-solid fa-download" aria-hidden="true"></i> Download backup</button>
              <button type="button" class="ag-btn ag-btn--primary" data-ag-action="cl-apply" {{#unless cl.preview.tickedCount}}disabled{{/unless}}><i class="fa-solid fa-link" aria-hidden="true"></i> Apply ({{cl.preview.tickedCount}})…</button>
            </span>
          </footer>
          {{/if}}
        </section>
        <section class="ag-section" aria-label="Core link history">
          <div class="ag-section__head"><h3 class="ag-section__title">Recent core-link runs</h3>
            <button type="button" class="ag-btn" data-ag-action="cl-undo" {{#unless cl.history.length}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Undo last core link…</button></div>
          {{#if cl.history.length}}<ul>{{#each cl.history}}<li>{{at}} · {{count}} linked · {{adopted}} adopted</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">No core-link runs yet. The last 5 are kept for Undo.</p>{{/if}}
        </section>
      </div>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if codexActive}}
  <div class="ag-split aglib-split agcodex">
    <section class="ag-split__list aglib-list" aria-label="NPCs">
      <div class="aglib-tools">
        <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-codex-search value="{{codex.search}}" placeholder="Search NPC name or role" aria-label="Search NPCs" /></label>
        <div class="ag-chip-group" role="group" aria-label="Show">
          <button type="button" class="ag-chip" data-ag-codex-filter="all" aria-pressed="{{#if codex.filterAll}}true{{else}}false{{/if}}">All <span class="aglib-num">{{codex.total}}</span></button>
          <button type="button" class="ag-chip" data-ag-codex-filter="known" aria-pressed="{{#if codex.filterKnown}}true{{else}}false{{/if}}">Known to players <span class="aglib-num">{{codex.known}}</span></button>
          <button type="button" class="ag-chip" data-ag-codex-filter="hidden" aria-pressed="{{#if codex.filterHidden}}true{{else}}false{{/if}}">Hidden <span class="aglib-num">{{codex.hidden}}</span></button>
        </div>
      </div>
      <div class="aglib-rows">
        {{#each codex.rows}}<button type="button" class="agcodex-row {{#if focused}}is-focused{{/if}}" data-ag-codex-focus="{{id}}" {{#if focused}}aria-current="true"{{/if}}>
          {{#if img}}<img class="agcodex-portrait" src="{{img}}" alt="">{{else}}<span class="agcodex-portrait" aria-hidden="true">{{initials}}</span>{{/if}}
          <span class="agcodex-row__text"><span class="aglib-row__name">{{name}}</span>
            <span class="aglib-row__meta">{{#if role}}<span class="agmanager-tiny">{{role}}</span>{{/if}}<span class="ag-badge{{#if discovery.party}} ag-badge--ok{{/if}}">{{discoveryLabel}}</span>{{#if revealedCount}}<span class="ag-badge aglib-num">{{revealedCount}} field(s)</span>{{/if}}</span></span>
        </button>{{else}}<div class="ag-empty aglib-empty"><i class="fa-solid fa-address-book" aria-hidden="true"></i><p class="ag-empty__title">No NPCs yet</p><p class="ag-empty__text">NPC records (<code>entity_type: "NPC"</code>) appear here once you import them on the Import tab.</p></div>{{/each}}
      </div>
      <div class="aglib-selbar">
        <details class="aglib-menu">
          <summary class="ag-btn ag-btn--sm">Codex <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
          <div class="aglib-menu__pop">
            <button type="button" data-ag-action="codex-export"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export codex (GM file)</button>
            {{{fileButtons.codex}}}
            <hr>
            <button type="button" data-ag-action="codex-player-view"><i class="fa-solid fa-eye" aria-hidden="true"></i> Open the player view</button>
          </div>
        </details>
        <span class="agmanager-tiny aglib-end">{{#if codex.playerAccess}}Shared with players{{else}}Not shared with players{{/if}} ({{{gotoModules}}})</span>
      </div>
    </section>
    <section class="ag-split__detail aglib-detail" aria-label="NPC details">
      {{#with codex.detail}}
      <div class="aglib-detail__head">
        {{#if img}}<img class="agcodex-portrait agcodex-portrait--lg" src="{{img}}" alt="">{{else}}<span class="agcodex-portrait agcodex-portrait--lg" aria-hidden="true">{{initials}}</span>{{/if}}
        <div class="aglib-detail__title"><h3>{{name}}</h3>
          <div class="aglib-row__meta">{{#if status}}<span class="ag-badge">{{status}}</span>{{/if}}<details class="agm-tech" data-ag-technical><summary>Details</summary><code class="agm-id">{{id}}</code> <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-copy-id="{{id}}" aria-label="Copy id for {{name}}"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></details></div></div>
        <button type="button" class="ag-btn" data-ag-action="codex-open-actor"><i class="fa-solid fa-user" aria-hidden="true"></i> Actor sheet</button>
        <button type="button" class="ag-btn ag-btn--ghost ag-btn--icon" data-ag-action="codex-close" aria-label="Close details" data-tooltip="Close details" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      </div>
      {{{../codex.tabsHtml}}}
      <div {{{../codex.panelAttrs}}} class="agm-subpanel agcodex-panel">
      {{#if ../codex.onReveals}}
      <div class="ag-section__head agcodex-reveals-head"><span class="ag-badge ag-badge--accent">Applies now</span><span class="agmanager-tiny">Each choice saves at once. Players see it next time they open the codex.</span>
        <button type="button" class="ag-btn ag-btn--sm ag-btn--danger aglib-end" data-ag-action="codex-hide-all"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide from players…</button></div>
      <div class="agcodex-field agcodex-field--discovery">
        <div><div class="agcodex-label">Players know this NPC</div><p class="agmanager-tiny">Name and portrait. Nothing else shows to a player until this includes them.</p></div>
        {{#with discoverySeg}}<div class="agcodex-control"><div class="agcodex-seg-wrap"><div class="ag-segmented agcodex-seg" role="radiogroup" aria-label="Who knows: {{label}}" data-ag-codex-seg="{{key}}"><button type="button" role="radio" aria-checked="{{#if isHidden}}true{{else}}false{{/if}}" tabindex="{{hiddenTab}}" data-mode="hidden">Hidden</button><button type="button" role="radio" class="agcodex-seg__party" aria-checked="{{#if isParty}}true{{else}}false{{/if}}" tabindex="{{partyTab}}" data-mode="party">Party</button></div>
          <details class="aglib-menu agcodex-chars"><summary class="ag-btn ag-btn--sm{{#if isActors}} is-on{{/if}}" aria-label="Characters who know: {{label}}">Characters{{#if isActors}} ({{actorCount}}){{/if}} <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
            <div class="aglib-menu__pop agcodex-chars__pop">{{#each chars}}<label><input type="checkbox" data-ag-codex-actor="{{../key}}" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{else}}<p class="agmanager-tiny">No player characters yet (character Actors with a player owner).</p>{{/each}}</div>
          </details></div>
          {{#if isActors}}<p class="agcodex-who">Known by {{who}}</p>{{/if}}</div>{{/with}}
      </div>
      {{#each fields}}
      <div class="agcodex-field">
        <div class="agcodex-field__body"><div class="agcodex-label">{{label}}</div>
          {{#if isLinks}}{{#if ../links.length}}<div class="agcodex-links">{{#each ../links}}{{#if open}}<button type="button" class="agcodex-link agcodex-link--{{kind}} is-open" data-ag-codex-deity="{{id}}" data-tooltip="{{title}}" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-sun" aria-hidden="true"></i> {{name}}</button>{{else}}<span class="agcodex-link agcodex-link--{{kind}}"{{#if title}} data-tooltip="{{title}}" data-tooltip-class="ag-tooltip"{{/if}}>{{name}}</span>{{/if}}{{/each}}</div>{{else}}<p class="agmanager-tiny">No connections. Add links under Notes &amp; links.</p>{{/if}}
          {{else}}{{#if empty}}<p class="agmanager-tiny">Not set.</p>{{else}}<p class="agcodex-value">{{value}}</p>{{/if}}{{/if}}
        </div>
        <div class="agcodex-control"><div class="agcodex-seg-wrap"><div class="ag-segmented agcodex-seg" role="radiogroup" aria-label="Who knows: {{label}}" data-ag-codex-seg="{{key}}"><button type="button" role="radio" aria-checked="{{#if isHidden}}true{{else}}false{{/if}}" tabindex="{{hiddenTab}}" data-mode="hidden">Hidden</button><button type="button" role="radio" class="agcodex-seg__party" aria-checked="{{#if isParty}}true{{else}}false{{/if}}" tabindex="{{partyTab}}" data-mode="party">Party</button></div>
          <details class="aglib-menu agcodex-chars"><summary class="ag-btn ag-btn--sm{{#if isActors}} is-on{{/if}}" aria-label="Characters who know: {{label}}">Characters{{#if isActors}} ({{actorCount}}){{/if}} <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
            <div class="aglib-menu__pop agcodex-chars__pop">{{#each chars}}<label><input type="checkbox" data-ag-codex-actor="{{../key}}" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{else}}<p class="agmanager-tiny">No player characters yet (character Actors with a player owner).</p>{{/each}}</div>
          </details></div>
          {{#if isActors}}<p class="agcodex-who">Known by {{who}}</p>{{/if}}</div>
      </div>
      {{/each}}
      {{/if}}
      {{#if ../codex.onNotes}}
      <div class="agcodex-gm">
        <h4><i class="fa-solid fa-lock" aria-hidden="true"></i> GM only: never sent to players</h4>
        {{#each gmFields}}<div class="agcodex-gmrow"><span class="agcodex-label">{{label}}</span>{{#if items}}<ul class="agcodex-value">{{#each items}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p class="agcodex-value">{{text}}</p>{{/if}}</div>{{else}}<p class="agmanager-tiny">The record has no portrayal, session role, stat block or GM notes.</p>{{/each}}
      </div>
      <div class="agcodex-edit" data-ag-codex-form>
        <label class="ag-field">What the party has learned <textarea rows="3" data-ag-codex-learned>{{learned}}</textarea></label>
        <label class="ag-field">Connections <input type="text" data-ag-codex-links value="{{linksText}}" aria-describedby="agcodex-links-hint"><span id="agcodex-links-hint" class="ag-field__hint">Ids separated by spaces: LOC-, FAC-, DEITY-, QUEST-, NPC-.</span></label>
        <label class="ag-field">Your notes (GM only) <textarea rows="3" data-ag-codex-notes>{{notes}}</textarea></label>
        <footer class="ag-footer agcodex-footer">
          <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="codex-cancel">Cancel</button>
          <span class="ag-footer__status" role="status" data-ag-codex-status></span>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-action="codex-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Changes</button>
        </footer>
      </div>
      {{/if}}
      {{#if ../codex.onPreview}}
      <div class="agcodex-preview">
        <label class="agcodex-preview__pick">Preview as <select data-ag-codex-preview>{{#each ../codex.previewOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{#if ../codex.previewing}}{{{../codex.previewHtml}}}{{else}}<p class="agmanager-tiny">Choose the party or a character to see exactly what they receive.</p>{{/if}}
      </div>
      {{/if}}
      </div>
      {{else}}
      <div class="ag-empty aglib-empty"><i class="fa-solid fa-address-book" aria-hidden="true"></i><p class="ag-empty__title">No NPC chosen</p>
        <p class="ag-empty__text">Choose an NPC to set who knows what. Reveals, what the party has learned, connections and your notes are kept on re-import.</p></div>
      {{/with}}
      <p class="aglib-status" role="status">{{codex.message}}</p>
    </section>
  </div>
  {{/if}}

  {{#if modulesActive}}
  <section class="ag-section agmanager-presession" aria-label="Pre-session check">
    <div class="ag-section__head"><h3 class="ag-section__title">Pre-session check</h3>
      <span class="ag-btn-group">
        <button type="button" class="ag-btn" data-ag-action="presession-run"><i class="fa-solid fa-stethoscope" aria-hidden="true"></i> Run pre-session check</button>
        <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="presession-clear" {{#unless preSession.hasResults}}disabled{{/unless}}><i class="fa-solid fa-eraser" aria-hidden="true"></i> Clear results</button>
        <button type="button" class="ag-btn ag-btn--sm" data-ag-action="presession-copy" {{#unless preSession.hasText}}disabled{{/unless}}><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy report</button>
        <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="presession-download" {{#unless preSession.hasText}}disabled{{/unless}}><i class="fa-solid fa-download" aria-hidden="true"></i> Download report</button>
      </span></div>
    <p class="agmanager-tiny">Read-only: module versions, GM storage, Player Access, [TEST] data, hidden names in player views, Locations migration, the Foundry version, and content links (recipes, skill tree perks, core links, Profession Ledger names, quest item rewards).</p>
    {{#if preSession.hasResults}}
    <p class="agmanager-presession-summary"><strong>{{preSession.summary}}</strong></p>
    <ul class="ag-rows agmanager-presession-rows">
    {{#each preSession.rows}}<li class="ag-row agmanager-presession-row"><span class="ag-badge{{#if tone}} ag-badge--{{tone}}{{/if}}">{{status}}</span><span class="ag-row__main"><span class="ag-row__title">{{check}}</span><span class="ag-row__meta">{{text}}</span></span></li>{{/each}}
    </ul>
    {{else}}
    <p class="ag-field__hint agmanager-presession-empty">{{preSession.empty}}</p>
    {{/if}}
  </section>
  <section class="ag-section" aria-label="Ashen Gate modules">
    <div class="ag-section__head"><h3 class="ag-section__title">Ashen Gate modules</h3>
      <span class="ag-btn-group">
        <button type="button" class="ag-btn ag-btn--sm" data-ag-action="player-access-refresh" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Refresh</button>
        <button type="button" class="ag-btn ag-btn--sm" data-ag-action="player-access-hide-all" {{#unless playerAccessHasVisible}}disabled{{/unless}}><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide all ({{playerAccessVisibleCount}})…</button>
      </span></div>
    <p class="agmanager-tiny">Open each module, and show or hide its player window. Each module saves its own setting; hiding never deletes progress. Revealing a module also shows its parts in the Character Hub.</p>
    <p class="ag-notice ag-notice--info agmanager-access-bar" role="status"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{playerAccessMessage}}</p>
    {{#if playerAccessReport}}
      <div class="ag-card ag-card--compact agmanager-access-report"><p><strong>Hide all: {{playerAccessReport.changed.length}} hidden; {{playerAccessReport.failed.length}} failed; {{playerAccessReport.skipped.length}} skipped</strong></p>
        {{#each playerAccessReport.failed}}<p class="agmanager-missing">Failed: {{title}} — {{error}}</p>{{/each}}
        {{#each playerAccessReport.skipped}}<p>Skipped: {{title}} ({{reason}})</p>{{/each}}
      </div>
    {{/if}}
    <div class="ag-card-grid agmanager-module-grid">
    {{#each moduleCards}}
      <article class="ag-card agmanager-module-card">
        <div class="agmanager-module-card__info"><h4>{{title}}</h4><code>{{slug}}</code>
          <p class="agmanager-module-card__badge"><span class="ag-badge{{#if badge.tone}} ag-badge--{{badge.tone}}{{/if}}">{{badge.label}}</span></p>
          <p class="agmanager-tiny">v{{version}} · {{state}}</p><p class="agmanager-tiny">{{role}}</p>
          {{#unless canToggle}}<p class="agmanager-tiny">{{accessReason}}</p>{{/unless}}</div>
        <div class="agmanager-module-card__actions">
          <button type="button" class="ag-btn ag-btn--sm" data-ag-module-open="{{id}}" aria-label="Open {{title}}" {{#unless canOpen}}disabled{{/unless}}>Open</button>
          {{#if canToggle}}
            {{#if playerAccessEnabled}}<button type="button" class="ag-btn ag-btn--sm" data-ag-player-access-toggle="{{id}}" data-ag-player-access-enabled="false" {{#if @root.busy}}disabled{{/if}} aria-label="Hide {{title}} from players"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide from players</button>
            {{else}}<button type="button" class="ag-btn ag-btn--sm" data-ag-player-access-toggle="{{id}}" data-ag-player-access-enabled="true" {{#if @root.busy}}disabled{{/if}} aria-label="Reveal {{title}} to players"><i class="fa-solid fa-eye" aria-hidden="true"></i> Reveal to players</button>{{/if}}
          {{/if}}
        </div>
      </article>
    {{else}}<div class="ag-empty"><i class="fa-solid fa-grip" aria-hidden="true"></i><p class="ag-empty__title">No other Ashen Gate modules yet</p><p class="ag-empty__text">Enable one in Manage Modules, then reopen this tab.</p></div>
    {{/each}}
    </div>
    <p class="agmanager-tiny">Open is disabled for a module that is inactive or has no launcher; Reveal / Hide needs <code>ag-player-access/1</code>. This tab never installs or enables a module.</p>
  </section>
  {{/if}}

  {{#if scenesActive}}
  <div class="agscenes">
    {{{moods.tabsHtml}}}
    <div {{{moods.panelAttrs}}} class="agm-subpanel agscenes-main">
    {{#if moods.live}}
    <div class="agscenes-live">
      <div class="agscenes-col">
        <section class="ag-section" aria-label="Scene mood">
          <div class="ag-section__head agmanager-moods-head">
            <div><h3 class="ag-section__title">{{moods.sceneName}}</h3>
              <label class="agmanager-tiny">Scene <select data-ag-mood-scene>
                <option value="" {{#if moods.currentSelected}}selected{{/if}}>Current scene (viewed, else active)</option>
                {{#each moods.scenes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
              </select></label></div>
            <div class="agscenes-chips">
              {{#if moods.regions.weather}}<span class="ag-badge" data-tooltip="Core Suppress Weather region behaviours hide weather inside those areas" data-tooltip-class="ag-tooltip">{{moods.regions.weather}} region(s) block weather</span>{{/if}}
              {{#if moods.regions.darkness}}<span class="ag-badge" data-tooltip="Core Adjust Darkness Level region behaviours change darkness inside those areas" data-tooltip-class="ag-tooltip">{{moods.regions.darkness}} region(s) adjust darkness</span>{{/if}}
              {{#if moods.darknessLock}}<span class="ag-badge ag-badge--warn">Darkness locked</span>{{/if}}
              <label class="agmanager-tiny">Transition <select data-ag-mood-transition>{{#each moods.transitions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label class="agmanager-tiny" data-tooltip="Blocks any mood or layer marked as flashing, and keeps it out of Random weather. None of the shipped ones flash." data-tooltip-class="ag-tooltip"><input type="checkbox" data-ag-calm {{#if moods.calm}}checked{{/if}}> No flashing <span class="ag-badge">Applies now</span></label>
            </div>
          </div>
          <h4 class="agscenes-sect">Base mood</h4>
          <div class="agmanager-mood-buttons" role="group" aria-label="Apply a mood">
            {{#each moods.liveMoods}}<button type="button" class="ag-btn{{#if active}} ag-btn--primary{{/if}}" data-ag-mood-apply="{{id}}" {{#unless @root.moods.hasScene}}disabled{{/unless}} aria-pressed="{{#if active}}true{{else}}false{{/if}}" data-tooltip="{{summary}}" data-tooltip-class="ag-tooltip">{{#if favourite}}<i class="fa-solid fa-star" aria-hidden="true"></i><span class="ag-sr-only">Favourite:</span> {{/if}}{{label}}</button>{{/each}}
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="mood-restore" {{#unless moods.hasBase}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Back to normal</button>
          </div>
          <p class="agmanager-tiny">Picking a mood swaps the base and keeps your layers on top. <i class="fa-solid fa-star" aria-hidden="true"></i> = favourite on this scene (set in Moods &amp; layers).</p>
        </section>

        <section class="ag-section" aria-label="Add a layer">
          <div class="ag-section__head agmanager-moods-head"><h4 class="agscenes-sect">Add a layer</h4><span class="agmanager-tiny">Layers stack on the base. One weather at a time.</span></div>
          <div class="agscenes-addstrip" role="group" aria-label="Add a layer">
            {{#each moods.liveLayers}}<button type="button" class="ag-btn ag-btn--sm agscenes-add" data-ag-layer-add="{{id}}" {{#if on}}disabled{{/if}}{{#unless @root.moods.hasScene}} disabled{{/unless}} data-tooltip="{{summary}}" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{label}}</button>{{/each}}
          </div>
        </section>

        <section class="ag-section" aria-label="Random weather">
          <div class="ag-section__head agmanager-moods-head"><h4 class="agscenes-sect">Random weather</h4><span class="agmanager-tiny">A proposal first. Same seed, same result.</span></div>
          <div class="ag-cluster">
            <label class="ag-field--inline">Seed <input type="text" data-ag-roll-seed value="{{moods.roll.seed}}" maxlength="24" size="10" placeholder="e.g. 1234" autocomplete="off"></label>
            <label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-roll-keep {{#if moods.roll.keepMood}}checked{{/if}}> Keep the current mood</label>
            <button type="button" class="ag-btn" data-ag-action="roll-preview" {{#unless moods.hasScene}}disabled{{/unless}}><i class="fa-solid fa-dice" aria-hidden="true"></i> Roll</button>
            <button type="button" class="ag-btn" data-ag-action="roll-next" {{#unless moods.hasScene}}disabled{{/unless}}>Next seed</button>
          </div>
          {{#if moods.roll.plan}}
          <p class="agscenes-status" role="status">{{moods.roll.plan.text}}</p>
          <footer class="ag-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="roll-cancel">Discard</button>
            <button type="button" class="ag-btn ag-btn--primary" data-ag-action="roll-apply" {{#if moods.roll.plan.empty}}disabled{{/if}}><i class="fa-solid fa-check" aria-hidden="true"></i> Apply this roll</button>
          </footer>
          {{else}}<p class="agmanager-tiny">It only adds layers (one weather and up to two others, Blight ones a little more often) and never removes what is on the scene. Leave the seed empty for a new one.</p>{{/if}}
        </section>

        <section class="ag-section" aria-label="Fine-tune this scene">
          <div class="ag-section__head agmanager-moods-head"><h4 class="agscenes-sect">Fine-tune this scene</h4><span class="agmanager-tiny">Draft only. Nothing changes for players until Apply.</span></div>
          {{#if moods.hasScene}}
          <fieldset class="agscenes-grp" aria-label="Time of day blend">
            <legend>Time of day blend</legend>
            <div class="ag-cluster">
              <label class="ag-field--inline">From <select data-ag-blend-from>{{#each moods.blend.from}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label class="ag-field--inline">To <select data-ag-blend-to>{{#each moods.blend.to}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label class="ag-field--inline">Blend <input type="range" min="0" max="100" step="5" value="{{moods.blend.percent}}" data-ag-blend-t aria-label="Blend from the first mood to the second"> <output data-ag-blend-out>{{moods.blend.percent}}%</output></label>
            </div>
            <p class="agmanager-tiny">Release the slider to fill the controls below with the blend. It stays a draft until Apply to scene; Cancel drops it.</p>
          </fieldset>
          <div class="agscenes-tune">
            {{#each moods.draftGroups}}
            <fieldset class="agscenes-grp"><legend>{{label}}</legend>
              {{#each fields}}
              <div class="agscenes-field{{#if touched}} is-touched{{/if}}"><span>{{label}}</span>
                {{#if isNumber}}<input type="range" aria-label="{{label}}" data-ag-draft="{{path}}" min="{{min}}" max="{{max}}" step="{{step}}" value="{{value}}"><output data-ag-draft-out="{{path}}">{{display}}</output>{{/if}}
                {{#if isBoolean}}<input type="checkbox" aria-label="{{label}}" data-ag-draft="{{path}}" {{#if checked}}checked{{/if}}>{{/if}}
                {{#if isWeather}}<select aria-label="{{label}}" data-ag-draft="{{path}}">{{#each weatherOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
                {{#if isColor}}<span class="agscenes-color"><input type="color" aria-label="{{label}}" data-ag-draft="{{path}}" value="{{colorValue}}"><label class="agmanager-tiny"><input type="checkbox" data-ag-draft-none="{{path}}" {{#if isNone}}checked{{/if}}> none</label></span>{{/if}}
              </div>
              {{/each}}
            </fieldset>
            {{/each}}
          </div>
          {{#if moods.missingFields}}<p class="agmanager-tiny">Not in this Foundry version, so not shown: {{moods.missingFields}}.</p>{{/if}}
          <footer class="ag-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="draft-cancel">Cancel</button>
            <span class="ag-btn-group"><button type="button" class="ag-btn" data-ag-action="draft-save-layer">Save as layer…</button><button type="button" class="ag-btn" data-ag-action="draft-save-mood">Save as mood…</button><button type="button" class="ag-btn ag-btn--primary" data-ag-action="draft-apply"><i class="fa-solid fa-check" aria-hidden="true"></i> Apply to scene</button></span>
          </footer>
          {{else}}<p class="agmanager-tiny">View or activate a scene first.</p>{{/if}}
        </section>
      </div>

      <aside class="ag-card agscenes-stack" aria-label="On this scene now">
        <div class="ag-section__head agmanager-moods-head"><h4 class="agscenes-sect">On this scene now</h4><span class="agmanager-tiny">{{moods.layerCount}}</span></div>
        {{#each moods.stack}}
        <div class="agscenes-entry{{#if isMood}} is-mood{{/if}}">
          <div class="agmanager-moods-head"><div><span class="agscenes-kind">{{#if isMood}}Base mood{{else}}Layer{{/if}}</span><strong>{{label}}</strong></div>
            <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost ag-btn--icon" data-ag-effect-remove="{{kind}}:{{id}}" aria-label="Remove {{label}}" data-tooltip="Remove {{label}}" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
          <div class="agmanager-tiny">{{#each fields}}{{#if covered}}<s data-tooltip="A layer above decides this" data-tooltip-class="ag-tooltip">{{label}} {{value}}</s>{{else}}{{label}} {{value}}{{/if}}{{#unless @last}} · {{/unless}}{{/each}}</div>
        </div>
        {{else}}<p class="agmanager-tiny">Normal: no mood or layer applied.</p>
        {{/each}}
        <p class="agmanager-tiny agscenes-status" role="status">{{moods.message}}</p>
        <p class="agmanager-tiny">Removing a layer puts back only the fields it changed. Everyone on the scene sees changes. Weather can slow weaker player machines: use <strong>No weather</strong> if that happens.</p>
      </aside>
    </div>
    {{/if}}

    {{#if moods.library}}
    {{#if moods.edit}}
    <section class="ag-section agmanager-mood-editor" aria-label="Edit preset">
      <p><button type="button" class="ag-link" data-ag-action="mood-cancel"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All moods and layers</button></p>
      <div class="ag-section__head"><h3 class="ag-section__title">{{#if moods.edit.isNew}}New {{moods.edit.noun}}{{else}}Edit {{moods.edit.noun}}: {{moods.edit.label}}{{/if}}</h3>
        {{#unless moods.edit.isNew}}<button type="button" class="ag-btn ag-btn--sm ag-btn--danger" data-ag-action="mood-remove"><i class="fa-solid fa-trash" aria-hidden="true"></i> Remove {{moods.edit.noun}}…</button>{{/unless}}</div>
      <div class="ag-form-grid">
        {{#if moods.edit.isNew}}<label class="ag-field">Advanced: set id (optional) <input type="text" data-ag-mood-id value="{{moods.edit.id}}" placeholder="e.g. foggy-dawn" maxlength="40" autocomplete="off"><span class="ag-field__hint">Leave empty to make it from the label. Lower-case letters, digits and dashes; it cannot change later.</span></label>{{/if}}
        <label class="ag-field">Label <input type="text" data-ag-mood-label value="{{moods.edit.label}}"></label>
        <label class="ag-field">Transition <select data-ag-mood-edit-transition>{{#each moods.edit.transitions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      </div>
      <label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-mood-flashing {{#if moods.edit.flashing}}checked{{/if}}> Flashing or strobing (blocked while No flashing is on)</label>
      <p class="agmanager-tiny">Tick the fields this {{moods.edit.noun}} sets. Unticked fields are left as the scene has them.</p>
      {{#each moods.edit.groups}}
      <fieldset class="agscenes-grp"><legend>{{label}}</legend>
      <div class="agmanager-mood-fields">
      {{#each fields}}
        <label class="agmanager-mood-field"><input type="checkbox" data-ag-mood-use="{{path}}" {{#if used}}checked{{/if}}> <span>{{label}}</span>
          {{#if isNumber}}<input type="number" data-ag-mood-value="{{path}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}"> <small>{{min}} to {{max}}</small>{{/if}}
          {{#if isBoolean}}<input type="checkbox" data-ag-mood-value="{{path}}" {{#if checked}}checked{{/if}}> <small>on</small>{{/if}}
          {{#if isWeather}}<select data-ag-mood-value="{{path}}">{{#each weatherOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
          {{#if isColor}}<input type="color" data-ag-mood-value="{{path}}" value="{{colorValue}}"> <input type="checkbox" data-ag-mood-none="{{path}}" {{#if isNone}}checked{{/if}} aria-label="No colour" data-tooltip="No colour" data-tooltip-class="ag-tooltip"> <small>none</small>{{/if}}
        </label>
      {{/each}}
      </div>
      </fieldset>
      {{/each}}
      <footer class="ag-footer">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="mood-cancel">Cancel</button>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="mood-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Changes</button>
      </footer>
    </section>
    {{else}}
    <section class="ag-section" aria-label="Moods and layers">
      <div class="ag-toolbar">
        <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-mood-search value="{{moods.search}}" placeholder="Search moods and layers" aria-label="Search moods and layers"></label>
        <div class="ag-chip-group" role="group" aria-label="Show">{{#each moods.filters}}<button type="button" class="ag-chip" data-ag-mood-filter="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}</div>
        <div class="ag-toolbar__end">
          <button type="button" class="ag-btn" data-ag-action="mood-new"><i class="fa-solid fa-plus" aria-hidden="true"></i> New mood</button>
          <button type="button" class="ag-btn" data-ag-action="layer-new"><i class="fa-solid fa-plus" aria-hidden="true"></i> New layer</button>
        </div>
      </div>
      {{#each moods.libraryGroups}}
      <h4 class="agscenes-sect">{{label}}</h4>
      <div class="ag-rows agmanager-mood-list">
        {{#each items}}
        <div class="ag-row agmanager-mood-row{{#if unavailable}} is-unavailable{{/if}}">
          <div class="ag-row__main"><span class="ag-row__title">{{label}} {{#if isDefault}}<span class="ag-badge">Default</span>{{/if}}{{#if unavailable}} <span class="ag-badge ag-badge--warn">Weather "{{unavailable}}" missing</span>{{/if}}</span><span class="ag-row__meta">{{summary}}</span></div>
          <div class="ag-row__end">
