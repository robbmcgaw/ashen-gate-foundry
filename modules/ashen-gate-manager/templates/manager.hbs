            <button type="button" class="ag-btn ag-btn--sm" data-ag-action="template-example"><i class="fa-solid fa-download" aria-hidden="true"></i> Download sample template package</button>
            <button type="button" class="ag-btn ag-btn--sm" data-ag-action="import-format-example"><i class="fa-solid fa-download" aria-hidden="true"></i> Download v0.2 Import JSON starter</button>
            <button type="button" class="ag-btn ag-btn--sm" data-ag-action="source-manifest-template"><i class="fa-solid fa-download" aria-hidden="true"></i> Download canonical source manifest</button>
          </div>
