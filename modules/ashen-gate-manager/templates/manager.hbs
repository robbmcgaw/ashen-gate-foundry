          <div class="aglib-detail__title"><h3>{{libraryDetail.name}}</h3>
            <div class="aglib-row__meta"><code>{{libraryDetail.sourceId}}</code><span class="ag-badge{{#if libraryDetail.statusTone}} ag-badge--{{libraryDetail.statusTone}}{{/if}}">{{libraryDetail.status}}</span><span class="ag-badge">{{libraryDetail.kind}} · {{libraryDetail.entityType}}</span>{{#if libraryDetail.archived}}<span class="ag-badge ag-badge--danger">archived</span>{{/if}}{{#if libraryDetail.edited}}<span class="ag-badge ag-badge--warn">{{libraryDetail.edited}} local edit(s)</span>{{/if}}</div>
          </div>
          <button type="button" class="ag-btn" data-ag-library-open="{{libraryDetail.uuid}}"><i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Open sheet</button>
          <button type="button" class="ag-btn ag-btn--ghost ag-btn--icon" data-ag-action="library-inspect-clear" aria-label="Close details" data-tooltip="Close details" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        {{#if libraryDetail.isItem}}<div class="agpreview" data-ag-item-preview="{{libraryDetail.uuid}}" aria-live="polite"><p class="agmanager-tiny">Loading item card…</p></div>{{/if}}
        <div class="aglib-kv">
          <div><span>System</span><strong>{{libraryDetail.systemLabel}}</strong></div>
          <div><span>Version</span><strong class="aglib-num">{{libraryDetail.version}}</strong></div>
          <div><span>Package</span><strong>{{libraryDetail.packageId}}</strong></div>
          <div><span>Visibility</span><strong>{{libraryDetail.visibility}}</strong></div>
          <div><span>Scope</span><strong>{{libraryDetail.scope}}</strong></div>
          <div><span>References</span><strong class="aglib-num">{{libraryDetail.refCount}} out · {{libraryDetail.inboundCount}} in</strong></div>
          <div class="aglib-kv__wide"><span>Foundry UUID</span><code>{{libraryDetail.uuid}}</code></div>
        </div>
        <div class="aglib-refs">
          <div><h4>Uses <span class="aglib-num">({{libraryDetail.refCount}})</span></h4>
            {{#each libraryDetail.outgoing}}<div class="aglib-ref">
              {{#if uuid}}<button type="button" class="aglib-link" data-ag-library-jump="{{uuid}}">{{name}}</button>{{else}}<span class="aglib-missing">Not in this world</span>{{/if}}
              <code>{{targetId}}</code><span class="agmanager-tiny">{{relation}} · {{mode}}</span></div>
            {{else}}<p class="agmanager-tiny">No outgoing typed references.</p>{{/each}}
          </div>
          <div><h4>Used by <span class="aglib-num">({{libraryDetail.inboundCount}})</span></h4>
            {{#each libraryDetail.incoming}}<div class="aglib-ref"><button type="button" class="aglib-link" data-ag-library-jump="{{uuid}}">{{name}}</button>
              <code>{{sourceId}}</code><span class="agmanager-tiny">{{relation}}</span></div>
            {{else}}<p class="agmanager-tiny">No managed records link to this ID.</p>{{/each}}
          </div>
        </div>
        {{#if libraryDetail.editedFields.length}}<div><h4>Local edits <span class="aglib-num">({{libraryDetail.edited}})</span></h4><p class="agmanager-tiny aglib-wrap">{{#each libraryDetail.editedFields}}<code>{{this}}</code> {{/each}}</p><p class="agmanager-tiny">Re-import keeps these. Replace from loaded JSON overwrites them.</p></div>{{/if}}
        <p class="agmanager-tiny aglib-wrap">Source: {{libraryDetail.provenanceSummary}}</p>
        {{else}}
        <div class="ag-empty aglib-empty"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><p class="ag-empty__title">No record chosen</p>
          <p class="ag-empty__text">Choose a record to see its details, references and local edits. Live campaign state stays in its own module.</p></div>
        {{/if}}
        <p class="aglib-status" role="status">{{libraryMessage}}</p>
      </section>
    </div>
    {{/if}}

    {{#if libraryCheckActive}}
    <section class="ag-section aglib-section" aria-label="Check library">
      <div class="ag-section__head"><h3 class="ag-section__title">Check library</h3>
        <button type="button" class="ag-btn" data-ag-action="library-check"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Check library</button></div>
      <p class="agmanager-tiny">Looks for missing references, duplicate IDs and other problems in managed records. Read-only.</p>
      {{#if hasAudit}}<div class="agmanager-audit" aria-label="Library check results">
      {{#each audit}}<div class="agmanager-auditrow agmanager-{{level}}"><span>{{level}}</span> {{message}}</div>{{/each}}
      </div>{{/if}}
      <p class="aglib-status" role="status">{{libraryMessage}}</p>
    </section>
    <section class="ag-section aglib-section" aria-label="Housekeeping report">
      <div class="ag-section__head"><h3 class="ag-section__title">Housekeeping report</h3>
        <button type="button" class="ag-btn" data-ag-action="org-housekeeping"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i> Run report</button></div>
      <p class="agmanager-tiny">Read-only. Lists Ashen Gate ids found more than once (world and all compendiums) and likely temporary records so you can decide. Nothing is changed or deleted. Checks always look at everything; the filters above do not apply.</p>
      {{#if housekeeping.report}}
        <h4>Duplicate ids ({{housekeeping.report.duplicates.length}})</h4>
        {{#if housekeeping.report.hasDuplicates}}<ul>{{#each housekeeping.report.duplicates}}<li><code>{{sourceId}}</code> ×{{count}}: {{#each rows}}{{name}} ({{where}}, {{documentName}}){{#unless @last}}; {{/unless}}{{/each}}</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">None.</p>{{/if}}
        <h4>Likely temporary ({{housekeeping.report.temporary.length}})</h4>
        {{#if housekeeping.report.hasTemporary}}<ul>{{#each housekeeping.report.temporary}}<li>{{name}} {{#if sourceId}}<code>{{sourceId}}</code>{{/if}} — {{where}}, {{why}}</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">None.</p>{{/if}}
        <p class="agmanager-tiny">Draft-status Ashen Gate records: {{housekeeping.report.draftCount}} (normal while content is in development).</p>
      {{/if}}
      {{#if housekeeping.message}}<p class="aglib-status" role="status">{{housekeeping.message}}</p>{{/if}}
    </section>
    {{/if}}

    {{#if libraryExportActive}}
    <section class="ag-section aglib-section agmanager-worldexport" aria-label="Export Ashen Gate data">
      <div class="ag-section__head"><h3 class="ag-section__title">Export Ashen Gate data</h3></div>
      <p class="agmanager-tiny">One JSON file of all Ashen Gate tagged world records plus the other modules' definitions (no play state).</p>
      <div class="aglib-actions">
        <button type="button" class="ag-btn" data-ag-action="world-export-everything"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export everything</button>
        <button type="button" class="ag-btn" data-ag-action="world-backup" data-tooltip="Saves everything as AG_Backup_&lt;date&gt;.json. Does not change what counts as changed since last export." data-tooltip-class="ag-tooltip"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Back up before play</button>
        <details class="aglib-menu">
          <summary class="ag-btn">More <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
          <div class="aglib-menu__pop" role="menu">
            <button type="button" role="menuitem" data-ag-action="world-export-changed"><i class="fa-solid fa-file-circle-exclamation" aria-hidden="true"></i> Export changed since last export</button>
            <button type="button" role="menuitem" data-ag-action="world-export-copy"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy summary</button>
          </div>
        </details>
      </div>
      <p class="agmanager-tiny">Back up before play saves the same file as AG_Backup_&lt;date&gt;.json and does not change what counts as changed since last export.</p>
