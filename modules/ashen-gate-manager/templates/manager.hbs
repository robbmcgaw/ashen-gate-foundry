<section class="agmanager-body ag-window">
  <header class="ag-header agmanager-top">
    <div class="ag-header__title"><h1><i class="agmanager-emblem fa-solid fa-boxes-stacked" aria-hidden="true"></i> <span class="ag-header__brand">Ashen Gate</span> | General Manager</h1></div>
    <div class="ag-header__meta">
      <button type="button" class="ag-btn ag-btn--ghost ag-btn--sm" data-ag-action="appearance-my-appearance"><i class="fa-solid fa-palette" aria-hidden="true"></i> My Appearance</button>
      <span class="ag-gm-flag"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> GM only</span>
      <span class="ag-version">v{{version}}</span>
      <button type="button" class="ag-btn ag-btn--ghost ag-btn--sm" data-ag-action="help"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> Help</button>
    </div>
  </header>
  <nav class="ag-tabs ag-tabs--scroll agmanager-nav" role="tablist" aria-label="General Manager sections">
    <button type="button" role="tab" id="agm-tab-import" aria-controls="agm-pane" aria-selected="{{#if importActive}}true{{else}}false{{/if}}" tabindex="{{#if importActive}}0{{else}}-1{{/if}}" data-ag-tab="import" class="{{#if importActive}}active{{/if}}"><i class="fa-solid fa-file-import" aria-hidden="true"></i> Import</button>
    <button type="button" role="tab" id="agm-tab-items" aria-controls="agm-pane" aria-selected="{{#if itemsActive}}true{{else}}false{{/if}}" tabindex="{{#if itemsActive}}0{{else}}-1{{/if}}" data-ag-tab="items" class="{{#if itemsActive}}active{{/if}}"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> Items</button>
    <button type="button" role="tab" id="agm-tab-codex" aria-controls="agm-pane" aria-selected="{{#if codexActive}}true{{else}}false{{/if}}" tabindex="{{#if codexActive}}0{{else}}-1{{/if}}" data-ag-tab="codex" class="{{#if codexActive}}active{{/if}}"><i class="fa-solid fa-address-book" aria-hidden="true"></i> NPC Codex</button>
    <button type="button" role="tab" id="agm-tab-modules" aria-controls="agm-pane" aria-selected="{{#if modulesActive}}true{{else}}false{{/if}}" tabindex="{{#if modulesActive}}0{{else}}-1{{/if}}" data-ag-tab="modules" class="{{#if modulesActive}}active{{/if}}"><i class="fa-solid fa-grip" aria-hidden="true"></i> Modules</button>
    <button type="button" role="tab" id="agm-tab-scenes" aria-controls="agm-pane" aria-selected="{{#if scenesActive}}true{{else}}false{{/if}}" tabindex="{{#if scenesActive}}0{{else}}-1{{/if}}" data-ag-tab="scenes" class="{{#if scenesActive}}active{{/if}}"><i class="fa-solid fa-cloud-sun" aria-hidden="true"></i> Scenes</button>
    <button type="button" role="tab" id="agm-tab-setup" aria-controls="agm-pane" aria-selected="{{#if setupActive}}true{{else}}false{{/if}}" tabindex="{{#if setupActive}}0{{else}}-1{{/if}}" data-ag-tab="setup" class="ag-tab--gm {{#if setupActive}}active{{/if}}"><i class="fa-solid fa-gears" aria-hidden="true"></i> GM Setup</button>
  </nav>

  <div class="ag-scroll agm-pane" id="agm-pane" role="tabpanel" aria-labelledby="agm-tab-{{tab}}">
  {{#if importActive}}
  {{{importTabsHtml}}}
  <div {{{importPanelAttrs}}} class="agm-subpanel">
  {{#if importPackage}}
  <section class="ag-section agm-sync-switch" aria-label="Sync from package">
    <label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-sync-mode {{#if syncOn}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Sync from package</strong></label>
    <p class="ag-field__hint">Off by default. Replaces content Manager imported earlier with the files you choose: matching records you have not edited are updated (edited ones are kept, and not deleted, unless you tick Also overwrite records I edited), records the files no longer carry are deleted, and a backup and a full preview come first. While it is on, the normal import below is paused. Not the same as <em>Update existing actors</em> or <em>Also apply updates</em>, which keep your edits.</p>
  </section>
  {{{githubHtml}}}
  {{#if syncOn}}{{{syncHtml}}}{{else}}
  <section class="ag-section agm-import" aria-label="Import a package">
    <div class="ag-toolbar agm-import-bar">
      {{{fileButtons.import}}}
      <span class="agm-import-loaded">{{#if hasPackage}}<strong>{{packageId}}</strong> <span class="agmanager-tiny">v{{packageVersion}} · {{recordCount}} record(s)</span>{{else}}<span class="agmanager-tiny">No file loaded</span>{{/if}}</span>
      <div class="ag-toolbar__end">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="reset">Clear</button>
        <button type="button" class="ag-btn" data-ag-action="export" {{#unless hasPackage}}disabled{{/unless}}><i class="fa-solid fa-download" aria-hidden="true"></i> Download report</button>
      </div>
    </div>

    <details class="ag-fold" data-ag-fold="load" {{#if folds.load}}open{{/if}}>
      <summary class="ag-fold__summary"><span class="ag-fold__title">Load</span><span class="ag-fold__hint">{{#if hasPackage}}{{#each typeSummary}}{{name}}: {{count}}{{#unless @last}} · {{/unless}}{{/each}}{{else}}Package details{{/if}}</span></summary>
      <div class="ag-fold__body">
      <dl class="agmanager-package">
        <div><dt>Package</dt><dd>{{packageId}}</dd></div>
        <div><dt>Version</dt><dd>{{packageVersion}}</dd></div>
        <div><dt>Schema</dt><dd>{{schemaVersion}}</dd></div>
        <div><dt>Records</dt><dd>{{recordCount}}</dd></div>
      </dl>
      <p class="agmanager-tiny"><strong>Source:</strong> {{packageSource}}. A Manager package, or a Quest, Skill Tree, Headquarters or Factions file (handed to that module), or a ZIP of them. Scripts in a ZIP never run.</p>
      {{#if hasZipPortraits}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-upload-assets {{#if uploadZipArtwork}}checked{{/if}} {{#if busy}}disabled{{/if}}> Upload matching ZIP portraits into this world's <code>ashen-gate-imports</code> folder before creating documents ({{zipPortraitCount}} images available).</label>{{/if}}
      </div>
    </details>

    {{#if zipBundle}}<details class="ag-fold agmanager-zip-contents" data-ag-fold="zip" {{#if folds.zip}}open{{/if}}>
      <summary class="ag-fold__summary"><span class="ag-fold__title">ZIP files</span><span class="ag-fold__count">{{zipBundle.rows.length}}</span><span class="ag-fold__hint">{{zipBundle.source}} · {{zipBundle.pickedCount}} ticked</span></summary>
      <div class="ag-fold__body">
      <p class="agmanager-tiny">{{zipBundle.summary}} Files import one at a time (Manager packages first), each through its own preview and Apply.</p>
      <div class="ag-table-wrap agm-scrollcap"><table class="ag-table"><thead><tr><th scope="col">Import</th><th scope="col">File</th><th scope="col">Type</th><th scope="col" class="is-num">Records</th><th scope="col">Status</th></tr></thead><tbody>
      {{#each zipBundle.rows}}<tr class="{{#if isCurrent}}is-selected{{/if}}">
        <td><input type="checkbox" data-ag-zip-pick="{{filename}}" {{#if picked}}{{#unless isError}}checked{{/unless}}{{/if}} {{#unless canPick}}disabled{{else}}{{#if @root.busy}}disabled{{/if}}{{/unless}} aria-label="Import {{filename}}" /></td>
        <td><code>{{filename}}</code></td><td>{{label}}</td><td class="is-num">{{count}}</td>
        <td>{{status}}{{#if notice}}<div class="agmanager-tiny">{{notice}}</div>{{/if}}</td></tr>{{/each}}
      {{#each zipBundle.skipped}}<tr><td></td><td><code>{{filename}}</code></td><td>Skipped</td><td class="is-num">—</td><td class="agmanager-tiny">{{reason}}</td></tr>{{/each}}
      </tbody></table></div>
      <label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-zip-auto {{#if zipBundle.auto}}checked{{/if}} {{#if zipBundle.autoLocked}}disabled{{/if}}> <strong>Import everything without stopping</strong></label>
      <p class="ag-field__hint">Each ticked file is previewed in order and its new records and metadata refreshes are imported without asking you to confirm. Your Options (profile, update and icon settings) still apply. It stops only when a file has errors or an import fails.</p>
      <label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-zip-auto-updates {{#if zipBundle.autoUpdates}}checked{{/if}} {{#unless zipBundle.auto}}disabled{{else}}{{#if zipBundle.autoLocked}}disabled{{/if}}{{/unless}}> <strong>Also apply updates to records that already exist</strong></label>
      <p class="ag-field__hint">Only updates your Options allow are offered. Manager downloads its usual backup of the changed documents before writing. When this is off, those records are left as they are and listed as Needs your decision.</p>
      </div>
    </details>
    {{#if zipBundle.progress}}<p class="ag-notice ag-notice--info" role="status" aria-live="polite" data-ag-zip-progress><i class="fa-solid fa-list-check" aria-hidden="true"></i> {{#if zipBundle.stopping}}Stopping after the current file…{{else}}{{zipBundle.progress}}{{/if}}</p>{{/if}}
    {{#if zipBundle.hasAutoSummary}}<section class="ag-section agmanager-zip-summary" aria-label="ZIP import summary">
      <div class="ag-table-wrap agm-scrollcap"><table class="ag-table"><caption class="agmanager-tiny">ZIP import summary</caption><thead><tr><th scope="col">File</th><th scope="col">Result</th><th scope="col" class="is-num">Created</th><th scope="col" class="is-num">Updated</th><th scope="col" class="is-num">Unchanged</th><th scope="col" class="is-num">Needs your decision</th><th scope="col" class="is-num">Skipped</th><th scope="col" class="is-num">Failed</th></tr></thead><tbody>
      {{#each zipBundle.summaryRows}}<tr><td><code>{{filename}}</code><div class="agmanager-tiny">{{label}}</div></td><td><span class="ag-badge{{#if tone}} ag-badge--{{tone}}{{/if}}">{{status}}</span>{{#if note}}<div class="agmanager-tiny">{{note}}</div>{{/if}}</td>
        {{#if hasCounts}}<td class="is-num">{{counts.created}}</td><td class="is-num">{{counts.updated}}</td><td class="is-num">{{counts.unchanged}}</td><td class="is-num">{{counts.needsDecision}}</td><td class="is-num">{{counts.skipped}}</td><td class="is-num">{{counts.failed}}</td>
        {{else}}<td class="is-num">—</td><td class="is-num">—</td><td class="is-num">—</td><td class="is-num">—</td><td class="is-num">—</td><td class="is-num">—</td>{{/if}}</tr>{{/each}}
      </tbody></table></div>
      {{#if zipBundle.hasDecisions}}<div class="ag-notice ag-notice--warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><div><strong>Needs your decision</strong> (already in your world and not changed; import the file again without auto mode to choose)<ul>{{#each zipBundle.decisions}}<li><code>{{filename}}</code>: {{names}}</li>{{/each}}</ul></div></div>{{/if}}
    </section>{{/if}}
    <div class="ag-cluster">
      {{#if zipBundle.autoMode}}<button type="button" class="ag-btn ag-btn--ghost" data-ag-zip-stop {{#if zipBundle.stopping}}disabled{{/if}}>Stop ZIP import</button>{{#if zipBundle.paused}}<button type="button" class="ag-btn" data-ag-action="zip-skip">Skip this file</button>{{/if}}
      {{else}}{{#if zipBundle.running}}<button type="button" class="ag-btn ag-btn--ghost" data-ag-action="zip-cancel">Stop ZIP import</button><button type="button" class="ag-btn" data-ag-action="zip-skip">Skip this file</button>
      {{else}}<button type="button" class="ag-btn" data-ag-action="zip-start" {{#unless zipBundle.pickedCount}}disabled{{/unless}}><i class="fa-solid fa-list-check" aria-hidden="true"></i> Import selected files ({{zipBundle.pickedCount}})</button>{{/if}}{{/if}}
    </div>{{/if}}

    <details class="ag-fold" data-ag-fold="options" {{#if folds.options}}open{{/if}}>
      <summary class="ag-fold__summary"><span class="ag-fold__title">Options</span><span class="ag-fold__hint">{{optionsSummary}}</span></summary>
      <div class="ag-fold__body">
      <label class="ag-field agm-profile">Import profile
        <select data-ag-profile {{#if busy}}disabled{{/if}}>
          <option value="development" {{#if developmentProfile}}selected{{/if}}>Development: include draft, proposed and example records</option>
          <option value="session-safe" {{#if sessionProfile}}selected{{/if}}>Session-safe: approved records only</option>
        </select>
        <span class="ag-field__hint">Changes what the preview offers; nothing is applied until Import.</span>
      </label>
      {{#if isSpecialist}}{{#if specialistCanUpdate}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Update existing {{specialistNoun}}</strong> (otherwise ones already in the world are kept as they are)</label>{{else}}<p class="agmanager-tiny">{{specialistLabel}} keeps {{specialistNoun}} that are already in the world; this file only adds new ones.</p>{{/if}}
      {{else}}{{#if hasLocationRecords}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Update existing locations, routes and shops</strong> (discovery, reveal and journey state, and shop stock, coins and sales are always kept)</label>{{/if}}
      {{#if hasActorRecords}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-update-actors {{#if updateActors}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Update existing actors</strong> (name, image, token settings and package items only; HP, XP, level, conditions, player items, notes, ownership, folders and other modules' data are always kept)</label>{{/if}}
      <label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-smart-icons {{#if smartIcons}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Choose icons for records without one</strong> (from Foundry's icon library; icons in the file are always kept)</label>
      {{#if smartIcons}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-repick-icons {{#if repickIcons}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Re-pick smart icons</strong> on records imported before (only icons Manager chose; icons you set in Foundry are never changed)</label>{{/if}}
      <p class="agmanager-tiny" role="status" data-ag-icon-status>{{iconStatus}}</p>{{/if}}
      </div>
    </details>

    <div class="ag-cluster agm-import-actions">
      <button type="button" class="ag-btn" data-ag-action="preview" {{#unless hasPackage}}disabled{{/unless}}><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Validate &amp; Preview</button>
      <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="select" {{#unless hasPreview}}disabled{{/unless}}>Select eligible</button>
      <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="clear" {{#unless hasPreview}}disabled{{/unless}}>Deselect all</button>
    </div>
    <p class="ag-notice ag-notice--info" role="status"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{message}}</p>
  </section>

  {{#if hasPreview}}
  <section class="ag-section agmanager-results" aria-label="Import preview">
    <details class="ag-fold" data-ag-fold="preview" {{#if folds.preview}}open{{/if}}>
      <summary class="ag-fold__summary"><span class="ag-fold__title">Preview</span><span class="ag-fold__count">{{rows.length}}</span><span class="ag-fold__hint">{{selectedCount}} ticked</span></summary>
      <div class="ag-fold__body">
      <div class="ag-cluster agmanager-summary">
        <span class="ag-badge ag-badge--ok"><strong>{{summary.create}}</strong> new</span>
        <span class="ag-badge ag-badge--ok"><strong>{{summary.update}}</strong> update</span>
        {{#if summary.rebind}}<span class="ag-badge ag-badge--ok"><strong>{{summary.rebind}}</strong> replace in place</span>{{/if}}
        <span class="ag-badge ag-badge--ok"><strong>{{summary.metadata}}</strong> metadata refresh</span>
        {{#if summary.icon}}<span class="ag-badge ag-badge--ok"><strong>{{summary.icon}}</strong> icon only</span>{{/if}}
        <span class="ag-badge"><strong>{{summary.unchanged}}</strong> unchanged</span>
        <span class="ag-badge ag-badge--danger"><strong>{{summary.conflict}}</strong> conflict</span>
        <span class="ag-badge ag-badge--danger"><strong>{{summary.blocked}}</strong> blocked</span>
        <span class="ag-badge"><strong>{{summary.skipped}}</strong> excluded</span>
        <span class="ag-badge"><strong>{{summary.local}}</strong> local edits</span>
      </div>
      <div class="ag-table-wrap agm-scrollcap agm-preview-table">
      <table class="ag-table">
        <thead><tr><th scope="col">Apply?</th><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Reason</th>{{#if hasIconRows}}<th scope="col">Icon</th>{{/if}}</tr></thead>
        <tbody>
        {{#each rows}}
        <tr>
          <td><input type="checkbox" data-ag-select="{{id}}" {{#if selected}}checked{{/if}} {{#unless canSelect}}disabled{{else}}{{#if @root.busy}}disabled{{/if}}{{/unless}} aria-label="Select {{name}}" /></td>
          <td><strong>{{name}}</strong><details class="agm-tech" data-ag-technical><summary>Details</summary><code class="agm-id">{{id}}</code> <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-copy-id="{{id}}" aria-label="Copy id for {{name}}"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></details></td>
          <td>{{kind}}{{#if detail}}<div class="agmanager-tiny">{{detail}}</div>{{/if}}{{#if folderNote}}<div class="agmanager-tiny">Folder: {{folderNote}}</div>{{/if}}<div class="agmanager-tiny">{{lifecycle}}</div></td>
          <td><span class="ag-badge{{#if badgeTone}} ag-badge--{{badgeTone}}{{/if}}">{{badge}}</span></td>
          <td>{{reason}}{{#if supersede}}<fieldset class="agm-supersede"><legend>Replaces {{supersede.oldName}}?</legend><div class="ag-cluster">
            <label class="ag-field--inline"><input type="radio" name="supersede-{{id}}" value="yes" data-ag-supersede="{{id}}" {{#if supersede.yes}}checked{{/if}} {{#unless supersede.canChoose}}disabled{{/unless}} {{#if @root.busy}}disabled{{/if}}> Yes, replace it</label>
            <label class="ag-field--inline"><input type="radio" name="supersede-{{id}}" value="no" data-ag-supersede="{{id}}" {{#if supersede.no}}checked{{/if}} {{#unless supersede.canChoose}}disabled{{/unless}} {{#if @root.busy}}disabled{{/if}}> No, add separately</label>
            <label class="ag-field--inline"><input type="radio" name="supersede-{{id}}" value="skip" data-ag-supersede="{{id}}" {{#if supersede.skip}}checked{{/if}} {{#unless supersede.canChoose}}disabled{{/unless}} {{#if @root.busy}}disabled{{/if}}> Skip</label></div></fieldset>{{/if}}{{#if changes.length}}<ul class="agmanager-changes">{{#each changes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{#if effectRows.length}}<ul class="agmanager-changes agmanager-effects" aria-label="Effects">{{#each effectRows}}<li><strong>{{label}}</strong> {{name}}: {{reason}}</li>{{/each}}</ul>{{/if}}</td>
          {{#if @root.hasIconRows}}<td class="agm-icon-cell">{{#if icon}}<div class="agm-icon">
            {{#if icon.thumb}}<img class="agm-icon__thumb" src="{{icon.img}}" alt="" loading="lazy" decoding="async" width="32" height="32">{{else}}<span class="agm-icon__thumb" aria-hidden="true"></span>{{/if}}
            <div class="agm-icon__text"><span class="ag-badge{{#if icon.pending}} ag-badge--warn{{/if}}">{{icon.label}}</span> <code class="agm-icon__path">{{icon.img}}</code><div class="agmanager-tiny">{{icon.note}}</div></div>
            <div class="agm-icon__actions"><button type="button" class="ag-btn ag-btn--sm" data-ag-icon-change="{{id}}" {{#if @root.busy}}disabled{{/if}} aria-label="Change icon for {{name}}…">Change…</button>
            {{#if icon.changed}}<button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-icon-reset="{{id}}" {{#if @root.busy}}disabled{{/if}} aria-label="Use the suggested icon for {{name}}">Use suggestion</button>{{/if}}</div>
          </div>{{/if}}</td>{{/if}}
        </tr>
        {{/each}}
        </tbody>
      </table>
      </div>
      <p class="agmanager-tiny">Existing Actors change only with <strong>Update existing actors</strong> ticked; character progress is never overwritten. Back up your world first.</p>
      {{#if actorUpdateCount}}<div class="ag-cluster"><button type="button" class="ag-btn" data-ag-action="backup-actors"><i class="fa-solid fa-download" aria-hidden="true"></i> Download backup of {{actorUpdateCount}} actor(s) to update</button></div>{{/if}}
      </div>
    </details>
    <footer class="ag-footer agmanager-footer">
      <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="reset">Cancel</button>
      <button type="button" class="ag-btn ag-btn--primary" data-ag-action="apply" {{#unless canApply}}disabled{{/unless}}><i class="fa-solid fa-check" aria-hidden="true"></i> Import ({{selectedCount}})</button>
    </footer>
  </section>
  {{/if}}
  {{/if}}
  {{/if}}

  {{#if importHistory}}
  <section class="ag-section" aria-label="Import history">
    <p class="agmanager-tiny">A log of applied imports, not an undo. Updates download a snapshot first; keep a Foundry world backup too.</p>
    {{#if hasHistory}}
      {{#each history}}
      <details class="ag-card ag-card--compact agmanager-history">
        <summary><strong>{{packageId}}</strong> · v{{packageVersion}} · {{at}} · {{results.length}} record(s){{#if failed}} <span class="ag-badge ag-badge--danger">{{failed}} failed</span>{{/if}}</summary>
        <ul class="ag-rows agmanager-history-records">
        {{#each results}}
          <li class="ag-row"><span class="ag-badge{{#if tone}} ag-badge--{{tone}}{{/if}}">{{status}}</span><span class="ag-row__main"><span class="ag-row__title">{{#if name}}{{name}}: {{/if}}{{action}}</span>{{#if message}}<span class="ag-row__meta">{{message}}</span>{{/if}}{{#if id}}<span class="ag-row__meta"><details class="agm-tech" data-ag-technical><summary>Details</summary><code class="agm-id">{{id}}</code> <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-copy-id="{{id}}" aria-label="Copy id for this record"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></details></span>{{/if}}</span></li>
        {{/each}}
        </ul>
      </details>
      {{/each}}
    {{else}}<div class="ag-empty"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><p class="ag-empty__title">No imports yet</p><p class="ag-empty__text">Imports you apply on the Import tab are listed here.</p></div>{{/if}}
  </section>
  {{/if}}
  </div>
  {{/if}}

  {{#if itemsActive}}
  <div class="agitems">
    {{{itemsTabsHtml}}}
    <div {{{itemsPanelAttrs}}} class="agm-subpanel agitems-panel">
    {{#if itemsFilters}}
    <div class="ag-toolbar agitems-filters" role="search" aria-label="Item filters">
      <label class="ag-search agitems-query"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-items-query value="{{itemFilters.query}}" placeholder="Search items" aria-label="Search items" aria-describedby="agitems-query-help" /></label>
      <span id="agitems-query-help" class="ag-sr-only">Words match name, id, tags and text. Prefixes: id:, type:, tag:, status:, tier:.</span>
      <button type="button" class="ag-btn ag-btn--sm" data-ag-items-filters-toggle aria-expanded="{{#if itemFiltersOpen}}true{{else}}false{{/if}}" aria-controls="agitems-filterrow"><i class="fa-solid fa-filter" aria-hidden="true"></i> Filters (<span data-ag-items-filter-count>{{itemFilters.panelCount}}</span>)</button>
      {{#if itemsAll}}<span class="ag-toolbar__filters" data-ag-browse-tools></span>{{/if}}
      <div class="ag-toolbar__end">
        <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-items-clear {{#unless itemFilters.active}}disabled{{/unless}}><span>Clear filters (<span data-ag-items-clear-count>{{itemFilters.active}}</span>)</span></button>
        <button type="button" class="ag-btn ag-btn--sm" data-ag-items-packs><i class="fa-solid fa-book-atlas" aria-hidden="true"></i> <span data-ag-items-packs-label>{{itemFilters.packsLabel}}</span></button>
      </div>
    </div>
    <div id="agitems-filterrow" class="agitems-filterrow" data-ag-items-filterrow {{#unless itemFiltersOpen}}hidden{{/unless}}>
      <div class="agitems-filtergrid">
        <label class="ag-field">Source <select data-ag-items-filter="source">{{#each itemFilters.sources}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="ag-field">Type <select data-ag-items-filter="type">{{#each itemFilters.types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="ag-field">Origin <select data-ag-items-filter="origin">{{#each itemFilters.origins}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="ag-field">Rarity <select data-ag-items-filter="rarity">{{#each itemFilters.rarities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="ag-field">Folder <select data-ag-items-filter="folder">{{#each itemFilters.folders}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="ag-field--inline agitems-check"><input type="checkbox" data-ag-items-coreref {{#if itemFilters.coreRef}}checked{{/if}}> Has core_ref</label>
      </div>
      {{#if itemsAll}}<div data-ag-browse-facets></div>{{/if}}
    </div>
    {{#if itemFilters.packsNote}}<p class="agmanager-tiny agitems-note">{{itemFilters.packsNote}}</p>{{/if}}
    {{/if}}
    {{#if itemsAll}}
    <div class="agbrowse" data-ag-browse></div>
    {{/if}}
    {{#if libraryRecordsActive}}
    <div class="ag-split aglib-split">
      <section class="ag-split__list aglib-list" aria-label="Managed records">
        <div class="aglib-tools">
          <div class="ag-chip-group" role="group" aria-label="System">
            {{#each librarySystemChips}}<button type="button" class="ag-chip" data-ag-library-system-chip="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{label}} <span class="aglib-num">{{count}}</span></button>{{/each}}
          </div>
          <details class="aglib-filters" {{#if libraryHasFilters}}open{{/if}}>
            <summary>More filters{{#if libraryHasFilters}} <span class="ag-badge ag-badge--accent">{{libraryFilterCount}}</span>{{/if}}</summary>
            <div class="aglib-filter-grid">
              <label>Status <select data-ag-library-status>{{#each libraryStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
              <label>Package <select data-ag-library-package>{{#each libraryPackageOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
              <label class="ag-field--inline aglib-check"><input type="checkbox" data-ag-library-show-archived {{#if libraryShowArchived}}checked{{/if}}> Show archived</label>
            </div>
          </details>
          {{#if libraryNarrowed}}<p class="agmanager-tiny">The filters above leave {{libraryInScope}} of {{libraryTotal}} records.</p>{{/if}}
          <div class="aglib-count"><span>{{libraryFilteredCount}} of {{libraryTotal}} records</span><span>{{libraryEditedCount}} edited · {{libraryActiveCount}} active</span></div>
        </div>
        <div class="aglib-rows">
          {{#each libraryGroups}}
          <div class="aglib-group"><span>{{label}}</span><span class="aglib-num">{{count}}</span></div>
          {{#each rows}}<div class="aglib-row {{#if focused}}is-focused{{/if}}">
            <input type="checkbox" data-ag-library-select="{{uuid}}" {{#if selected}}checked{{/if}} aria-label="Select {{name}}" />
            <button type="button" class="aglib-row__main" data-ag-library-inspect="{{uuid}}" {{#if focused}}aria-current="true"{{/if}}{{{tooltip}}}>
              <span class="aglib-row__name">{{name}}</span>
              <span class="aglib-row__meta"><span class="ag-badge{{#if statusTone}} ag-badge--{{statusTone}}{{/if}}">{{statusLabel}}</span>{{#if archived}}<span class="ag-badge ag-badge--danger">archived</span>{{/if}}{{#if version}}<span class="ag-badge">v{{version}}</span>{{/if}}{{#if edited}}<span class="ag-badge ag-badge--warn">{{edited}} edit(s)</span>{{/if}}</span>
            </button>
          </div>{{/each}}
          {{else}}{{#if libraryTotal}}<div class="ag-empty aglib-empty"><p class="ag-empty__title">Nothing matches</p><p class="ag-empty__text">Clear the search or filters.</p></div>{{else}}<div class="ag-empty aglib-empty"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><p class="ag-empty__title">No Ashen Gate records yet</p><p class="ag-empty__text">Import an Ashen Gate package on the Import tab. Items from D&amp;D Beyond, Plutonium or compendiums are under Browse.</p></div>{{/if}}{{/each}}
        </div>
        <div class="aglib-selbar">
          {{#if hasLibrarySelected}}<strong class="aglib-num">{{librarySelectedCount}} selected</strong>
          <details class="aglib-menu">
            <summary class="ag-btn ag-btn--sm">Actions <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
            <div class="aglib-menu__pop">
              <button type="button" data-ag-action="library-export"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export selected / local edits…</button>
              <button type="button" data-ag-action="library-replace"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Replace from loaded JSON…</button>
              <button type="button" data-ag-action="library-stage"><i class="fa-solid fa-box-archive" aria-hidden="true"></i> Copy to staging compendium…</button>
              <hr>
              <button type="button" data-ag-action="library-archive"><i class="fa-solid fa-folder-minus" aria-hidden="true"></i> Archive</button>
              <button type="button" data-ag-action="library-restore"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i> Restore</button>
              <hr>
              <button type="button" data-ag-action="library-delete" class="aglib-danger"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete archived…</button>
            </div>
          </details>
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="library-clear">Clear</button>
          {{else}}<span class="agmanager-tiny">Tick records to act on them.</span>{{/if}}
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost aglib-end" data-ag-action="library-select-visible">Select shown</button>
        </div>
        <div class="aglib-pager">
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost ag-btn--icon" data-ag-action="library-previous" aria-label="Previous page" data-tooltip="Previous page" data-tooltip-class="ag-tooltip" {{#unless libraryHasPrevious}}disabled{{/unless}}><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
          <span class="aglib-num">{{libraryPageLabel}}</span>
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost ag-btn--icon" data-ag-action="library-next" aria-label="Next page" data-tooltip="Next page" data-tooltip-class="ag-tooltip" {{#unless libraryHasNext}}disabled{{/unless}}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
        </div>
      </section>
      <section class="ag-split__detail aglib-detail" aria-label="Selected record details">
        {{#if libraryHasDetail}}
        <div class="aglib-detail__head">
          <div class="aglib-detail__title"><h3>{{libraryDetail.name}}</h3>
            <div class="aglib-row__meta"><span class="ag-badge{{#if libraryDetail.statusTone}} ag-badge--{{libraryDetail.statusTone}}{{/if}}">{{libraryDetail.statusLabel}}</span><span class="ag-badge">{{libraryDetail.kind}} · {{libraryDetail.entityLabel}}</span>{{#if libraryDetail.archived}}<span class="ag-badge ag-badge--danger">archived</span>{{/if}}{{#if libraryDetail.edited}}<span class="ag-badge ag-badge--warn">{{libraryDetail.edited}} local edit(s)</span>{{/if}}</div>
          </div>
          <button type="button" class="ag-btn" data-ag-library-open="{{libraryDetail.uuid}}"><i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Open sheet</button>
          <button type="button" class="ag-btn ag-btn--ghost ag-btn--icon" data-ag-action="library-inspect-clear" aria-label="Close details" data-tooltip="Close details" data-tooltip-class="ag-tooltip"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        {{#if libraryDetail.isItem}}<div class="agpreview" data-ag-item-preview="{{libraryDetail.uuid}}" aria-live="polite"><p class="agmanager-tiny">Loading item card…</p></div>{{/if}}
        <dl class="ag-kv aglib-kv">
          <dt>System</dt><dd>{{libraryDetail.systemLabel}}</dd>
          <dt>Version</dt><dd>{{libraryDetail.version}}</dd>
          <dt>Package</dt><dd>{{libraryDetail.packageId}}</dd>
          <dt>Visibility</dt><dd>{{libraryDetail.visibilityLabel}}</dd>
          <dt>Scope</dt><dd>{{libraryDetail.scopeLabel}}</dd>
          <dt>References</dt><dd>{{libraryDetail.refCount}} out · {{libraryDetail.inboundCount}} in</dd>
          <dt>Technical</dt><dd><details class="agm-tech" data-ag-technical><summary>Details</summary><div><span class="agmanager-tiny">Record id</span> <code class="agm-id">{{libraryDetail.sourceId}}</code> <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-copy-id="{{libraryDetail.sourceId}}" aria-label="Copy id for {{libraryDetail.name}}"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></div><div><span class="agmanager-tiny">Foundry UUID</span> <code class="agm-id">{{libraryDetail.uuid}}</code></div></details></dd>
        </dl>
        <div class="aglib-refs">
          <div><h4>Uses <span class="aglib-num">({{libraryDetail.refCount}})</span></h4>
            {{#each libraryDetail.outgoing}}<div class="aglib-ref">
              {{#if uuid}}<button type="button" class="ag-link" data-ag-library-jump="{{uuid}}">{{name}}</button>{{else}}<span class="aglib-missing">Not in this world</span>{{/if}}
              <span class="agmanager-tiny">{{relationLabel}} · {{modeLabel}}</span></div>
            {{else}}<p class="agmanager-tiny">No outgoing typed references.</p>{{/each}}
          </div>
          <div><h4>Used by <span class="aglib-num">({{libraryDetail.inboundCount}})</span></h4>
            {{#each libraryDetail.incoming}}<div class="aglib-ref"><button type="button" class="ag-link" data-ag-library-jump="{{uuid}}">{{name}}</button>
              <span class="agmanager-tiny">{{relationLabel}}</span></div>
            {{else}}<p class="agmanager-tiny">No managed records link to this one.</p>{{/each}}
          </div>
        </div>
        {{#if libraryDetail.editedFields.length}}<div><h4>Local edits <span class="aglib-num">({{libraryDetail.edited}})</span></h4><p class="agmanager-tiny aglib-wrap">{{#each libraryDetail.editedFields}}<code>{{this}}</code> {{/each}}</p><p class="agmanager-tiny">Re-import keeps these. Replace from loaded JSON overwrites them.</p></div>{{/if}}
        <p class="agmanager-tiny aglib-wrap">Source: {{libraryDetail.provenanceSummary}}</p>
        {{else}}
        <div class="ag-empty aglib-empty"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><p class="ag-empty__title">No record chosen</p>
          <p class="ag-empty__text">Choose a record to see its details, references and local edits.</p></div>
        {{/if}}
        <p class="aglib-status" role="status">{{libraryMessage}}</p>
      </section>
    </div>
    {{/if}}

    {{#if libraryCheckActive}}
    <section class="ag-section aglib-section" aria-label="Check library">
      <div class="ag-section__head"><h3 class="ag-section__title">Check library</h3>
        <button type="button" class="ag-btn" data-ag-action="library-check"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Check library</button></div>
      <p class="agmanager-tiny">Read-only: missing references, duplicate IDs and other problems in managed records.</p>
      {{#if hasAudit}}<ul class="ag-rows agmanager-audit agm-scrollcap" aria-label="Library check results">
      {{#each audit}}<li class="ag-row"><span class="ag-badge{{#if tone}} ag-badge--{{tone}}{{/if}}">{{level}}</span><span class="ag-row__main"><span class="ag-row__meta">{{message}}</span></span></li>{{/each}}
      </ul>{{/if}}
      <p class="aglib-status" role="status">{{libraryMessage}}</p>
    </section>
    <section class="ag-section aglib-section" aria-label="Housekeeping report">
      <div class="ag-section__head"><h3 class="ag-section__title">Housekeeping report</h3>
        <button type="button" class="ag-btn" data-ag-action="org-housekeeping"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i> Run report</button></div>
      <p class="agmanager-tiny">Read-only: Ashen Gate records found more than once (world and all compendiums) and likely temporary records. Nothing is changed or deleted.</p>
      {{#if housekeeping.report}}
        <h4>Duplicate records ({{housekeeping.report.duplicates.length}})</h4>
        {{#if housekeeping.report.hasDuplicates}}<ul>{{#each housekeeping.report.duplicates}}<li>{{#each rows}}{{name}} ({{where}}, {{documentName}}){{#unless @last}}; {{/unless}}{{/each}} — {{count}} copies. <details class="agm-tech" data-ag-technical><summary>Details</summary><code class="agm-id">{{sourceId}}</code> <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-copy-id="{{sourceId}}" aria-label="Copy id for these records"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></details></li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">None.</p>{{/if}}
        <h4>Likely temporary ({{housekeeping.report.temporary.length}})</h4>
        {{#if housekeeping.report.hasTemporary}}<ul>{{#each housekeeping.report.temporary}}<li>{{name}} — {{where}}, {{why}}{{#if sourceId}} <details class="agm-tech" data-ag-technical><summary>Details</summary><code class="agm-id">{{sourceId}}</code> <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-copy-id="{{sourceId}}" aria-label="Copy id for {{name}}"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy id</button></details>{{/if}}</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">None.</p>{{/if}}
        <p class="agmanager-tiny">Draft-status Ashen Gate records: {{housekeeping.report.draftCount}} (normal while content is in development).</p>
      {{/if}}
      {{#if housekeeping.message}}<p class="aglib-status" role="status">{{housekeeping.message}}</p>{{/if}}
    </section>
    <section class="ag-section aglib-section agrelease" aria-label="Release player-visible records">
      <div class="ag-section__head"><h3 class="ag-section__title">Release player-visible records</h3>
        <button type="button" class="ag-btn" data-ag-action="release-scan" {{#if release.running}}disabled{{/if}}><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Find hidden player-visible records</button></div>
      <p class="agmanager-tiny">Records imported before 0.55.0 were created hidden from players, so Profession Ledger and other modules call their materials, recipes and handouts "Unreleased". This lists approved records marked player-visible whose world document players cannot read, and makes them readable (default ownership Observer). Records marked GM-only or revealed later, drafts, and anything you set yourself are never touched. Nothing changes until Apply.</p>
      <p class="agmanager-tiny" role="status" data-ag-release-status>{{release.message}}</p>
      {{#if release.running}}<div class="ag-cluster agclean-running" aria-label="Release progress">
        <progress class="agclean-bar" data-ag-release-bar max="1" value="{{release.pct}}" aria-label="Records released"></progress>
        <button type="button" class="ag-btn ag-btn--danger" data-ag-release-stop><i class="fa-solid fa-stop" aria-hidden="true"></i> Cancel release</button>
        <span class="agmanager-tiny">Stops after the current chunk of 50; what was released stays released.</span>
      </div>{{/if}}
      {{#if release.scan}}
      <div class="ag-cluster">
        <span class="ag-badge">To release: {{release.total}}</span>
        {{#each release.kinds}}<span class="ag-badge">{{label}}: {{count}}</span>{{/each}}
        <span class="ag-badge">Already visible: {{release.alreadyReleased}}</span>
      </div>
      {{#if release.examples.length}}<ul class="agmanager-tiny">{{#each release.examples}}<li>{{name}} <span class="ag-badge">{{kind}}</span></li>{{/each}}</ul>
      {{#if release.more}}<p class="agmanager-tiny">and {{release.more}} more.</p>{{/if}}{{/if}}
      <footer class="ag-footer">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="release-cancel" {{#if release.running}}disabled{{/if}}>Cancel</button>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="release-commit" {{#unless release.total}}disabled{{/unless}}{{#if release.running}} disabled{{/if}}><i class="fa-solid fa-eye" aria-hidden="true"></i> Release {{release.total}} record(s)…</button>
      </footer>
      {{/if}}
    </section>
    <section class="ag-section aglib-section agicons" aria-label="Improve icons">
      <div class="ag-section__head"><h3 class="ag-section__title">Improve icons</h3>
        <button type="button" class="ag-btn" data-ag-action="icons-scan"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Find placeholder icons</button></div>
      <p class="agmanager-tiny">Lists world Items and Actors whose icon is a placeholder (blank, Foundry's bag or mystery man, dnd5e's default art or Manager's generic icons) and suggests one from Foundry's icon library. Icons you set or that came from a file are never listed. Nothing changes until Apply.</p>
      <p class="agmanager-tiny" role="status" data-ag-icons-status>{{icons.message}}</p>
      {{#if icons.status}}<p class="agmanager-tiny">{{icons.status}} <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="icons-reindex">Rebuild icon index</button></p>{{/if}}
      {{#if icons.running}}<div class="ag-cluster agclean-running" aria-label="Icon change progress">
        <progress class="agclean-bar" data-ag-icons-bar max="1" value="{{icons.pct}}" aria-label="Icons changed"></progress>
        <button type="button" class="ag-btn ag-btn--danger" data-ag-icons-stop><i class="fa-solid fa-stop" aria-hidden="true"></i> Cancel</button>
        <span class="agmanager-tiny">Stops after the current chunk of 50; what changed stays changed and is in Undo.</span>
      </div>{{/if}}
      {{#if icons.scan}}
      <div class="ag-cluster"><span class="ag-badge">Placeholder icons: {{icons.count}}</span><span class="ag-badge">Ticked: <span data-ag-icons-count>{{icons.ticked}}</span></span></div>
      {{#each icons.groups}}
      <h4>{{label}} ({{rows.length}})</h4>
      <div class="ag-table-wrap agm-scrollcap"><table class="ag-table"><thead><tr><th scope="col">Change</th><th scope="col">Document</th><th scope="col">Now</th><th scope="col">Suggested icon</th></tr></thead><tbody>
      {{#each rows}}<tr>
        <td><input type="checkbox" data-ag-icons-tick="{{uuid}}" {{#if checked}}checked{{/if}} {{#if noPick}}disabled{{/if}} aria-label="Change the icon of {{name}}"></td>
        <td><strong>{{name}}</strong><div class="agmanager-tiny">{{kindLabel}}{{#if playerOwned}} · player character{{/if}}</div></td>
        <td><code class="agm-icon__path">{{from}}</code></td>
        <td><div class="agm-icon">
          {{#if img}}{{#if thumb}}<img class="agm-icon__thumb" src="{{img}}" alt="" loading="lazy" decoding="async" width="32" height="32">{{else}}<span class="agm-icon__thumb" aria-hidden="true"></span>{{/if}}{{else}}<span class="agm-icon__thumb" aria-hidden="true"></span>{{/if}}
          <div class="agm-icon__text">{{#if label}}<span class="ag-badge">{{label}}</span> {{/if}}{{#if img}}<code class="agm-icon__path">{{img}}</code>{{/if}}<div class="agmanager-tiny">{{reasonText}}</div></div>
          <div class="agm-icon__actions"><button type="button" class="ag-btn ag-btn--sm" data-ag-icons-change="{{uuid}}" aria-label="Change icon for {{name}}…">Change…</button></div>
        </div></td>
      </tr>{{/each}}
      </tbody></table></div>
      {{/each}}
      <footer class="ag-footer">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="icons-cancel" {{#if icons.running}}disabled{{/if}}>Cancel</button>
        <span class="ag-btn-group">
          <button type="button" class="ag-btn" data-ag-action="icons-backup" data-ag-icons-needs-ticks {{#unless icons.ticked}}disabled{{/unless}}><i class="fa-solid fa-download" aria-hidden="true"></i> Download backup</button>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-action="icons-apply" data-ag-icons-needs-ticks {{#unless icons.ticked}}disabled{{/unless}}{{#if icons.running}} disabled{{/if}}><i class="fa-solid fa-image" aria-hidden="true"></i> Apply (<span data-ag-icons-count>{{icons.ticked}}</span>)…</button>
        </span>
      </footer>
      {{/if}}
      {{#if icons.hasUndo}}<div class="ag-cluster"><button type="button" class="ag-btn ag-btn--ghost" data-ag-action="icons-undo" {{#if icons.running}}disabled{{/if}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Undo last icon change ({{icons.undoCount}})…</button></div>{{/if}}
    </section>
    {{/if}}

    {{#if assetsActive}}
    <div class="agassets" data-ag-assets>
    <section class="ag-section aglib-section" aria-label="Asset library">
      <div class="ag-section__head"><h3 class="ag-section__title">Asset library</h3>
        <div class="ag-cluster">
          {{#if assets.multiSource}}<label class="ag-field--inline">Source <select data-ag-assets-source {{#if assets.uploading}}disabled{{/if}}>{{#each assets.sources}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          <button type="button" class="ag-btn ag-btn--sm" data-ag-assets-refresh {{#if assets.uploading}}disabled{{/if}}><i class="fa-solid fa-rotate" aria-hidden="true"></i> Refresh</button>
        </div></div>
      <p class="agmanager-tiny">Browse and add art files. {{#if assets.onForge}}On The Forge this is your Assets Library; pick Foundry data folder to look at the world's own files instead.{{else}}This is the Foundry data folder.{{/if}} Drop several images on the bar below (Cinder stage art such as Echo_Cinder_Stage_1.webp is grouped per Cinder): after they are added, Manager looks for records they fit (a file named after a record's permanent id, or a name such as Oren_Vale.webp) and shows a preview in Link files to records. Nothing is changed until you press Link.</p>
      <nav class="agassets-crumbs" aria-label="Folder path">
        {{#each assets.crumbs}}{{#if current}}<span class="agassets-crumb" aria-current="page"><strong>{{label}}</strong></span>{{else}}<button type="button" class="ag-link" data-ag-assets-open="{{target}}">{{label}}</button><span aria-hidden="true"> / </span>{{/if}}{{/each}}
      </nav>
      <div class="ag-toolbar" role="search" aria-label="Asset files">
        <button type="button" class="ag-btn ag-btn--sm" data-ag-action="assets-up" data-ag-assets-up {{#unless assets.canGoUp}}disabled{{/unless}}><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Up one folder</button>
        <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-assets-query value="{{assets.query}}" placeholder="Search this folder" aria-label="Search this folder" /></label>
        <div class="ag-toolbar__end">
          <button type="button" class="ag-btn" data-ag-action="assets-new-folder" {{#unless assets.ok}}disabled{{/unless}}{{#if assets.uploading}} disabled{{/if}}><i class="fa-solid fa-folder-plus" aria-hidden="true"></i> Create folder…</button>
          {{{assets.chooseFiles}}}
        </div>
      </div>
      <div class="agassets-drop" data-ag-assets-drop>
        <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
        <span>Drop images here to add them to <strong>{{#each assets.crumbs}}{{#if current}}{{label}}{{/if}}{{/each}}</strong>, or use Choose files…. Several at once is fine.</span>
      </div>
      <p class="agmanager-tiny">Rename, move and delete are not offered to modules by Foundry or The Forge, so they are not here.{{#if assets.onForge}} <a class="ag-btn ag-btn--sm" href="{{assets.manageUrl}}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Manage on Forge…</a>{{else}} Use your host's file manager.{{/if}}</p>
      {{#if assets.uploading}}<div class="ag-cluster agclean-running" aria-label="Upload progress">
        <progress class="agclean-bar" data-ag-assets-upload-bar max="1" value="0" aria-label="Files uploaded"></progress>
        <button type="button" class="ag-btn ag-btn--danger" data-ag-assets-stop><i class="fa-solid fa-stop" aria-hidden="true"></i> Stop</button>
      </div>{{/if}}
      <p class="agmanager-tiny" role="status" data-ag-assets-upload-status>{{assets.uploadMessage}}</p>
      {{#if assets.hasUploads}}<ul class="ag-rows agm-scrollcap" aria-label="Upload results">
        {{#each assets.uploads}}<li class="ag-row"><span class="ag-badge{{#if tone}} ag-badge--{{tone}}{{/if}}">{{label}}</span><span class="ag-row__main"><span class="ag-row__title">{{name}}</span><span class="ag-row__meta">{{message}}</span></span></li>{{/each}}
      </ul>{{/if}}

      {{#if assets.loading}}<p class="ag-empty" role="status"><span class="ag-empty__text">Opening the folder…</span></p>
      {{else if assets.problem}}<div class="ag-empty" role="alert"><p class="ag-empty__title">This folder could not be opened</p><p class="ag-empty__text">{{assets.problem}}</p></div>
      {{else}}
        {{#if assets.emptyFolder}}<div class="ag-empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><p class="ag-empty__title">This folder is empty</p><p class="ag-empty__text">Drop images here to add the first ones.</p></div>{{/if}}
        {{#if assets.noMatches}}<div class="ag-empty"><p class="ag-empty__title">Nothing matches the search</p></div>{{/if}}
        {{#if assets.dirs.length}}<h4>Folders ({{assets.folderCount}})</h4>
        <ul class="agassets-folders">{{#each assets.dirs}}<li><button type="button" class="ag-btn ag-btn--sm" data-ag-assets-open="{{target}}"><i class="fa-solid fa-folder" aria-hidden="true"></i> {{name}}</button></li>{{/each}}</ul>{{/if}}
        {{#if assets.tiles.length}}<h4>Images ({{assets.fileCount}})</h4>
        <ul class="agassets-grid">{{#each assets.tiles}}<li class="agassets-tile">
          <img class="agassets-tile__img" src="{{url}}" alt="" loading="lazy" decoding="async">
          <span class="agassets-tile__name">{{name}}</span>
          <button type="button" class="ag-btn ag-btn--sm" data-ag-assets-copy="{{path}}" aria-label="Copy path of {{name}}" data-tooltip="Copy the path to paste into an image field"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy path</button>
        </li>{{/each}}</ul>
        {{#if assets.moreCount}}<div class="ag-cluster"><button type="button" class="ag-btn" data-ag-assets-more><i class="fa-solid fa-angles-down" aria-hidden="true"></i> Show more ({{assets.moreCount}} left)</button></div>{{/if}}
        {{/if}}
      {{/if}}
    </section>

    <details class="ag-fold" data-ag-fold-key="assets-link" {{#if assets.hasLinks}}open{{/if}}>
      <summary class="ag-fold__summary"><span class="ag-fold__title">Link files to records</span><span class="ag-fold__hint">Set a record's image from a file that fits it</span></summary>
      <div class="ag-fold__body">
        <p class="agmanager-tiny">Looks in the folder you are viewing and the folders under it (and runs by itself on files you have just added), then shows what would change. A file named exactly after a record's permanent id comes first. After that Manager guesses by name: the whole name, then first and last name, then just a first or last name for Actors. Words like portrait, token, final and sizes are ignored. A file that fits two records, or a record that fits two files, is never chosen for you: pick from the list. Every row has Yes (use this match), No (skip it) and Different… (give the file to another record, found by typing part of its name). Nothing is written until you press Link. Images you set in Foundry start on No and need your Yes. For an existing Actor only the portrait and the token image change (plus Foundry's token ring while Turn on token ring is ticked), and there is no undo, so the old images are listed here.</p>
        <div class="ag-cluster"><button type="button" class="ag-btn" data-ag-action="assets-scan" {{#if assets.scanning}}disabled{{/if}}{{#unless assets.ok}} disabled{{/unless}}><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Find matching files</button></div>
        <p class="agmanager-tiny" role="status">{{assets.linkMessage}}</p>
        {{#if assets.hasLinks}}
        {{#if assets.scanSummary}}<p class="agmanager-tiny">{{assets.scanSummary}}</p>{{/if}}
        {{#if assets.hasAnyRows}}
        <div class="ag-cluster aglink-bulk" role="group" aria-label="Set every match at once">
          <button type="button" class="ag-btn ag-btn--sm" data-ag-assets-bulk="yes">Yes to all matches</button>
          <button type="button" class="ag-btn ag-btn--sm" data-ag-assets-bulk="no">No to all</button>
          <button type="button" class="ag-btn ag-btn--sm" data-ag-assets-bulk="reset">Reset to guesses</button>
        </div>
        <p class="agmanager-tiny">Yes to all matches skips images you set in Foundry and anything still waiting for a pick; say Yes to those one at a time.</p>
        <p class="aglink-count" role="status" aria-live="polite"><strong>{{assets.linkCountLine}}</strong>{{#if assets.linkUndecided}} {{assets.linkUndecided}} still need your pick.{{/if}}{{#if assets.linkConflicts}} {{assets.linkConflicts}} rows want the same record: fix them before you can link.{{/if}}</p>
        {{#if assets.ringOffer}}
        <p class="aglink-ring"><label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-assets-token-ring {{#if assets.tokenRing}}checked{{/if}}> <strong>Turn on token ring</strong></label>
          <span class="agmanager-tiny">Applies to the Actors linked in this batch. Foundry's built-in ring: green for NPC people, red for bestiary creatures, black for Ashen creatures. {{#if assets.tokenRing}}{{assets.ringCount}} will get a ring{{#if assets.ringKept}}; {{assets.ringKept}} already have one and stay as they are{{/if}}.{{else}}No ring will be changed.{{/if}} Actors that already have a ring on, player characters and Actors without a rule are never changed. Nothing is written until you press Link.</span></p>
        {{/if}}
        {{#if assets.linkRows.length}}
        <div class="ag-table-wrap agm-scrollcap"><table class="ag-table aglink"><thead><tr><th scope="col">Use this match?</th><th scope="col">Record</th><th scope="col">File</th><th scope="col">Why it fits</th><th scope="col">Image now</th><th scope="col">New image</th></tr></thead><tbody>
        {{#each assets.linkRows}}<tr class="aglink-row{{#if willChange}} is-yes{{/if}}">
          <td data-label="Use this match?">
            <div class="aglink-choice">
              <div class="ag-segmented" role="radiogroup" aria-label="Use {{#if fileName}}{{fileName}}{{else}}this file{{/if}} for {{name}}?">
                <button type="button" role="radio" aria-checked="{{isYes}}" tabindex="{{#if yesTab}}0{{else}}-1{{/if}}" data-ag-assets-choice="{{key}}" data-value="yes" {{#unless canYes}}disabled{{/unless}}>Yes</button>
                <button type="button" role="radio" aria-checked="{{isNo}}" tabindex="{{#if noTab}}0{{else}}-1{{/if}}" data-ag-assets-choice="{{key}}" data-value="no">No</button>
              </div>
              <button type="button" class="ag-btn ag-btn--sm" data-ag-assets-different="{{key}}" aria-expanded="{{#if pickerOpen}}true{{else}}false{{/if}}" {{#unless canDifferent}}disabled aria-describedby="aglink-diff-{{@index}}"{{/unless}}>Different…</button>
            </div>
            <div class="agmanager-tiny" {{#unless canDifferent}}id="aglink-diff-{{@index}}"{{/unless}}>{{summary}}{{#unless canDifferent}}. Pick a file first to choose a different record.{{/unless}}</div>
            {{#if conflict}}<div class="aglink-warn"><span class="ag-badge ag-badge--warn">Same record</span> Another file is also set for {{name}}. Set one to No or choose a different record.</div>{{/if}}
          </td>
          <td data-label="Record">{{#if pickByFile}}<label class="ag-field--inline">Record <select data-ag-assets-pick="{{key}}" aria-label="Which record is {{fileName}} for?"><option value="">Pick a record…</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            {{else}}<strong>{{name}}</strong><div class="agmanager-tiny">{{kindLabel}}</div>{{/if}}
            {{#if picker}}<div class="aglink-picker" data-ag-assets-picker="{{key}}" role="group" aria-label="Pick the record for {{fileName}}">
              <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-assets-picker-q="{{key}}" placeholder="Type to filter by name" aria-label="Filter records by name" autocomplete="off"></label>
              <p class="agmanager-tiny" role="status" data-ag-assets-picker-status>{{picker.count}} record(s) shown.</p>
              <ul class="aglink-picker__list">{{#each picker.records}}<li><button type="button" class="ag-btn ag-btn--sm aglink-rec" data-ag-assets-record="{{uuid}}" data-search="{{search}}"><span class="aglink-rec__name">{{name}}</span> <span class="ag-badge">{{kindLabel}}</span>{{#if suggested}} <span class="agmanager-tiny">Suggested</span>{{/if}}{{#if current}} <span class="agmanager-tiny">Current</span>{{/if}}{{#if takenBy}} <span class="agmanager-tiny">Already has {{takenBy}} in this list</span>{{/if}}</button></li>{{/each}}</ul>
              <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-assets-picker-close="{{key}}">Close the list</button>
            </div>{{/if}}</td>
          <td data-label="File">{{#if pickByRecord}}<label class="ag-field--inline">File <select data-ag-assets-pick="{{key}}" aria-label="Which file is for {{name}}?"><option value="">Pick a file…</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            {{else}}<span class="agm-icon__path">{{fileName}}</span>{{/if}}{{#if alsoFound.length}}<div class="agmanager-tiny">Other files with this name: {{#each alsoFound}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}{{#if alsoFits.length}}<div class="agmanager-tiny">Also fits this name (a weaker match, so not offered): {{#each alsoFits}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}.</div>{{/if}}</td>
          <td data-label="Why it fits"><span class="agmanager-tiny">{{reason}}</span></td>
          <td data-label="Image now">{{#if to}}<div class="agm-icon">{{#if fromUrl}}<img class="agm-icon__thumb" src="{{fromUrl}}" alt="" loading="lazy" decoding="async" width="32" height="32">{{else}}<span class="agm-icon__thumb" aria-hidden="true"></span>{{/if}}<div class="agm-icon__text"><span class="ag-badge ag-badge--{{stateTone}}">{{stateLabel}}</span>{{#if from}}<div class="agmanager-tiny agm-icon__path">{{from}}</div>{{/if}}{{#if hasFromToken}}<div class="agmanager-tiny">Token: <span class="agm-icon__path">{{fromToken}}</span></div>{{/if}}{{#if noteText}}<div class="agmanager-tiny">{{noteText}}</div>{{/if}}</div></div>{{else}}<span class="agmanager-tiny">Pick first</span>{{/if}}</td>
          <td data-label="New image">{{#if to}}{{#if willChange}}<div class="agm-icon"><img class="agm-icon__thumb" src="{{toUrl}}" alt="" loading="lazy" decoding="async" width="32" height="32"><div class="agm-icon__text"><span class="ag-badge ag-badge--ok">Will change</span><div class="agm-icon__path">{{fileName}}</div>{{#if isActor}}<div class="agmanager-tiny">Portrait and token image{{#if ringWill}}, and a {{ringLabel}} token ring{{/if}}{{#if ringKeptNote}}; its token ring is already on and stays as it is{{/if}}</div>{{/if}}</div></div>
            {{else if conflict}}<span class="agmanager-tiny">Waiting for you to choose between the rows</span>
            {{else}}<span class="ag-badge">Skipped</span> <span class="agmanager-tiny">Stays as it is</span>{{/if}}{{else}}<span class="agmanager-tiny">Pick first</span>{{/if}}</td>
        </tr>{{/each}}
        </tbody></table></div>
        {{/if}}
        {{#if assets.hasCinderRows}}
        <h4>Cinder art stages</h4>
        <p class="agmanager-tiny">Files named like Echo_Cinder_Stage_1.webp are grouped by Cinder and set as the art stages of the Cinder itself (stage 1 first), so every character who has it uses them, and it works before anyone has it. They are not offered to any other record.</p>
        <div class="ag-table-wrap agm-scrollcap"><table class="ag-table aglink"><thead><tr><th scope="col">Use this match?</th><th scope="col">Cinder</th><th scope="col">Stages</th><th scope="col">Why it fits</th></tr></thead><tbody>
        {{#each assets.cinderRows}}<tr class="aglink-row{{#if willChange}} is-yes{{/if}}">
          <td data-label="Use this match?">
            <div class="aglink-choice">
              <div class="ag-segmented" role="radiogroup" aria-label="Use these images for {{cinderLabel}}?">
                <button type="button" role="radio" aria-checked="{{isYes}}" tabindex="{{#if isYes}}0{{else}}-1{{/if}}" data-ag-assets-cinder-choice="{{key}}" data-value="yes" {{#unless canYes}}disabled{{/unless}}>Yes</button>
                <button type="button" role="radio" aria-checked="{{isNo}}" tabindex="{{#if isYes}}-1{{else}}0{{/if}}" data-ag-assets-cinder-choice="{{key}}" data-value="no">No</button>
              </div>
              <button type="button" class="ag-btn ag-btn--sm" data-ag-assets-cinder-different="{{key}}" aria-expanded="{{#if pickerOpen}}true{{else}}false{{/if}}" {{#unless canDifferent}}disabled{{/unless}}>Different…</button>
            </div>
            <div class="agmanager-tiny">{{summary}}</div>
            {{#if conflict}}<div class="aglink-warn"><span class="ag-badge ag-badge--warn">Same Cinder</span> Another row is also set for {{cinderLabel}}. Set one to No or choose a different Cinder.</div>{{/if}}
            {{#if pickerOpen}}<label class="ag-field--inline">Cinder <select data-ag-assets-cinder-pick="{{key}}" aria-label="Which Cinder is {{word}} for?"><option value="">Pick a Cinder…</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          </td>
          <td data-label="Cinder"><strong>{{cinderLabel}}</strong>{{#if where}}<div class="agmanager-tiny">{{where}}{{#if bearers}} · {{bearers}} {{#if bearersOne}}character has{{else}}characters have{{/if}} it now{{/if}}</div>{{/if}}</td>
          <td data-label="Stages">
            {{#if problem}}<div class="aglink-warn"><span class="ag-badge ag-badge--warn">Not set</span> {{problem}}</div>{{/if}}
            {{#if hasStages}}<ol class="agmanager-tiny">{{#each stages}}<li class="agm-icon">{{#if hasOld}}<img class="agm-icon__thumb" src="{{oldUrl}}" alt="Stage {{number}} now" loading="lazy" decoding="async" width="32" height="32"><span aria-hidden="true">→</span>{{/if}}<img class="agm-icon__thumb" src="{{toUrl}}" alt="Stage {{number}} new" loading="lazy" decoding="async" width="32" height="32"><span class="agm-icon__text">Stage {{number}}: <span class="agm-icon__path">{{fileName}}</span> (unlocks needed: {{at}}){{#if hasOld}} replaces the current image{{/if}}</span></li>{{/each}}</ol>{{/if}}
            {{#if hasSingle}}{{#each single}}<div class="agm-icon">{{#if hasOld}}<img class="agm-icon__thumb" src="{{oldUrl}}" alt="Image now" loading="lazy" decoding="async" width="32" height="32"><span aria-hidden="true">→</span>{{/if}}<img class="agm-icon__thumb" src="{{toUrl}}" alt="New image" loading="lazy" decoding="async" width="32" height="32"><span class="agm-icon__text">One image: <span class="agm-icon__path">{{fileName}}</span></span></div>{{/each}}{{/if}}
            {{#if note}}<div class="agmanager-tiny">{{note}}</div>{{/if}}
            {{#if hasExtras}}<div class="agmanager-tiny">Not used: {{#each extras}}{{name}} ({{why}}){{#unless @last}} {{/unless}}{{/each}}</div>{{/if}}
          </td>
          <td data-label="Why it fits"><span class="agmanager-tiny">{{reason}}</span></td>
        </tr>{{/each}}
        </tbody></table></div>
        {{/if}}
        {{#if assets.linkOverflow}}<p class="agmanager-tiny">Showing the first 300 of {{assets.linkCount}}. Open a deeper folder to link the rest.</p>{{/if}}
        <footer class="ag-footer">
          <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="assets-link-cancel">Cancel</button>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-action="assets-link-apply" {{#unless assets.linkCanApply}}disabled{{/unless}}><i class="fa-solid fa-link" aria-hidden="true"></i> Link {{assets.linkTicked}}…</button>
        </footer>
        {{/if}}
        {{/if}}
      </div>
    </details>

    <details class="ag-fold" data-ag-fold-key="assets-missing" open>
      <summary class="ag-fold__summary"><span class="ag-fold__title">Missing art</span><span class="ag-fold__count">{{assets.missingCount}}</span><span class="ag-fold__hint">Records with no image or a generic one</span></summary>
      <div class="ag-fold__body">
        <p class="agmanager-tiny">Manager-imported records that still show no image or a placeholder. The file name is what to call the image so the link section finds it (a file named after the record's name is also found).{{#unless assets.missingScanned}} Run Find matching files to see which already have a file waiting.{{/unless}}</p>
        <div class="ag-toolbar" role="search" aria-label="Missing art filters">
          <label class="ag-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-assets-missing="query" value="{{assets.missingQuery}}" placeholder="Search records" aria-label="Search records needing art" /></label>
          <div class="ag-toolbar__filters">
            <label class="ag-field--inline">Kind <select data-ag-assets-missing="kind">{{#each assets.missingKinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label class="ag-field--inline">Image <select data-ag-assets-missing="state">{{#each assets.missingStates}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          </div>
        </div>
        {{#if assets.missingRows.length}}
        <div class="ag-table-wrap agm-scrollcap"><table class="ag-table"><thead><tr><th scope="col">Record</th><th scope="col">Kind</th><th scope="col">Image</th><th scope="col">File name to use</th></tr></thead><tbody>
        {{#each assets.missingRows}}<tr>
          <td><strong>{{name}}</strong></td>
          <td>{{kindLabel}}</td>
          <td><span class="ag-badge ag-badge--{{tone}}">{{stateLabel}}</span></td>
          <td><span class="agm-icon__path">{{fileName}}</span>{{#if fileWaiting}} <span class="ag-badge ag-badge--ok">File found</span>{{/if}}</td>
        </tr>{{/each}}
        </tbody></table></div>
        {{#if assets.missingOverflow}}<p class="agmanager-tiny">Showing the first 300 of {{assets.missingCount}}. Narrow the filters to see the rest.</p>{{/if}}
        {{else}}<div class="ag-empty"><p class="ag-empty__title">Nothing needs art</p><p class="ag-empty__text">Every record that matches these filters has its own image.</p></div>{{/if}}
      </div>
    </details>
    </div>
    {{/if}}

    {{#if libraryExportActive}}
    <section class="ag-section aglib-section agmanager-worldexport" aria-label="Export Ashen Gate data">
      <div class="ag-section__head"><h3 class="ag-section__title">Export Ashen Gate data</h3></div>
      <p class="agmanager-tiny">One JSON file of all Ashen Gate tagged world records plus the other modules' definitions (no play state).</p>
      <div class="aglib-actions">
        <button type="button" class="ag-btn" data-ag-action="world-export-everything"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export everything</button>
        <button type="button" class="ag-btn" data-ag-action="world-backup"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Back up before play</button>
        <details class="aglib-menu">
          <summary class="ag-btn">More <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
          <div class="aglib-menu__pop">
            <button type="button" data-ag-action="world-export-changed"><i class="fa-solid fa-file-circle-exclamation" aria-hidden="true"></i> Export changed since last export</button>
            <button type="button" data-ag-action="world-export-copy"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy summary</button>
          </div>
        </details>
      </div>
      <p class="agmanager-tiny">Back up before play saves the same file as AG_Backup_&lt;date&gt;.json and does not change what counts as changed since last export.</p>
      {{#if worldExportSummary}}<pre class="agmanager-tiny agmanager-worldexport-summary">{{worldExportSummary}}</pre>{{/if}}
      <p class="agmanager-tiny">To export only some records with their local edits, tick them under Records and use <strong>Actions → Export selected / local edits</strong>.</p>
    </section>
    {{/if}}

      {{#if organizeActive}}
      <div class="agmanager-organize">
        <details class="ag-fold" data-ag-fold-key="folders-clean" open>
          <summary class="ag-fold__summary"><span class="ag-fold__title">Clean compendiums</span>{{#if org.clean.preview}}<span class="ag-fold__count">{{org.clean.preview.totals.moves}}</span>{{/if}}<span class="ag-fold__hint">Put every misfiled document in its rule's folder. Nothing moves until Apply.</span></summary>
          <div class="ag-fold__body agclean">
          <div class="ag-cluster">
            <button type="button" class="ag-btn agclean-go" data-ag-action="clean-scan"><i class="fa-solid fa-broom" aria-hidden="true"></i> Scan world and compendiums</button>
            <span class="agmanager-tiny">The filters above do not apply. Protected folders, Keep here and player characters are never moved.</span>
          </div>
          <p class="agmanager-tiny" role="status" data-ag-clean-status>{{org.clean.status}}</p>
          {{#if org.clean.running}}<div class="ag-cluster agclean-running" aria-label="Clean compendiums progress">
            <progress class="agclean-bar" data-ag-clean-bar max="1" value="{{org.clean.pct}}" aria-label="Documents moved"></progress>
            <button type="button" class="ag-btn ag-btn--danger" data-ag-clean-stop><i class="fa-solid fa-stop" aria-hidden="true"></i> Cancel move</button>
            <span class="agmanager-tiny">Stops after the current chunk of 50; what moved stays moved and is in Undo.</span>
          </div>{{/if}}
          {{#with org.clean.preview}}
          <div class="ag-cluster">
            <span class="ag-badge">To move: {{totals.moves}}</span>
            <span class="ag-badge">Ticked: <span data-ag-clean-count>{{ticked}}</span></span>
            <span class="ag-badge">New folders: {{totals.createFolders}}</span>
            <span class="ag-badge">Already in place: {{totals.inPlace}}</span>
            <span class="ag-badge">Skipped (protected / Keep here / left alone): {{totals.skipped}}</span>
            <span class="ag-badge">No rule: {{totals.unmatched}}</span>
          </div>
          {{#if weak}}<p class="ag-notice ag-notice--warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> <span>{{weak}} move(s) to Core 5.5e rest on weak evidence and start <strong>unticked</strong>. Tick them only if they really are core items.</span></p>{{/if}}
          <p class="agmanager-tiny">Each move says why. To keep a document where it is, press <strong>Keep here</strong>, or protect its folder under Rules &amp; protected folders.</p>
          {{#each withMoves}}
          <div class="agmanager-org-part">
            <h4>{{label}} — {{moveCount}} to move</h4>
            {{#each parts}}
            <div class="agclean-part">
              <div class="ag-cluster"><strong>{{label}}: {{moveCount}} to move</strong>{{#if createCount}}<span class="agmanager-tiny">{{createCount}} new folder(s)</span>{{/if}}
                <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-clean-part="{{partKey}}" data-on="true">Tick all</button>
                <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-clean-part="{{partKey}}" data-on="false">Untick all</button></div>
              {{#if skippedCount}}<p class="agmanager-tiny">{{skippedCount}} skipped (protected folder, Keep here, or a rule that leaves them alone){{#if protectedFolders}}: protected {{protectedFolders}}{{/if}}.</p>{{/if}}
              {{#each groups}}
              <details class="agmanager-org-group"><summary>→ <strong>{{path}}</strong> ({{count}})</summary>
                <div class="ag-table-wrap agm-scrollcap"><table class="ag-table"><thead><tr><th scope="col">Move</th><th scope="col">Document</th><th scope="col">From</th><th scope="col">Why</th><th scope="col" class="is-actions"><span class="ag-sr-only">Actions</span></th></tr></thead><tbody>
                {{#each rows}}<tr><td><input type="checkbox" data-ag-clean-move="{{key}}" {{#if checked}}checked{{/if}} aria-label="Move {{name}}"></td><td>{{name}}</td><td>{{from}}</td>
                  <td>{{why}}{{#if weak}} <span class="ag-badge ag-badge--warn">weak evidence, unticked</span>{{/if}}</td>
                  <td class="is-actions">{{#if keep}}<button type="button" class="ag-btn ag-btn--sm" data-ag-clean-keep="{{keep.id}}" data-ag-clean-doctype="{{keep.documentName}}" data-ag-clean-key="{{key}}" aria-label="Keep {{name}} here" data-tooltip="Never move this document" data-tooltip-class="ag-tooltip">Keep here</button>{{/if}}</td></tr>{{/each}}
                </tbody></table></div>
              </details>
              {{/each}}
            </div>
            {{/each}}
          </div>
          {{/each}}
          {{#if clean}}<p class="agmanager-tiny">Already sorted: {{clean}}.</p>{{/if}}
          {{#if skippedSources.length}}<h4>Skipped compendiums ({{skippedSources.length}})</h4><ul>
            {{#each skippedSources}}<li><strong>{{label}}</strong>: {{#if locked}}locked, skipped. {{/if}}{{hint}}</li>{{/each}}</ul>{{/if}}
          <footer class="ag-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="clean-cancel" {{#if @root.org.clean.running}}disabled{{/if}}>Cancel</button>
            <span class="ag-btn-group">
              <button type="button" class="ag-btn" data-ag-action="clean-backup" data-ag-clean-needs-ticks {{#unless ticked}}disabled{{/unless}}><i class="fa-solid fa-download" aria-hidden="true"></i> Download backup</button>
              <button type="button" class="ag-btn ag-btn--primary" data-ag-action="clean-commit" data-ag-clean-needs-ticks {{#unless ticked}}disabled{{/unless}}{{#if @root.org.clean.running}} disabled{{/if}}><i class="fa-solid fa-broom" aria-hidden="true"></i> Apply (<span data-ag-clean-count>{{ticked}}</span>)…</button>
            </span>
          </footer>
          {{/with}}
          </div>
        </details>

        <details class="ag-fold" data-ag-fold-key="folders-organize">
          <summary class="ag-fold__summary"><span class="ag-fold__title">Organize a selection</span>{{#if org.preview}}<span class="ag-fold__count">{{org.preview.totals.moves}}</span>{{/if}}<span class="ag-fold__hint">Refile only what the filters above pick, or one folder.</span></summary>
          <div class="ag-fold__body">
          <p><strong>Where:</strong> {{org.whereLabel}}{{#unless org.whereWritable}} <span class="ag-badge ag-badge--warn">inspect only</span>{{/unless}}
