            <label class="agmanager-toggle"><input type="radio" name="ag-org-scope" value="selection" data-ag-org-scope {{#if org.scopeSelection}}checked{{/if}} {{#unless org.filtered}}disabled{{/unless}}> This selection or folder: {{#if org.filtered}}<strong class="aglib-num">{{org.selectedCount}}</strong> document(s) matching the filters above{{#if org.folderFilter}} (the chosen folder and its sub-folders){{/if}}{{else}}set a filter or a Folder above first{{/if}}</label>
            {{#if org.packsMissing}}<p class="agmanager-warnings">This compendium's index is not loaded yet, so the selection is empty. Press <strong>Load compendiums</strong> above.</p>{{/if}}
          </fieldset>
          <div class="agmanager-row agmanager-row-wrap">
            {{#each org.types}}<label class="agmanager-toggle"><input type="checkbox" data-ag-org-type="{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}
            <label>Move <select data-ag-org-mode>
              <option value="misfiled" {{#if org.modeMisfiled}}selected{{/if}}>Only unfiled and misfiled</option>
              <option value="all" {{#if org.modeAll}}selected{{/if}}>Refile everything (also from your own folders)</option>
            </select></label>
            <button type="button" class="ag-btn" data-ag-action="org-preview"><i class="fa-solid fa-magnifying-glass"></i> Preview</button>
          </div>
          <p class="agmanager-tiny" role="status">{{org.message}}</p>
          <p class="agmanager-tiny">To organize one folder, pick it under <strong>Folder</strong> above and choose <strong>This selection or folder</strong>. To filter first (e.g. Origin: DDB / Plutonium), do the same: Preview then lists only those documents. To keep a folder as it is, protect it below.</p>
          <p class="agmanager-tiny">Only the folder changes. Nothing is renamed, edited or deleted, and no folder is ever deleted. Player characters and player-owned actors stay where they are. Documents in a protected folder, or marked <strong>Keep here</strong>, are skipped. Locked, module and system compendiums are inspect-only.</p>
          <p class="agmanager-tiny">Default rules: Ashen Gate records go to <strong>Ashen Gate</strong>. Other Items go to <strong>Core 5.5e</strong> only with real evidence: imported by Plutonium, a core source book (PHB'24, DMG'24, MM'24, SRD 5.2, or 2014 PHB, DMG, MM, SRD 5.1), or copied from a dnd5e compendium or imported from D&amp;D Beyond (these two are weak evidence and marked so). dnd5e gives every new item rules "2024", so a hand-made item with no source book goes to <strong>Homebrew</strong>, as do items with no source or a third-party or homebrew source, with the same sub-folders. Each move in the preview says why. Your own saved rules are used instead if you have them.</p>

          {{#if org.preview}}
          <div class="agmanager-row agmanager-row-wrap">
            <span class="agmanager-chip">Would move: {{org.preview.totals.moves}}</span>
            <span class="agmanager-chip">New folders: {{org.preview.totals.createFolders}}</span>
            <span class="agmanager-chip">Already in place: {{org.preview.totals.inPlace}}</span>
            <span class="agmanager-chip">Skipped: {{org.preview.totals.skipped}}</span>
            <span class="agmanager-chip">No rule: {{org.preview.totals.unmatched}}</span>
          </div>
          {{#each org.preview.parts}}
          <div class="agmanager-org-part">
            <h4>{{label}} — {{moveCount}} to move{{#if ../org.preview.narrowed}} <span class="ag-badge">selection only</span>{{/if}}</h4>
            {{#unless writable}}<p class="agmanager-warnings"><strong>Inspect only:</strong> {{blockedReason}}.</p>{{/unless}}
            {{#each groups}}
            <details class="agmanager-org-group"><summary><strong>{{path}}</strong> ({{count}})</summary>
              <table class="agmanager-table"><thead><tr><th>Document</th><th>From</th><th>Why</th><th></th></tr></thead><tbody>
              {{#each rows}}<tr><td>{{name}}</td><td>{{from}}</td><td>{{why}}{{#if weak}} <span class="ag-badge ag-badge--warn">weak evidence: check it</span>{{/if}}</td><td>{{#if @root.org.world}}<button type="button" class="ag-btn ag-btn--sm" data-ag-org-keep="{{id}}" data-ag-org-doctype="{{documentName}}" title="Never move this document">Keep here</button>{{/if}}</td></tr>{{/each}}
              </tbody></table>
            </details>
            {{/each}}
            {{#if hasCreates}}<details class="agmanager-org-group"><summary>Folders to create ({{createFolders.length}})</summary><ul>{{#each createFolders}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}
            {{#if hasSkipped}}<details class="agmanager-org-group"><summary>Skipped ({{skipped.length}})</summary><ul>{{#each skipped}}<li><strong>{{name}}</strong> in {{from}}{{#if to}} (rule says {{to}}){{/if}} — {{reason}}</li>{{/each}}</ul></details>{{/if}}
            {{#if hasUnmatched}}<details class="agmanager-org-group"><summary>No matching rule, left where they are ({{unmatched.length}})</summary><ul>{{#each unmatched}}<li><strong>{{name}}</strong> in {{from}}</li>{{/each}}</ul></details>{{/if}}
          </div>
          {{/each}}
          <footer class="agmanager-row agmanager-mood-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="org-clear">Cancel</button>
            <span class="agmanager-row">
              <button type="button" class="ag-btn" data-ag-action="org-backup" {{#unless org.preview.totals.moves}}disabled{{/unless}}><i class="fa-solid fa-download"></i> Download backup</button>
              <button type="button" class="ag-btn ag-btn--primary" data-ag-action="org-apply" {{#unless org.preview.canApply}}disabled{{/unless}}><i class="fa-solid fa-folder-tree"></i> Apply…</button>
            </span>
          </footer>
          {{/if}}
          {{#if org.result}}<p class="agmanager-tiny"><strong>Last apply:</strong> {{org.result.message}}</p>
            {{#if org.hasEmpty}}<details class="agmanager-org-group"><summary>Empty folders (report only, nothing deleted): {{org.result.emptyFolders.length}}</summary><ul>{{#each org.result.emptyFolders}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}{{/if}}
        </section>

        <section class="ag-card" aria-label="Organize history">
          <div class="agmanager-row agmanager-row-wrap"><h3>Recent organize runs</h3>
            <button type="button" class="ag-btn" data-ag-action="org-undo" {{#unless org.history.length}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Undo last organize…</button></div>
          {{#if org.history.length}}<ul>{{#each org.history}}<li>{{at}} · {{source}} · {{mode}} · {{moved}} moved</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">No organize runs yet. The last 5 are kept for Undo.</p>{{/if}}
        </section>

        {{#if org.world}}
        <section class="ag-card" aria-label="Protected folders">
          <h3>Protected folders</h3>
          <p class="agmanager-tiny">Organize never moves anything in a protected folder or its sub-folders.</p>
          <div class="agmanager-row agmanager-row-wrap">
            <select data-ag-org-folder aria-label="Folder to protect">{{#each org.openFolders}}<option value="{{id}}">{{label}}</option>{{/each}}</select>
            <button type="button" class="ag-btn" data-ag-org-protect><i class="fa-solid fa-lock"></i> Protect folder</button>
          </div>
          {{#if org.protectedFolders.length}}<ul>{{#each org.protectedFolders}}<li>{{label}} <button type="button" class="ag-btn ag-btn--sm" data-ag-org-unprotect="{{id}}">Unprotect</button></li>{{/each}}</ul>{{/if}}
        </section>
        {{/if}}

        <section class="ag-card" aria-label="Organize rules">
          <div class="agmanager-row agmanager-row-wrap"><h3>Rules {{#if org.schemaIsDefault}}<span class="ag-badge">Default</span>{{/if}}</h3>
            <span class="agmanager-row">
              <button type="button" class="ag-btn" data-ag-action="org-schema-edit"><i class="fa-solid fa-pen"></i> Edit rules (JSON)</button>
              <button type="button" class="ag-btn" data-ag-action="org-schema-export"><i class="fa-solid fa-download"></i> Export</button>
              <label class="ag-btn"><i class="fa-solid fa-upload"></i> Import <input type="file" accept=".json,application/json" data-ag-org-schema-file hidden></label>
            </span></div>
          <p class="agmanager-tiny">Checked top to bottom; the first rule that matches decides the folder. <code>{tier}</code>, <code>{rarity}</code>, <code>{spellLevel}</code>, <code>{creatureType}</code>, <code>{crBand}</code> and <code>{entityType}</code> fill in from the document; if one is empty the next rule is tried.</p>
          {{#if org.editing}}
            <textarea data-ag-org-schema-text rows="18" class="agmanager-org-json" aria-label="Organize rules JSON">{{org.schemaText}}</textarea>
            <footer class="agmanager-row agmanager-mood-footer">
              <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="org-schema-cancel">Cancel</button>
              <button type="button" class="ag-btn ag-btn--primary" data-ag-action="org-schema-save"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
            </footer>
          {{else}}
          <table class="agmanager-table"><thead><tr><th>#</th><th>Rule</th><th>For</th><th>When</th><th>Folder</th></tr></thead><tbody>
            {{#each org.rules}}<tr><td>{{n}}</td><td>{{label}}</td><td>{{types}}</td><td><code>{{match}}</code></td><td>{{#if leave}}<em>leave where it is</em>{{else}}{{path}}{{/if}}</td></tr>{{/each}}
          </tbody></table>
          {{/if}}
          <p class="agmanager-tiny"><button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="org-schema-reset">Reset rules to defaults…</button></p>
        </section>

      </div>
      {{/if}}

      {{#if coreLinksActive}}
      <div class="agmanager-panel agmanager-organize">
        <section class="ag-card" aria-label="Core links">
          <div class="agmanager-row agmanager-row-wrap"><h3>Core links <span class="agmanager-beta">GM only</span></h3>
            <button type="button" class="ag-btn" data-ag-action="cl-scan"><i class="fa-solid fa-magnifying-glass"></i> Scan</button></div>
          <p class="agmanager-tiny" role="status">{{cl.message}}</p>
          {{#if cl.noRefs}}<p class="ag-empty">Nothing to link: Core Links only works on Ashen Gate items whose data names a matching official item (a <code>core_ref</code>), and this world has none, so nothing needs doing: to use it, add a <code>core_ref</code> to Ashen Gate items in their source data and re-import them, otherwise ignore this section.</p>{{/if}}
          <p class="agmanager-tiny">Only Ashen Gate world Items whose source data has <code>core_ref</code> are checked. Matches come from 2024 (5.5e) content only: Plutonium-imported and other 2024 world items, world compendiums, the core sources in <strong>GM Setup</strong>, then the dnd5e 2024 packs. <strong>Adopt</strong> replaces the item's image and data (description included) with the core item's and keeps its name, Ashen Gate id, folder, ownership and module data. Copies in player inventories are never touched.</p>
          {{#if cl.preview}}
          <div class="agmanager-row agmanager-row-wrap">
            <span class="agmanager-chip">Core items found: {{cl.preview.poolSize}}</span>
            <span class="agmanager-chip">Ashen Gate items without core_ref (untouched): {{cl.preview.withoutRef}}</span>
            <span class="agmanager-chip">Ticked: {{cl.preview.tickedCount}}</span>
          </div>
          {{#if cl.preview.hiddenByFilters}}<p class="agmanager-tiny">{{cl.preview.hiddenByFilters}} scanned item(s) are hidden by the filters above. Apply and Download backup use only the ticked items shown here.</p>{{/if}}
          {{#each cl.preview.notes}}<p class="agmanager-warnings">{{this}}</p>{{/each}}
          {{#each cl.preview.groups}}
          <div class="agmanager-org-part">
            <h4>{{label}} ({{rows.length}})</h4>
            <table class="agmanager-table"><thead><tr><th></th><th>Ashen Gate item</th><th>core_ref</th><th>Core match</th><th>Notes</th></tr></thead><tbody>
            {{#each rows}}<tr>
              <td>{{#if selectable}}<input type="checkbox" data-ag-cl-tick="{{id}}" {{#if ticked}}checked{{/if}} aria-label="Link {{name}}">{{/if}}</td>
              <td><strong>{{name}}</strong><code>{{sourceId}}</code></td>
              <td>{{refText}}</td>
              <td>{{#if best}}<strong>{{best.name}}</strong> <span class="ag-badge">{{best.confidence}}</span><div class="agmanager-tiny">{{best.sourceLabel}} · matched on {{matchedOn}}</div>
                {{#if hasOthers}}<details><summary class="agmanager-tiny">Other candidates ({{others.length}})</summary><ul>{{#each others}}<li>{{name}} — {{confidence}}, {{sourceLabel}}</li>{{/each}}</ul></details>{{/if}}{{else}}—{{/if}}</td>
              <td>{{reason}}
                {{#if selectable}}{{#if canAdopt}}<label class="agmanager-toggle"><input type="checkbox" data-ag-cl-linkonly="{{id}}" {{#if linkOnly}}checked{{/if}}> Link only (keep my data)</label>{{/if}}{{/if}}
                {{#if diffCount}}<details><summary class="agmanager-tiny">What Adopt changes ({{diffCount}} field(s))</summary>
                  <table class="agmanager-table"><thead><tr><th>Field</th><th>Now</th><th>Core</th></tr></thead><tbody>{{#each diff}}<tr><td><code>{{path}}</code></td><td>{{before}}</td><td>{{after}}</td></tr>{{/each}}</tbody></table></details>{{/if}}</td>
            </tr>{{/each}}
            </tbody></table>
          </div>
          {{/each}}
          <footer class="agmanager-row agmanager-mood-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="cl-clear">Cancel</button>
            <span class="agmanager-row">
              <button type="button" class="ag-btn" data-ag-action="cl-backup" {{#unless cl.preview.tickedCount}}disabled{{/unless}}><i class="fa-solid fa-download"></i> Download backup</button>
              <button type="button" class="ag-btn ag-btn--primary" data-ag-action="cl-apply" {{#unless cl.preview.tickedCount}}disabled{{/unless}}><i class="fa-solid fa-link"></i> Apply ({{cl.preview.tickedCount}})…</button>
            </span>
          </footer>
          {{/if}}
        </section>
        <section class="ag-card" aria-label="Core link history">
