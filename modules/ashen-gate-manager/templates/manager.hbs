            <div class="aglib-menu__pop" role="menu">
              <button type="button" role="menuitem" data-ag-action="library-export"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export selected / local edits</button>
              <button type="button" role="menuitem" data-ag-action="library-replace"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Replace from loaded JSON</button>
              <button type="button" role="menuitem" data-ag-action="library-stage"><i class="fa-solid fa-box-archive" aria-hidden="true"></i> Copy to staging compendium</button>
              <hr>
              <button type="button" role="menuitem" data-ag-action="library-archive"><i class="fa-solid fa-folder-minus" aria-hidden="true"></i> Archive</button>
              <button type="button" role="menuitem" data-ag-action="library-restore"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i> Restore</button>
              <hr>
              <button type="button" role="menuitem" data-ag-action="library-delete" class="aglib-danger"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete archived… <small>asks first</small></button>
            </div>
          </details>
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="library-clear">Clear</button>
          {{else}}<span class="agmanager-tiny">Tick records to act on them.</span>{{/if}}
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost aglib-end" data-ag-action="library-select-visible">Select shown</button>
        </div>
        <div class="aglib-pager">
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost ag-btn--icon" data-ag-action="library-previous" aria-label="Previous page" data-tooltip="Previous page" data-tooltip-class="ag-tooltip" {{#unless libraryHasPrevious}}disabled{{/unless}}><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
          <span class="aglib-num">{{libraryPageLabel}}</span>
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost ag-btn--icon" data-ag-action="library-next" aria-label="Next page" data-tooltip="Next page" data-tooltip-class="ag-tooltip" {{#unless libraryHasNext}}disabled{{/unless}}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
        </div>
      </section>
      <section class="aglib-detail" aria-label="Selected library document details">
        {{#if libraryHasDetail}}
