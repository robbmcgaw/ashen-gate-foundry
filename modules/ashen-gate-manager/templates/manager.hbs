<section class="agmanager-body">
  <header class="ag-header agmanager-top">
    <i class="agmanager-emblem fa-solid fa-dungeon" aria-hidden="true"></i>
    <div class="agmanager-heading"><h2>Ashen Gate | General Manager <small>v0.33.0 Beta</small></h2></div>
    <button type="button" class="agmanager-help" data-ag-action="help" aria-label="Manager Help"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> Help</button><span class="agmanager-chip">GM only</span>
  </header>
  <nav class="ag-tabs agmanager-nav" aria-label="Manager tabs">
    <button type="button" data-ag-tab="import" class="{{#if importActive}}active{{/if}}"><i class="fa-solid fa-file-import"></i> Import</button>
    <button type="button" data-ag-tab="browse" class="{{#if browseActive}}active{{/if}}"><i class="fa-solid fa-magnifying-glass"></i> Browse</button>
    <button type="button" data-ag-tab="library" class="{{#if libraryActive}}active{{/if}}"><i class="fa-solid fa-layer-group"></i> Library</button>
    <button type="button" data-ag-tab="modules" class="{{#if modulesActive}}active{{/if}}"><i class="fa-solid fa-grip"></i> Modules</button>
    <button type="button" data-ag-tab="appearance" class="{{#if appearanceActive}}active{{/if}}"><i class="fa-solid fa-palette"></i> Appearance</button>
    <button type="button" data-ag-tab="scenes" class="{{#if scenesActive}}active{{/if}}"><i class="fa-solid fa-cloud-sun"></i> Scenes</button>
    <button type="button" data-ag-tab="organize" class="{{#if organizeActive}}active{{/if}}"><i class="fa-solid fa-folder-tree"></i> Organize</button>
    <button type="button" data-ag-tab="corelinks" class="{{#if coreLinksActive}}active{{/if}}"><i class="fa-solid fa-link"></i> Core Links</button>
    <button type="button" data-ag-tab="setup" class="{{#if setupActive}}active{{/if}}"><i class="fa-solid fa-gear"></i> GM Setup</button>
    <button type="button" data-ag-tab="history" class="{{#if historyActive}}active{{/if}}"><i class="fa-solid fa-clock-rotate-left"></i> History</button>
  </nav>

  {{#if importActive}}
  <div class="agmanager-panel">
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-filelabel"><i class="fa-solid fa-folder-open"></i> Choose JSON or ZIP package <input type="file" data-ag-file accept=".json,.zip,application/json,application/zip" /></label>
      <button type="button" data-ag-action="demo"><i class="fa-solid fa-flask"></i> Load example</button>
      <button type="button" data-ag-action="reset" class="agmanager-muted">Clear</button>
      <button type="button" data-ag-action="export" class="agmanager-muted" {{#unless hasPackage}}disabled{{/unless}}>Download report</button>
    </div>
    <div class="agmanager-package">
      <div><span>Package</span><strong>{{packageId}}</strong></div>
      <div><span>Version</span><strong>{{packageVersion}}</strong></div>
      <div><span>Schema</span><strong>{{schemaVersion}}</strong></div>
      <div><span>Records</span><strong>{{recordCount}}</strong></div>
    </div>
    {{#if zipBundle}}<div class="agmanager-zip-contents" aria-label="ZIP contents">
      <h3>ZIP contents: {{zipBundle.source}}</h3>
      <p class="agmanager-tiny">{{zipBundle.summary}} Files import one at a time in this order (Manager packages first), each through the normal preview and Apply; nothing changes until you confirm each Apply.</p>
      <table class="agmanager-table"><thead><tr><th>Import</th><th>File</th><th>Type</th><th>Records</th><th>Status</th></tr></thead><tbody>
      {{#each zipBundle.rows}}<tr class="{{#if isCurrent}}agmanager-current{{/if}}">
        <td><input type="checkbox" data-ag-zip-pick="{{filename}}" {{#if picked}}{{#unless isError}}checked{{/unless}}{{/if}} {{#unless canPick}}disabled{{/unless}} aria-label="Import {{filename}}" /></td>
        <td><code>{{filename}}</code></td><td>{{label}}</td><td>{{count}}</td>
        <td>{{status}}{{#if notice}}<div class="agmanager-tiny">{{notice}}</div>{{/if}}</td></tr>{{/each}}
      {{#each zipBundle.skipped}}<tr><td></td><td><code>{{filename}}</code></td><td>Skipped</td><td>—</td><td class="agmanager-tiny">{{reason}}</td></tr>{{/each}}
      </tbody></table>
      <div class="agmanager-row agmanager-row-wrap">
        {{#if zipBundle.running}}<button type="button" data-ag-action="zip-cancel" class="agmanager-muted">Stop ZIP import</button><button type="button" data-ag-action="zip-skip">Skip this file</button>
        {{else}}<button type="button" data-ag-action="zip-start" class="agmanager-primary" {{#unless zipBundle.pickedCount}}disabled{{/unless}}><i class="fa-solid fa-list-check"></i> Import selected files ({{zipBundle.pickedCount}})</button>{{/if}}
      </div>
    </div>{{/if}}
    <p class="agmanager-tiny"><strong>Source:</strong> {{packageSource}}. Supported: a Manager package (Item, Journal, Actor, RollTable, Macro, Location) or a Quest, Skill Tree, Headquarters facility or Factions file, which Manager recognises and hands to that module. A ZIP can hold one Manager package, or several import files (Manager packages plus Quest, Skill Tree, Headquarters and Factions files) that you pick from a ZIP contents list; source JSON and executable scripts are not run.</p>
    {{#if hasPackage}}<div class="agmanager-row agmanager-row-wrap">{{#each typeSummary}}<span class="agmanager-chip">{{name}}: {{count}}</span>{{/each}}</div>{{/if}}
    {{#if hasZipPortraits}}<label class="agmanager-toggle"><input type="checkbox" data-ag-upload-assets {{#if uploadZipArtwork}}checked{{/if}}> Upload matching ZIP portraits into this world's <code>ashen-gate-imports</code> folder before creating documents ({{zipPortraitCount}} images available).</label>{{/if}}
    <details><summary>Advanced import options</summary>
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-search-label">Import profile
        <select data-ag-profile>
          <option value="development" {{#if developmentProfile}}selected{{/if}}>Development — include unapproved</option>
          <option value="session-safe" {{#if sessionProfile}}selected{{/if}}>Session-safe — approved only</option>
        </select>
      </label>
      <span class="agmanager-tiny">Profiles change preview defaults only; they never apply changes automatically.</span>
    </div>
    <p class="agmanager-tiny"><strong>Advanced / sample files.</strong> Package templates (<code>templates</code> + <code>template_ref</code> in the JSON) are compiled automatically on load; they do not rewrite existing Items.</p>
    <div class="agmanager-row agmanager-row-wrap"><button type="button" data-ag-action="template-example">Download sample template package</button><button type="button" data-ag-action="import-format-example">Download v0.2 Import JSON starter</button><button type="button" data-ag-action="source-manifest-template">Download canonical source manifest</button></div>
    </details>
    {{#unless isSpecialist}}<label class="agmanager-toggle"><input type="checkbox" data-ag-drafts {{#if includeDrafts}}checked{{/if}}> Include <strong>draft / proposed / example</strong> records (sandbox testing only)</label>{{/unless}}
    {{#if isSpecialist}}{{#if specialistCanUpdate}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}}> <strong>Update existing {{specialistNoun}}</strong> (otherwise ones already in the world are kept as they are)</label>{{else}}<p class="agmanager-tiny">{{specialistLabel}} keeps {{specialistNoun}} that are already in the world; this file only adds new ones.</p>{{/if}}
    {{else}}{{#if hasLocationRecords}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}}> <strong>Update existing locations and routes</strong> (otherwise those already in the world are kept as they are; discovery, reveal and journey state are always kept)</label>{{/if}}
    {{#if hasActorRecords}}<label class="agmanager-toggle"><input type="checkbox" data-ag-update-actors {{#if updateActors}}checked{{/if}}> <strong>Update existing actors</strong> (name, image, token settings and package items only; HP, XP, level, conditions, player items, notes, ownership, folders and other modules' data are always kept. Off: actors already in the world are kept as they are)</label>{{/if}}{{/if}}
    <div class="agmanager-row">
      <button type="button" data-ag-action="preview" {{#unless hasPackage}}disabled{{/unless}}><i class="fa-solid fa-shield-halved"></i> Validate &amp; Preview</button>
      <button type="button" data-ag-action="select" class="agmanager-muted" {{#unless hasPreview}}disabled{{/unless}}>Select eligible</button>
      <button type="button" data-ag-action="clear" class="agmanager-muted" {{#unless hasPreview}}disabled{{/unless}}>Deselect all</button>
    </div>
    <p class="agmanager-tiny">Folder destinations: <code>foundry.folder_path</code> (e.g. <code>Ashen Gate/Professions/Recipes</code>). Explicit links: <code>[[AGREF:MAT-EXAMPLE|Material]]</code> (provisional, pending Tim confirmation). Missing/ambiguous UUID targets are reported in History.</p>
    <p class="agmanager-tiny">Importer accepts versioned Foundry projection JSON, or a ZIP with one valid projection. Locations and campaign state remain with their specialist modules. Imported Macros are not executed.</p>
    <p class="agmanager-notice">{{message}}</p>
    {{#if hasImportReports}}
    <section class="agmanager-result-panel" aria-label="Import results" aria-live="polite">
      <div class="agmanager-row agmanager-row-wrap"><h3>Import results</h3><button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="clear-results">Clear results</button></div>
      {{#each importReports}}
      <article class="agmanager-result agmanager-result-{{tone}}">
        <header><span class="ag-badge {{#if isError}}ag-badge--danger{{else}}{{#if isWarn}}ag-badge--warn{{else}}ag-badge--ok{{/if}}{{/if}}">{{toneLabel}}</span> <strong>{{file}}</strong> <small>{{at}}</small></header>
        <p class="agmanager-result-headline">{{headline}}</p>
        {{#each notes}}<p class="agmanager-tiny">{{this}}</p>{{/each}}
        {{#each sections}}
        <div class="agmanager-result-module">
          <h4>{{module}} <small>{{countText}}</small></h4>
          {{#if where}}<p class="agmanager-tiny"><strong>Find it:</strong> {{where}}</p>{{/if}}
          <ul>
            {{#each lines}}
            <li class="agmanager-result-line agmanager-line-{{outcome}}"><span class="agmanager-badge">{{label}}</span> {{#if name}}{{name}} {{/if}}{{#if id}}<code>{{id}}</code>{{/if}}{{#if message}} — {{message}}{{/if}}{{#if fix}}<br><strong>Fix:</strong> {{fix}}{{/if}}</li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
      </article>
      {{/each}}
    </section>
    {{/if}}
    {{#if hasWarnings}}<div class="agmanager-warnings"><strong>Import review notes</strong><ul>{{#each warnings}}<li>{{message}}</li>{{/each}}</ul></div>{{/if}}
    {{#if hasErrors}}
      <div class="agmanager-errors"><strong>Validation failed — import blocked</strong><ul>{{#each errors}}<li>{{message}}</li>{{/each}}</ul></div>
    {{/if}}
  </div>

  {{#if hasPreview}}
  <div class="agmanager-panel agmanager-results">
    <div class="agmanager-summary">
      <span class="new"><strong>{{summary.create}}</strong> new</span>
      <span class="update"><strong>{{summary.update}}</strong> update</span>
      <span class="update"><strong>{{summary.metadata}}</strong> metadata refresh</span>
      <span><strong>{{summary.unchanged}}</strong> unchanged</span>
      <span class="conflict"><strong>{{summary.conflict}}</strong> conflict</span>
      <span class="blocked"><strong>{{summary.blocked}}</strong> blocked</span>
      <span><strong>{{summary.skipped}}</strong> excluded</span>
      <span><strong>{{summary.local}}</strong> local edits</span>
    </div>
    <div class="agmanager-table-scroll">
    <table class="agmanager-table">
      <thead><tr><th>Apply?</th><th>ID / Name</th><th>Type</th><th>Status</th><th>Reason</th></tr></thead>
      <tbody>
      {{#each rows}}
      <tr>
        <td><input type="checkbox" data-ag-select="{{id}}" {{#if selected}}checked{{/if}} {{#unless canSelect}}disabled{{/unless}} aria-label="Select {{name}}" /></td>
        <td><strong>{{name}}</strong><code>{{id}}</code></td>
        <td>{{kind}}<div class="agmanager-tiny">{{lifecycle}}</div></td>
        <td><span class="agmanager-badge agmanager-{{action}}">{{badge}}</span></td>
        <td>{{reason}}{{#if changes.length}}<ul class="agmanager-changes">{{#each changes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</td>
      </tr>
      {{/each}}
      </tbody>
    </table>
    </div>
    <div class="agmanager-footer">
      <div><strong>GM-controlled.</strong> New Actors, Tables and Macros can be created. Existing Actors change only with <strong>Update existing actors</strong> ticked; character progress is never overwritten. Back up your test world first.
        {{#if actorUpdateCount}}<div><button type="button" data-ag-action="backup-actors"><i class="fa-solid fa-download"></i> Download backup of {{actorUpdateCount}} actor(s) to update</button></div>{{/if}}</div>
      <button type="button" data-ag-action="apply" class="agmanager-primary" {{#unless canApply}}disabled{{/unless}}>
        <i class="fa-solid fa-check"></i> Import Selected Documents
      </button>
    </div>
  </div>
  {{/if}}
  {{/if}}

  {{#if libraryActive}}
  <div class="aglib">
    <nav class="aglib-rail" aria-label="Library sections">
      {{#each librarySections}}<button type="button" class="aglib-rail__tab {{#if active}}active{{/if}}" data-ag-library-section-tab="{{id}}" title="{{label}}" aria-label="{{label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}"><i class="{{icon}}" aria-hidden="true"></i></button>{{/each}}
    </nav>
    <div class="aglib-main">
    {{#if libraryRecordsActive}}
    <div class="aglib-split">
      <section class="aglib-list" aria-label="Managed records">
        <div class="aglib-tools">
          <input type="search" class="aglib-search" data-ag-library-filter value="{{librarySearch}}" placeholder="Search name, ID, package, type" aria-label="Search records" />
          <div class="aglib-chips" role="group" aria-label="System">
            {{#each librarySystemChips}}<button type="button" class="aglib-chip {{#if selected}}active{{/if}}" data-ag-library-system-chip="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{label}} <span class="aglib-num">{{count}}</span></button>{{/each}}
          </div>
          <details class="aglib-filters" {{#if libraryHasFilters}}open{{/if}}>
            <summary>More filters{{#if libraryHasFilters}} <span class="ag-badge ag-badge--accent">{{libraryFilterCount}}</span>{{/if}}</summary>
            <div class="aglib-filter-grid">
              <label>Status <select data-ag-library-status>{{#each libraryStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
              <label>Package <select data-ag-library-package>{{#each libraryPackageOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
              <label class="aglib-check"><input type="checkbox" data-ag-library-show-archived {{#if libraryShowArchived}}checked{{/if}}> Show archived</label>
            </div>
          </details>
          <div class="aglib-count"><span>{{libraryFilteredCount}} of {{libraryTotal}} records</span><span>{{libraryEditedCount}} edited · {{libraryActiveCount}} active</span></div>
        </div>
        <div class="aglib-rows">
          {{#each libraryGroups}}
          <div class="aglib-group"><span>{{label}}</span><span class="aglib-num">{{count}}</span></div>
          {{#each rows}}<div class="aglib-row {{#if focused}}is-focused{{/if}}">
            <input type="checkbox" data-ag-library-select="{{uuid}}" {{#if selected}}checked{{/if}} aria-label="Select {{name}}" />
            <button type="button" class="aglib-row__main" data-ag-library-inspect="{{uuid}}" {{#if focused}}aria-current="true"{{/if}}>
              <span class="aglib-row__name">{{name}}</span>
              <span class="aglib-row__meta"><code>{{sourceId}}</code><span class="aglib-pill aglib-status-{{status}}">{{status}}</span>{{#if archived}}<span class="aglib-pill aglib-pill--danger">archived</span>{{/if}}{{#if version}}<span class="aglib-pill">v{{version}}</span>{{/if}}{{#if edited}}<span class="aglib-pill aglib-pill--warn">{{edited}} edit(s)</span>{{/if}}</span>
            </button>
          </div>{{/each}}
          {{else}}<p class="ag-empty aglib-empty">No matching managed records. Clear the search or filters, or import an Ashen Gate package first.</p>{{/each}}
        </div>
        <div class="aglib-selbar">
          {{#if hasLibrarySelected}}<strong class="aglib-num">{{librarySelectedCount}} selected</strong>
          <details class="aglib-menu">
            <summary class="ag-btn ag-btn--sm">Actions <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
            <div class="aglib-menu__pop" role="menu">
              <button type="button" role="menuitem" data-ag-action="library-export"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export selected / local edits</button>
              <button type="button" role="menuitem" data-ag-action="library-replace"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Replace from loaded JSON</button>
              <button type="button" role="menuitem" data-ag-action="library-stage"><i class="fa-solid fa-box-archive" aria-hidden="true"></i> Copy to staging compendium</button>
              <hr>
              <button type="button" role="menuitem" data-ag-action="library-archive"><i class="fa-solid fa-folder-minus" aria-hidden="true"></i> Archive</button>
              <button type="button" role="menuitem" data-ag-action="library-restore"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i> Restore</button>
              <hr>
              <button type="button" role="menuitem" data-ag-action="library-delete" class="aglib-danger"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete archived… <small>asks first</small></button>
            </div>
          </details>
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="library-clear">Clear</button>
          {{else}}<span class="agmanager-tiny">Tick records to act on them.</span>{{/if}}
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost aglib-end" data-ag-action="library-select-visible">Select shown</button>
        </div>
        <div class="aglib-pager">
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="library-previous" aria-label="Previous page" {{#unless libraryHasPrevious}}disabled{{/unless}}><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
          <span class="aglib-num">{{libraryPageLabel}}</span>
          <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="library-next" aria-label="Next page" {{#unless libraryHasNext}}disabled{{/unless}}><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
        </div>
      </section>
      <section class="aglib-detail" aria-label="Selected library document details">
        {{#if libraryHasDetail}}
        <div class="aglib-detail__head">
          <div class="aglib-detail__title"><h3>{{libraryDetail.name}}</h3>
            <div class="aglib-row__meta"><code>{{libraryDetail.sourceId}}</code><span class="aglib-pill aglib-status-{{libraryDetail.status}}">{{libraryDetail.status}}</span><span class="aglib-pill">{{libraryDetail.kind}} · {{libraryDetail.entityType}}</span>{{#if libraryDetail.archived}}<span class="aglib-pill aglib-pill--danger">archived</span>{{/if}}{{#if libraryDetail.edited}}<span class="aglib-pill aglib-pill--warn">{{libraryDetail.edited}} local edit(s)</span>{{/if}}</div>
          </div>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-library-open="{{libraryDetail.uuid}}"><i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Open sheet</button>
          <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="library-inspect-clear" aria-label="Close details"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        <div class="aglib-kv">
          <div><span>System</span><strong>{{libraryDetail.systemLabel}}</strong></div>
          <div><span>Version</span><strong class="aglib-num">{{libraryDetail.version}}</strong></div>
          <div><span>Package</span><strong>{{libraryDetail.packageId}}</strong></div>
          <div><span>Visibility</span><strong>{{libraryDetail.visibility}}</strong></div>
          <div><span>Scope</span><strong>{{libraryDetail.scope}}</strong></div>
          <div><span>References</span><strong class="aglib-num">{{libraryDetail.refCount}} out · {{libraryDetail.inboundCount}} in</strong></div>
          <div class="aglib-kv__wide"><span>Foundry UUID</span><code>{{libraryDetail.uuid}}</code></div>
        </div>
        <div class="aglib-refs">
          <div><h4>Uses <span class="aglib-num">({{libraryDetail.refCount}})</span></h4>
            {{#each libraryDetail.outgoing}}<div class="aglib-ref">
              {{#if uuid}}<button type="button" class="aglib-link" data-ag-library-jump="{{uuid}}">{{name}}</button>{{else}}<span class="aglib-missing">Not in this world</span>{{/if}}
              <code>{{targetId}}</code><span class="agmanager-tiny">{{relation}} · {{mode}}</span></div>
            {{else}}<p class="agmanager-tiny">No outgoing typed references.</p>{{/each}}
          </div>
          <div><h4>Used by <span class="aglib-num">({{libraryDetail.inboundCount}})</span></h4>
            {{#each libraryDetail.incoming}}<div class="aglib-ref"><button type="button" class="aglib-link" data-ag-library-jump="{{uuid}}">{{name}}</button>
              <code>{{sourceId}}</code><span class="agmanager-tiny">{{relation}}</span></div>
            {{else}}<p class="agmanager-tiny">No managed records link to this ID.</p>{{/each}}
          </div>
        </div>
        {{#if libraryDetail.editedFields.length}}<div><h4>Local edits <span class="aglib-num">({{libraryDetail.edited}})</span></h4><p class="agmanager-tiny aglib-wrap">{{#each libraryDetail.editedFields}}<code>{{this}}</code> {{/each}}</p><p class="agmanager-tiny">Re-import keeps these. Replace from loaded JSON overwrites them.</p></div>{{/if}}
        <p class="agmanager-tiny aglib-wrap">Source: {{libraryDetail.provenanceSummary}}</p>
        {{else}}
        <div class="ag-empty aglib-empty"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><p>Choose a record to see its details, references and local edits.</p>
          <p class="agmanager-tiny">Only Manager-managed world documents appear here. Live Profession Ledger, Skill Tree and other campaign state stays in those modules. Unclassified / Shared is used where content ownership is ambiguous.</p></div>
        {{/if}}
        <p class="aglib-status" role="status">{{libraryMessage}}</p>
      </section>
    </div>
    {{/if}}

    {{#if libraryCheckActive}}
    <section class="ag-card aglib-section" aria-label="Check library">
      <h3>Check library</h3>
      <p class="agmanager-tiny">Looks for missing references, duplicate IDs and other problems in managed records. Read-only.</p>
      <div class="aglib-actions"><button type="button" class="ag-btn ag-btn--primary" data-ag-action="library-check"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Check library</button></div>
      {{#if hasAudit}}<div class="agmanager-audit" aria-label="Library check results">
      {{#each audit}}<div class="agmanager-auditrow agmanager-{{level}}"><span>{{level}}</span> {{message}}</div>{{/each}}
      </div>{{/if}}
      <p class="aglib-status" role="status">{{libraryMessage}}</p>
    </section>
    {{/if}}

    {{#if libraryExportActive}}
    <section class="ag-card aglib-section agmanager-worldexport" aria-label="Export Ashen Gate data">
      <h3>Export Ashen Gate data</h3>
      <p class="agmanager-tiny">One JSON file of all Ashen Gate tagged world records plus the other modules' definitions (no play state). GM only.</p>
      <div class="aglib-actions">
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="world-export-everything"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export everything</button>
        <button type="button" class="ag-btn" data-ag-action="world-backup" title="Saves everything as AG_Backup_&lt;date&gt;.json. Does not change what counts as changed since last export."><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Back up before play</button>
        <details class="aglib-menu">
          <summary class="ag-btn">More <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
          <div class="aglib-menu__pop" role="menu">
            <button type="button" role="menuitem" data-ag-action="world-export-changed"><i class="fa-solid fa-file-circle-exclamation" aria-hidden="true"></i> Export changed since last export</button>
            <button type="button" role="menuitem" data-ag-action="world-export-copy"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy summary</button>
          </div>
        </details>
      </div>
      {{#if worldExportSummary}}<pre class="agmanager-tiny agmanager-worldexport-summary">{{worldExportSummary}}</pre>{{/if}}
      <p class="agmanager-tiny">To export only some records with their local edits, tick them under Records and use <strong>Actions → Export selected / local edits</strong>.</p>
    </section>
    {{/if}}

    {{#if libraryAdoptActive}}
    <section class="ag-card aglib-section agmanager-adopt" aria-label="Adopt and export world Items for review">
    <h3>Adopt &amp; export world Items for review</h3>
    <p>Assign <strong>review tags</strong> to world Items without editing their contents. A tag records a stable capture ID and suggested classification; <strong>it does not approve a record or make it importer-managed.</strong></p>
    <div class="agmanager-package">
      <div><span>World Items</span><strong class="aglib-num">{{worldItemCount}}</strong></div>
      <div><span>Tagged for review</span><strong class="aglib-num">{{taggedCount}}</strong></div>
      <div><span>Visible rows</span><strong class="aglib-num">{{captureVisibleCount}}</strong></div>
    </div>
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-search-label">Find Item <input type="search" data-ag-capture-filter value="{{captureSearch}}" placeholder="Name or type" /></label>
      <label class="agmanager-toggle"><input type="checkbox" data-ag-capture-tagged-only {{#if captureTaggedOnly}}checked{{/if}}> Tagged only</label>
      <button type="button" data-ag-action="capture-select-visible">Select visible</button>
      <button type="button" data-ag-action="capture-clear" class="agmanager-muted">Clear selection</button>
    </div>
    <div class="agmanager-table-scroll agmanager-captures-scroll">
      <table class="agmanager-table">
        <thead><tr><th>Select</th><th>Item / Foundry UUID</th><th>Item type</th><th>Capture status</th></tr></thead>
        <tbody>
          {{#each captureRows}}
          <tr>
            <td><input type="checkbox" data-ag-capture-select="{{id}}" {{#if selected}}checked{{/if}} aria-label="Select {{name}}" /></td>
            <td><strong>{{name}}</strong><code>{{uuid}}</code></td>
            <td>{{type}}</td>
            <td>{{#if tagged}}<span class="agmanager-badge agmanager-captured">TAGGED</span> {{kindLabel}}<code>{{capture.captureId}}</code>{{else}}<span class="agmanager-badge">Not tagged</span>{{/if}}{{#if source}}<div class="agmanager-tiny">Imported binding: {{source.sourceId}}</div>{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <div class="agmanager-row agmanager-row-wrap">
      <label class="agmanager-search-label">Classify selected as
        <select data-ag-capture-kind>
          {{#each captureKindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
        </select>
      </label>
      <button type="button" data-ag-action="capture-tag" {{#unless hasCaptureSelected}}disabled{{/unless}}><i class="fa-solid fa-tag"></i> Tag selected</button>
      <button type="button" data-ag-action="capture-untag" class="agmanager-muted" {{#unless hasCaptureSelected}}disabled{{/unless}}>Remove selected tags</button>
    </div>
    <p class="agmanager-notice">{{captureMessage}}</p>
    <div class="agmanager-footer agmanager-capture-footer">
      <div>Exports <strong>all tagged world Items</strong>, not just the visible/selected rows. Exported data is <strong>unreviewed</strong> until reconciled for the repo. No Actors or macros are included.</div>
      <button type="button" class="agmanager-primary" data-ag-action="capture-export" {{#unless canCaptureExport}}disabled{{/unless}}><i class="fa-solid fa-file-export"></i> Export all tagged Items (JSON)</button>
    </div>
    <p class="agmanager-tiny">Export includes system rules, active effects and other module flags. Review copyright/third-party content and hidden GM details before uploading.</p>
    </section>
    {{/if}}
    {{#if libraryCodexActive}}
    <div class="aglib-split agcodex">
      <section class="aglib-list" aria-label="NPCs">
        <div class="aglib-tools">
          <input type="search" class="aglib-search" data-ag-codex-search value="{{codex.search}}" placeholder="Search NPC name, role, ID" aria-label="Search NPCs" />
          <div class="aglib-chips" role="group" aria-label="Show">
            <button type="button" class="aglib-chip {{#if codex.filterAll}}active{{/if}}" data-ag-codex-filter="all" aria-pressed="{{#if codex.filterAll}}true{{else}}false{{/if}}">All <span class="aglib-num">{{codex.total}}</span></button>
            <button type="button" class="aglib-chip {{#if codex.filterKnown}}active{{/if}}" data-ag-codex-filter="known" aria-pressed="{{#if codex.filterKnown}}true{{else}}false{{/if}}">Known to players <span class="aglib-num">{{codex.known}}</span></button>
            <button type="button" class="aglib-chip {{#if codex.filterHidden}}active{{/if}}" data-ag-codex-filter="hidden" aria-pressed="{{#if codex.filterHidden}}true{{else}}false{{/if}}">Hidden <span class="aglib-num">{{codex.hidden}}</span></button>
          </div>
        </div>
        <div class="aglib-rows">
          {{#each codex.rows}}<button type="button" class="agcodex-row {{#if focused}}is-focused{{/if}}" data-ag-codex-focus="{{id}}" {{#if focused}}aria-current="true"{{/if}}>
            {{#if img}}<img class="agcodex-portrait" src="{{img}}" alt="">{{else}}<span class="agcodex-portrait" aria-hidden="true">{{initials}}</span>{{/if}}
            <span class="agcodex-row__text"><span class="aglib-row__name">{{name}}</span>
              <span class="aglib-row__meta">{{#if role}}<span class="agmanager-tiny">{{role}}</span>{{/if}}<span class="aglib-pill {{#if discovery.party}}aglib-status-active{{/if}}">{{discoveryLabel}}</span>{{#if revealedCount}}<span class="aglib-pill aglib-num">{{revealedCount}} field(s)</span>{{/if}}</span></span>
          </button>{{else}}<p class="ag-empty aglib-empty">No NPCs here. NPC records (<code>entity_type: "NPC"</code>) appear once imported on the Import tab.</p>{{/each}}
        </div>
        <div class="aglib-selbar">
          <details class="aglib-menu">
            <summary class="ag-btn ag-btn--sm">Codex <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
            <div class="aglib-menu__pop" role="menu">
              <button type="button" role="menuitem" data-ag-action="codex-export"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Export codex (GM file)</button>
              <label class="agcodex-filelabel" role="menuitem" tabindex="0"><i class="fa-solid fa-file-import" aria-hidden="true"></i> Restore reveals from a codex export… <input type="file" accept=".json,application/json" data-ag-codex-import hidden></label>
              <hr>
              <button type="button" role="menuitem" data-ag-action="codex-player-view"><i class="fa-solid fa-eye" aria-hidden="true"></i> Open the player view</button>
            </div>
          </details>
          <span class="agmanager-tiny aglib-end">{{#if codex.playerAccess}}Shared with players{{else}}Not shared with players (GM Setup){{/if}}</span>
        </div>
      </section>
      <section class="aglib-detail" aria-label="NPC details">
        {{#with codex.detail}}
        <div class="aglib-detail__head">
          {{#if img}}<img class="agcodex-portrait agcodex-portrait--lg" src="{{img}}" alt="">{{else}}<span class="agcodex-portrait agcodex-portrait--lg" aria-hidden="true">{{initials}}</span>{{/if}}
          <div class="aglib-detail__title"><h3>{{name}}</h3>
            <div class="aglib-row__meta"><code>{{id}}</code>{{#if status}}<span class="aglib-pill">{{status}}</span>{{/if}}</div></div>
          <button type="button" class="ag-btn" data-ag-action="codex-open-actor"><i class="fa-solid fa-user" aria-hidden="true"></i> Actor sheet</button>
          <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="codex-close" aria-label="Close details"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        <div class="agcodex-field agcodex-field--discovery">
          <div><div class="agcodex-label">Players know this NPC</div><p class="agmanager-tiny">Name and portrait. Nothing else shows to a player until this includes them.</p></div>
          {{#with discoverySeg}}<div class="agcodex-control"><div class="agcodex-seg" role="group" aria-label="Who knows: {{label}}">
            <button type="button" class="{{#if isHidden}}is-on{{/if}}" data-ag-codex-reveal="{{key}}" data-mode="hidden" aria-pressed="{{#if isHidden}}true{{else}}false{{/if}}">Hidden</button>
            <button type="button" class="{{#if isParty}}is-on is-party{{/if}}" data-ag-codex-reveal="{{key}}" data-mode="party" aria-pressed="{{#if isParty}}true{{else}}false{{/if}}">Party</button>
            <details class="aglib-menu agcodex-chars"><summary class="{{#if isActors}}is-on is-actors{{/if}}">Characters <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
              <div class="aglib-menu__pop agcodex-chars__pop">{{#each chars}}<label><input type="checkbox" data-ag-codex-actor="{{../key}}" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{else}}<p class="agmanager-tiny">No player characters yet (character Actors with a player owner).</p>{{/each}}</div>
            </details></div>
            {{#if isActors}}<p class="agcodex-who">Known by {{who}}</p>{{/if}}</div>{{/with}}
        </div>
        {{#each fields}}
        <div class="agcodex-field">
          <div class="agcodex-field__body"><div class="agcodex-label">{{label}}</div>
            {{#if isLinks}}{{#if ../links.length}}<div class="agcodex-links">{{#each ../links}}<span class="agcodex-link agcodex-link--{{kind}}">{{name}}{{#if named}} <code>{{id}}</code>{{/if}}</span>{{/each}}</div>{{else}}<p class="agmanager-tiny">No connections. Add ids below or in the record's <code>codex.links</code>.</p>{{/if}}
            {{else}}{{#if empty}}<p class="agmanager-tiny">Not set.</p>{{else}}<p class="agcodex-value">{{value}}</p>{{/if}}{{/if}}
          </div>
          <div class="agcodex-control"><div class="agcodex-seg" role="group" aria-label="Who knows: {{label}}">
            <button type="button" class="{{#if isHidden}}is-on{{/if}}" data-ag-codex-reveal="{{key}}" data-mode="hidden" aria-pressed="{{#if isHidden}}true{{else}}false{{/if}}">Hidden</button>
            <button type="button" class="{{#if isParty}}is-on is-party{{/if}}" data-ag-codex-reveal="{{key}}" data-mode="party" aria-pressed="{{#if isParty}}true{{else}}false{{/if}}">Party</button>
            <details class="aglib-menu agcodex-chars"><summary class="{{#if isActors}}is-on is-actors{{/if}}">Characters <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
              <div class="aglib-menu__pop agcodex-chars__pop">{{#each chars}}<label><input type="checkbox" data-ag-codex-actor="{{../key}}" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{else}}<p class="agmanager-tiny">No player characters yet (character Actors with a player owner).</p>{{/each}}</div>
            </details></div>
            {{#if isActors}}<p class="agcodex-who">Known by {{who}}</p>{{/if}}</div>
        </div>
        {{/each}}
        <div class="agcodex-gm">
          <h4><i class="fa-solid fa-lock" aria-hidden="true"></i> GM only: never sent to players</h4>
          {{#each gmFields}}<div class="agcodex-gmrow"><span class="agcodex-label">{{label}}</span>{{#if items}}<ul class="agcodex-value">{{#each items}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p class="agcodex-value">{{text}}</p>{{/if}}</div>{{else}}<p class="agmanager-tiny">The record has no portrayal, session role, stat block or GM notes.</p>{{/each}}
        </div>
        <div class="agcodex-edit">
          <label class="ag-field">What the party has learned <textarea rows="3" data-ag-codex-learned>{{learned}}</textarea></label>
          <label class="ag-field">Connections (ids, space separated: LOC-, FAC-, QUEST-, NPC-) <input type="text" data-ag-codex-links value="{{linksText}}"></label>
          <label class="ag-field">Your notes (GM only) <textarea rows="3" data-ag-codex-notes>{{notes}}</textarea></label>
          <footer class="agcodex-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="codex-cancel">Cancel</button>
            <button type="button" class="ag-btn aglib-danger" data-ag-action="codex-hide-all"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide from players…</button>
            <button type="button" class="ag-btn ag-btn--primary" data-ag-action="codex-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Changes</button>
          </footer>
        </div>
        <div class="agcodex-preview">
          <label class="agcodex-preview__pick">Preview as <select data-ag-codex-preview>{{#each ../codex.previewOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{#if ../codex.previewing}}{{{../codex.previewHtml}}}{{else}}<p class="agmanager-tiny">Choose the party or a character to see exactly what they receive.</p>{{/if}}
        </div>
        {{else}}
        <div class="ag-empty aglib-empty"><i class="fa-solid fa-address-book" aria-hidden="true"></i><p>Choose an NPC to set who knows what.</p>
          <p class="agmanager-tiny">Content comes from the imported NPC record. Reveals, what the party has learned, connections and your notes are kept on re-import.</p></div>
        {{/with}}
        <p class="aglib-status" role="status">{{codex.message}}</p>
      </section>
    </div>
    {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if modulesActive}}
  <div class="agmanager-panel">
    <section class="ag-card agmanager-presession" aria-label="Pre-session check">
      <h3>Pre-session check</h3>
      <p class="agmanager-tiny">Checks module versions, GM storage, Player Access, [TEST] data, hidden names in player views, Locations migration and the Foundry version. Read-only: it never changes a document or setting. GM only.</p>
      <div class="agmanager-row agmanager-row-wrap">
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="presession-run"><i class="fa-solid fa-stethoscope"></i> Run pre-session check</button>
        <button type="button" class="ag-btn" data-ag-action="presession-copy" {{#unless preSession.hasText}}disabled{{/unless}}><i class="fa-solid fa-copy"></i> Copy report</button>
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="presession-download" {{#unless preSession.hasText}}disabled{{/unless}}><i class="fa-solid fa-download"></i> Download report</button>
      </div>
      {{#if preSession}}
      <p class="agmanager-presession-summary"><strong>{{preSession.summary}}</strong></p>
      <div class="agmanager-presession-rows">
      {{#each preSession.rows}}<div class="agmanager-presession-row agmanager-presession-{{css}}"><span class="agmanager-presession-status">{{status}}</span><span class="agmanager-presession-check">{{check}}</span><span>{{text}}</span></div>{{/each}}
      </div>
      {{/if}}
    </section>
    <h3>Ashen Gate Modules <span class="agmanager-beta">BETA</span></h3>
    <p>Open other Ashen Gate modules from one place. The Manager discovers <strong>installed modules</strong> and uses their published <code>api.open()</code> launcher or registered Foundry settings window; it doesn't assume a module has an interface.</p>
    <div class="agmanager-module-grid">
    {{#each launcherRows}}
      <article class="agmanager-module-card">
        <div><h4>{{title}}</h4><code>{{id}}</code><p class="agmanager-tiny">v{{version}} · {{state}} · Player access: {{playerAccessState}} (GM launcher remains available)</p><p class="agmanager-tiny">{{role}}</p></div>
        <button type="button" data-ag-module-open="{{id}}" {{#unless canOpen}}disabled{{/unless}}>Open</button>
      </article>
    {{else}}<p>No other Ashen Gate modules were detected in this world. Enable a module and reopen this tab.</p>
    {{/each}}
    </div>
    <p class="agmanager-tiny">Disabled means the module is inactive or has not exposed an Open API / settings menu. Other workstreams can support direct opening by exposing <code>game.modules.get(moduleId).api.open()</code>. This tab never installs, enables or changes another module.</p>
  </div>
  {{/if}}

  {{#if appearanceActive}}
  <div class="agmanager-panel agmanager-appearance">
    <h3>Appearance <span class="agmanager-beta">GM world default</span></h3>
    <p>Choose the default skin for every player who has not picked their own (players see it live; anyone who has not reloaded since a module update needs one refresh, F5). Colour skins change interface colours; Stone Tablet and Tome Pages also reshape panels, tabs and buttons. It never changes Player Access, Actor progress, permissions or content.</p>
    <div class="agmanager-row agmanager-row-wrap">
      <div class="ag-skin-picker" role="radiogroup" aria-label="Ashen Gate world default appearance" data-ag-skin-picker="world">
        {{#each appearanceSkinRows}}<button type="button" role="radio" class="ag-skin-card{{#if selected}} is-selected{{/if}}" aria-checked="{{#if selected}}true{{else}}false{{/if}}" tabindex="{{#if selected}}0{{else}}-1{{/if}}" data-ag-skin-value="{{id}}" aria-describedby="ag-wskin-desc-{{id}}"><span class="ag-swatch" aria-hidden="true">{{#each swatch}}<i style="background:{{this}}"></i>{{/each}}</span><span class="ag-skin-card__text"><span class="ag-skin-card__name">{{label}}</span><small id="ag-wskin-desc-{{id}}" class="ag-my-appearance-desc">{{description}}</small></span></button>{{/each}}
      </div>
      <button type="button" class="ag-btn ag-btn--primary" data-ag-action="appearance-save-world" {{#if busy}}disabled{{/if}}>Save World Default</button>
      <button type="button" data-ag-action="appearance-my-appearance" class="agmanager-muted">Open My Appearance</button>
    </div>
    <p role="status" class="agmanager-notice">{{appearanceMessage}}</p>
    <p class="agmanager-tiny">Effective on your screen: {{appearanceCurrent.effective}} · Your override: {{#if appearanceCurrent.userOverride}}{{appearanceCurrent.userOverride}}{{else}}Inherit GM default{{/if}}</p>
    <p class="agmanager-tiny">For all players: Foundry Game Settings → <strong>Ashen Gate | My Appearance</strong>. The separate player-safe screen cannot open this GM-only Manager.</p>
    <section class="agmanager-access-compact" aria-label="Player module access">
      <h4>Player access <span class="agmanager-beta">show or hide modules from players</span></h4>
      <div class="agmanager-row agmanager-row-wrap agmanager-access-actions">
        <button type="button" data-ag-action="player-access-refresh" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Refresh</button>
        <button type="button" data-ag-action="player-access-hide-all" {{#unless playerAccessHasVisible}}disabled{{/unless}}><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide all ({{playerAccessVisibleCount}})</button>
      </div>
      <p class="agmanager-notice" role="status">{{playerAccessMessage}}</p>
      <ul class="agmanager-access-list">
        {{#each playerAccessRows}}
        <li title="{{reason}}"><span class="agmanager-access-name"><strong>{{title}}</strong> <span class="agmanager-access-version">v{{version}}</span></span>
          <span class="agmanager-access-state">{{state}}</span>
          {{#if canToggle}}
            {{#if playerAccessEnabled}}<button type="button" data-ag-player-access-toggle="{{id}}" data-ag-player-access-enabled="false" {{#if @root.busy}}disabled{{/if}} aria-label="Hide {{title}} from players">Hide</button>
            {{else}}<button type="button" data-ag-player-access-toggle="{{id}}" data-ag-player-access-enabled="true" {{#if @root.busy}}disabled{{/if}} aria-label="Show {{title}} to players">Show</button>{{/if}}
          {{else}}<span class="agmanager-tiny">{{reason}}</span>{{/if}}
        </li>
        {{else}}<li>No Ashen Gate modules detected.</li>{{/each}}
      </ul>
      {{#if playerAccessReport}}
        <details open class="agmanager-access-report"><summary>Hide all: {{playerAccessReport.changed.length}} hidden; {{playerAccessReport.failed.length}} failed; {{playerAccessReport.skipped.length}} skipped</summary>
          {{#each playerAccessReport.failed}}<p class="agmanager-missing">Failed: {{title}} — {{error}}</p>{{/each}}
          {{#each playerAccessReport.skipped}}<p>Skipped: {{title}} ({{reason}})</p>{{/each}}
        </details>
      {{/if}}
      <p class="agmanager-tiny">Each module saves its own setting. Needs <code>ag-player-access/1</code>; older modules show Unsupported. Hiding never deletes progress.</p>
    </section>
  </div>
  {{/if}}

  {{#if browseActive}}
  <div class="agmanager-panel agbrowse" data-ag-browse></div>
  {{/if}}

  {{#if scenesActive}}
  <div class="agmanager-panel agmanager-moods">
    <section class="ag-card" aria-label="Scene mood">
      <div class="agmanager-row agmanager-row-wrap agmanager-moods-head">
        <div><h3>Scene moods <span class="agmanager-beta">GM only</span></h3>
        <p class="agmanager-moods-now"><strong>{{moods.sceneName}}</strong> — {{moods.moodLabel}}</p></div>
        <label>Scene <select data-ag-mood-scene>
          <option value="" {{#if moods.currentSelected}}selected{{/if}}>Current scene (viewed, else active)</option>
          {{#each moods.scenes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select></label>
      </div>
      <div class="agmanager-mood-buttons" role="group" aria-label="Apply a mood">
        {{#each moods.presets}}<button type="button" class="ag-btn{{#if active}} ag-btn--primary{{/if}}" data-ag-mood-apply="{{id}}" {{#unless @root.moods.hasScene}}disabled{{/unless}} aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="mood-restore" {{#unless moods.hasBase}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Back to normal</button>
      </div>
      <label class="agmanager-toggle"><input type="checkbox" data-ag-mood-animate {{#if moods.animate}}checked{{/if}}> Fade darkness over 3 seconds (if this Foundry supports it)</label>
      {{#if moods.darknessLock}}<p class="agmanager-tiny"><strong>Darkness is locked on this scene</strong> (Scene config), so Foundry may keep its darkness.</p>{{/if}}
      <p class="agmanager-tiny" role="status">{{moods.message}}</p>
      <p class="agmanager-tiny">Everyone on the scene sees the change. Weather effects can slow weaker player machines: give a mood <strong>No weather</strong> if that happens. Uses core Foundry lighting and weather only.</p>
    </section>

    <section class="ag-card" aria-label="Mood presets">
      <div class="agmanager-row agmanager-row-wrap"><h3>Mood presets</h3><button type="button" class="ag-btn" data-ag-action="mood-new"><i class="fa-solid fa-plus"></i> Add mood</button></div>
      <div class="agmanager-mood-list">
      {{#each moods.presets}}
        <div class="agmanager-mood-row">
          <div><strong>{{label}}</strong> {{#if isDefault}}<span class="ag-badge">Default</span>{{/if}}<div class="agmanager-tiny">{{summary}}</div></div>
          <div class="agmanager-row"><button type="button" class="ag-btn ag-btn--sm" data-ag-mood-edit="{{id}}">Edit</button><button type="button" class="ag-btn ag-btn--sm ag-btn--danger" data-ag-mood-remove="{{id}}">Remove…</button></div>
        </div>
      {{/each}}
      </div>
      {{#unless moods.hasWeather}}<p class="agmanager-tiny"><strong>No weather effects found</strong> in this Foundry (CONFIG.weatherEffects is empty); moods that set weather will refuse to apply.</p>{{/unless}}
      <p class="agmanager-tiny">Defaults are a starting point; editing one makes it yours. <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="mood-reset">Reset moods to defaults…</button></p>
    </section>

    {{#if moods.edit}}
    <section class="ag-card agmanager-mood-editor" aria-label="Edit mood">
      <h3>{{#if moods.edit.isNew}}New mood{{else}}Edit mood: {{moods.edit.label}}{{/if}}</h3>
      <div class="agmanager-row agmanager-row-wrap">
        {{#if moods.edit.isNew}}<label>Id <input type="text" data-ag-mood-id value="{{moods.edit.id}}" placeholder="e.g. foggy-dawn" maxlength="40"></label>{{/if}}
        <label>Label <input type="text" data-ag-mood-label value="{{moods.edit.label}}"></label>
      </div>
      <p class="agmanager-tiny">Tick the fields this mood sets. Unticked fields are left as the scene has them.</p>
      <div class="agmanager-mood-fields">
      {{#each moods.edit.fields}}
        <label class="agmanager-mood-field"><input type="checkbox" data-ag-mood-use="{{path}}" {{#if used}}checked{{/if}}> <span>{{label}}</span>
          {{#if isNumber}}<input type="number" data-ag-mood-value="{{path}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}"> <small>{{min}} to {{max}}</small>{{/if}}
          {{#if isBoolean}}<input type="checkbox" data-ag-mood-value="{{path}}" {{#if checked}}checked{{/if}}> <small>on</small>{{/if}}
          {{#if isWeather}}<select data-ag-mood-value="{{path}}">{{#each weatherOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
        </label>
      {{/each}}
      </div>
      <footer class="agmanager-row agmanager-mood-footer">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="mood-cancel">Cancel</button>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="mood-save"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
      </footer>
    </section>
    {{/if}}
  </div>
  {{/if}}

  {{#if organizeActive}}
  <div class="agmanager-panel agmanager-organize">
    <section class="ag-card" aria-label="Organize folders">
      <h3>Organize folders <span class="agmanager-beta">GM only</span></h3>
      <div class="agmanager-row agmanager-row-wrap">
        <label>Where <select data-ag-org-source>{{#each org.sources}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{#each org.types}}<label class="agmanager-toggle"><input type="checkbox" data-ag-org-type="{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}
        <label>Move <select data-ag-org-mode>
          <option value="misfiled" {{#if org.modeMisfiled}}selected{{/if}}>Only unfiled and misfiled</option>
          <option value="all" {{#if org.modeAll}}selected{{/if}}>Refile everything (also from your own folders)</option>
        </select></label>
        <button type="button" class="ag-btn" data-ag-action="org-preview"><i class="fa-solid fa-magnifying-glass"></i> Preview</button>
      </div>
      <p class="agmanager-tiny" role="status">{{org.message}}</p>
      <p class="agmanager-tiny">Only the folder changes. Nothing is renamed, edited or deleted, and no folder is ever deleted. Player characters and player-owned actors stay where they are. Documents in a protected folder, or marked <strong>Keep here</strong>, are skipped. Locked, module and system compendiums are inspect-only.</p>
      <p class="agmanager-tiny">Default rules: Ashen Gate records go to <strong>Ashen Gate</strong>. Other Items go to <strong>Core 5.5e</strong> when they carry a core source tag (imported by Plutonium, or marked 2024 / PHB'24, DMG'24, MM'24, SRD 5.2, or 2014 core / PHB, DMG, MM, SRD 5.1); items with no source or a third-party or homebrew source go to <strong>Homebrew</strong>, with the same sub-folders. Your own saved rules are used instead if you have them.</p>

      {{#if org.preview}}
      <div class="agmanager-row agmanager-row-wrap">
        <span class="agmanager-chip">Would move: {{org.preview.totals.moves}}</span>
        <span class="agmanager-chip">New folders: {{org.preview.totals.createFolders}}</span>
        <span class="agmanager-chip">Already in place: {{org.preview.totals.inPlace}}</span>
        <span class="agmanager-chip">Skipped: {{org.preview.totals.skipped}}</span>
        <span class="agmanager-chip">No rule: {{org.preview.totals.unmatched}}</span>
      </div>
      {{#each org.preview.parts}}
      <div class="agmanager-org-part">
        <h4>{{label}} — {{moveCount}} to move</h4>
        {{#unless writable}}<p class="agmanager-warnings"><strong>Inspect only:</strong> {{blockedReason}}.</p>{{/unless}}
        {{#each groups}}
        <details class="agmanager-org-group"><summary><strong>{{path}}</strong> ({{count}})</summary>
          <table class="agmanager-table"><thead><tr><th>Document</th><th>From</th><th></th></tr></thead><tbody>
          {{#each rows}}<tr><td>{{name}}</td><td>{{from}}</td><td>{{#if @root.org.world}}<button type="button" class="ag-btn ag-btn--sm" data-ag-org-keep="{{id}}" data-ag-org-doctype="{{documentName}}" title="Never move this document">Keep here</button>{{/if}}</td></tr>{{/each}}
          </tbody></table>
        </details>
        {{/each}}
        {{#if hasCreates}}<details class="agmanager-org-group"><summary>Folders to create ({{createFolders.length}})</summary><ul>{{#each createFolders}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}
        {{#if hasSkipped}}<details class="agmanager-org-group"><summary>Skipped ({{skipped.length}})</summary><ul>{{#each skipped}}<li><strong>{{name}}</strong> in {{from}}{{#if to}} (rule says {{to}}){{/if}} — {{reason}}</li>{{/each}}</ul></details>{{/if}}
        {{#if hasUnmatched}}<details class="agmanager-org-group"><summary>No matching rule, left where they are ({{unmatched.length}})</summary><ul>{{#each unmatched}}<li><strong>{{name}}</strong> in {{from}}</li>{{/each}}</ul></details>{{/if}}
      </div>
      {{/each}}
      <footer class="agmanager-row agmanager-mood-footer">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="org-clear">Cancel</button>
        <span class="agmanager-row">
          <button type="button" class="ag-btn" data-ag-action="org-backup" {{#unless org.preview.totals.moves}}disabled{{/unless}}><i class="fa-solid fa-download"></i> Download backup</button>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-action="org-apply" {{#unless org.preview.canApply}}disabled{{/unless}}><i class="fa-solid fa-folder-tree"></i> Apply…</button>
        </span>
      </footer>
      {{/if}}
      {{#if org.result}}<p class="agmanager-tiny"><strong>Last apply:</strong> {{org.result.message}}</p>
        {{#if org.hasEmpty}}<details class="agmanager-org-group"><summary>Empty folders (report only, nothing deleted): {{org.result.emptyFolders.length}}</summary><ul>{{#each org.result.emptyFolders}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}{{/if}}
    </section>

    <section class="ag-card" aria-label="Organize history">
      <div class="agmanager-row agmanager-row-wrap"><h3>Recent organize runs</h3>
        <button type="button" class="ag-btn" data-ag-action="org-undo" {{#unless org.history.length}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Undo last organize…</button></div>
      {{#if org.history.length}}<ul>{{#each org.history}}<li>{{at}} · {{source}} · {{mode}} · {{moved}} moved</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">No organize runs yet. The last 5 are kept for Undo.</p>{{/if}}
    </section>

    {{#if org.world}}
    <section class="ag-card" aria-label="Protected folders">
      <h3>Protected folders</h3>
      <p class="agmanager-tiny">Organize never moves anything in a protected folder or its sub-folders.</p>
      <div class="agmanager-row agmanager-row-wrap">
        <select data-ag-org-folder aria-label="Folder to protect">{{#each org.openFolders}}<option value="{{id}}">{{label}}</option>{{/each}}</select>
        <button type="button" class="ag-btn" data-ag-org-protect><i class="fa-solid fa-lock"></i> Protect folder</button>
      </div>
      {{#if org.protectedFolders.length}}<ul>{{#each org.protectedFolders}}<li>{{label}} <button type="button" class="ag-btn ag-btn--sm" data-ag-org-unprotect="{{id}}">Unprotect</button></li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    <section class="ag-card" aria-label="Organize rules">
      <div class="agmanager-row agmanager-row-wrap"><h3>Rules {{#if org.schemaIsDefault}}<span class="ag-badge">Default</span>{{/if}}</h3>
        <span class="agmanager-row">
          <button type="button" class="ag-btn" data-ag-action="org-schema-edit"><i class="fa-solid fa-pen"></i> Edit rules (JSON)</button>
          <button type="button" class="ag-btn" data-ag-action="org-schema-export"><i class="fa-solid fa-download"></i> Export</button>
          <label class="ag-btn"><i class="fa-solid fa-upload"></i> Import <input type="file" accept=".json,application/json" data-ag-org-schema-file hidden></label>
        </span></div>
      <p class="agmanager-tiny">Checked top to bottom; the first rule that matches decides the folder. <code>{tier}</code>, <code>{rarity}</code>, <code>{spellLevel}</code>, <code>{creatureType}</code>, <code>{crBand}</code> and <code>{entityType}</code> fill in from the document; if one is empty the next rule is tried.</p>
      {{#if org.editing}}
        <textarea data-ag-org-schema-text rows="18" class="agmanager-org-json" aria-label="Organize rules JSON">{{org.schemaText}}</textarea>
        <footer class="agmanager-row agmanager-mood-footer">
          <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="org-schema-cancel">Cancel</button>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-action="org-schema-save"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
        </footer>
      {{else}}
      <table class="agmanager-table"><thead><tr><th>#</th><th>Rule</th><th>For</th><th>When</th><th>Folder</th></tr></thead><tbody>
        {{#each org.rules}}<tr><td>{{n}}</td><td>{{label}}</td><td>{{types}}</td><td><code>{{match}}</code></td><td>{{#if leave}}<em>leave where it is</em>{{else}}{{path}}{{/if}}</td></tr>{{/each}}
      </tbody></table>
      {{/if}}
      <p class="agmanager-tiny"><button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="org-schema-reset">Reset rules to defaults…</button></p>
    </section>

    <section class="ag-card" aria-label="Housekeeping report">
      <div class="agmanager-row agmanager-row-wrap"><h3>Housekeeping report</h3>
        <button type="button" class="ag-btn" data-ag-action="org-housekeeping"><i class="fa-solid fa-clipboard-list"></i> Run report</button></div>
      <p class="agmanager-tiny">Read-only. Lists Ashen Gate ids found more than once (world and all compendiums) and likely temporary records so you can decide. Nothing is changed or deleted.</p>
      {{#if org.report}}
        <h4>Duplicate ids ({{org.report.duplicates.length}})</h4>
        {{#if org.report.hasDuplicates}}<ul>{{#each org.report.duplicates}}<li><code>{{sourceId}}</code> ×{{count}}: {{#each rows}}{{name}} ({{where}}, {{documentName}}){{#unless @last}}; {{/unless}}{{/each}}</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">None.</p>{{/if}}
        <h4>Likely temporary ({{org.report.temporary.length}})</h4>
        {{#if org.report.hasTemporary}}<ul>{{#each org.report.temporary}}<li>{{name}} {{#if sourceId}}<code>{{sourceId}}</code>{{/if}} — {{where}}, {{why}}</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">None.</p>{{/if}}
        <p class="agmanager-tiny">Draft-status Ashen Gate records: {{org.report.draftCount}} (normal while content is in development).</p>
      {{/if}}
    </section>
  </div>
  {{/if}}

  {{#if coreLinksActive}}
  <div class="agmanager-panel agmanager-organize">
    <section class="ag-card" aria-label="Core links">
      <div class="agmanager-row agmanager-row-wrap"><h3>Core links <span class="agmanager-beta">GM only</span></h3>
        <button type="button" class="ag-btn" data-ag-action="cl-scan"><i class="fa-solid fa-magnifying-glass"></i> Scan</button></div>
      <p class="agmanager-tiny" role="status">{{cl.message}}</p>
      <p class="agmanager-tiny">Only Ashen Gate world Items whose source data has <code>core_ref</code> are checked. Matches come from 2024 (5.5e) content only: Plutonium-imported and other 2024 world items, world compendiums, the core sources in <strong>GM Setup</strong>, then the dnd5e 2024 packs. <strong>Adopt</strong> replaces the item's image and data (description included) with the core item's and keeps its name, Ashen Gate id, folder, ownership and module data. Copies in player inventories are never touched.</p>
      {{#if cl.preview}}
      <div class="agmanager-row agmanager-row-wrap">
        <span class="agmanager-chip">Core items found: {{cl.preview.poolSize}}</span>
        <span class="agmanager-chip">Ashen Gate items without core_ref (untouched): {{cl.preview.withoutRef}}</span>
        <span class="agmanager-chip">Ticked: {{cl.preview.tickedCount}}</span>
      </div>
      {{#each cl.preview.notes}}<p class="agmanager-warnings">{{this}}</p>{{/each}}
      {{#each cl.preview.groups}}
      <div class="agmanager-org-part">
        <h4>{{label}} ({{rows.length}})</h4>
        <table class="agmanager-table"><thead><tr><th></th><th>Ashen Gate item</th><th>core_ref</th><th>Core match</th><th>Notes</th></tr></thead><tbody>
        {{#each rows}}<tr>
          <td>{{#if selectable}}<input type="checkbox" data-ag-cl-tick="{{id}}" {{#if ticked}}checked{{/if}} aria-label="Link {{name}}">{{/if}}</td>
          <td><strong>{{name}}</strong><code>{{sourceId}}</code></td>
          <td>{{refText}}</td>
          <td>{{#if best}}<strong>{{best.name}}</strong> <span class="ag-badge">{{best.confidence}}</span><div class="agmanager-tiny">{{best.sourceLabel}} · matched on {{matchedOn}}</div>
            {{#if hasOthers}}<details><summary class="agmanager-tiny">Other candidates ({{others.length}})</summary><ul>{{#each others}}<li>{{name}} — {{confidence}}, {{sourceLabel}}</li>{{/each}}</ul></details>{{/if}}{{else}}—{{/if}}</td>
          <td>{{reason}}
            {{#if selectable}}{{#if canAdopt}}<label class="agmanager-toggle"><input type="checkbox" data-ag-cl-linkonly="{{id}}" {{#if linkOnly}}checked{{/if}}> Link only (keep my data)</label>{{/if}}{{/if}}
            {{#if diffCount}}<details><summary class="agmanager-tiny">What Adopt changes ({{diffCount}} field(s))</summary>
              <table class="agmanager-table"><thead><tr><th>Field</th><th>Now</th><th>Core</th></tr></thead><tbody>{{#each diff}}<tr><td><code>{{path}}</code></td><td>{{before}}</td><td>{{after}}</td></tr>{{/each}}</tbody></table></details>{{/if}}</td>
        </tr>{{/each}}
        </tbody></table>
      </div>
      {{/each}}
      <footer class="agmanager-row agmanager-mood-footer">
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="cl-clear">Cancel</button>
        <span class="agmanager-row">
          <button type="button" class="ag-btn" data-ag-action="cl-backup" {{#unless cl.preview.tickedCount}}disabled{{/unless}}><i class="fa-solid fa-download"></i> Download backup</button>
          <button type="button" class="ag-btn ag-btn--primary" data-ag-action="cl-apply" {{#unless cl.preview.tickedCount}}disabled{{/unless}}><i class="fa-solid fa-link"></i> Apply ({{cl.preview.tickedCount}})…</button>
        </span>
      </footer>
      {{/if}}
    </section>
    <section class="ag-card" aria-label="Core link history">
      <div class="agmanager-row agmanager-row-wrap"><h3>Recent core-link runs</h3>
        <button type="button" class="ag-btn" data-ag-action="cl-undo" {{#unless cl.history.length}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Undo last core link…</button></div>
      {{#if cl.history.length}}<ul>{{#each cl.history}}<li>{{at}} · {{count}} linked · {{adopted}} adopted</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">No core-link runs yet. The last 5 are kept for Undo.</p>{{/if}}
    </section>
  </div>
  {{/if}}

  {{#if setupActive}}
  <div class="agmanager-panel agmanager-organize">
    <section class="ag-card" aria-label="NPC Codex">
      <h3>NPC Codex <span class="agmanager-beta">GM only</span></h3>
      <label class="agmanager-toggle"><input type="checkbox" data-ag-codex-access {{#if codexPlayerAccess}}checked{{/if}}> Players can open the NPC Codex (Configure Settings → Open NPC Codex, or the Character Hub later). They only ever get NPCs and fields you reveal to the party or their character. Saved when ticked.</label>
    </section>
    <section class="ag-card" aria-label="Core sources">
      <h3>Core sources <span class="agmanager-beta">GM only</span></h3>
      <p class="agmanager-tiny">Where Core Links looks for 2024 (5.5e) core items. Legacy 2014 content is always left out, wherever it is.</p>
      <label class="agmanager-toggle"><input type="checkbox" data-ag-setup-auto {{#if setup.auto}}checked{{/if}}> Detect automatically: world items imported by Plutonium or marked 2024, 2024 entries in world compendiums, and the dnd5e 2024 packs</label>
      <h4>Also use these compendiums</h4>
      <div class="agmanager-row agmanager-row-wrap">{{#each setup.packs}}<label class="agmanager-toggle"><input type="checkbox" data-ag-setup-pack="{{id}}" {{#if configured}}checked{{/if}}> {{label}} <code>{{id}}</code>{{#if detected}} <span class="ag-badge">detected</span>{{/if}}</label>{{/each}}</div>
      <h4>Also use world Item folders</h4>
      <div class="agmanager-row agmanager-row-wrap">{{#each setup.folders}}<label class="agmanager-toggle"><input type="checkbox" data-ag-setup-folder="{{id}}" {{#if configured}}checked{{/if}}> {{name}}</label>{{else}}<span class="agmanager-tiny">No Item folders.</span>{{/each}}</div>
      <p class="agmanager-tiny" role="status">{{setupMessage}}</p>
      <footer class="agmanager-row agmanager-mood-footer"><span></span>
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="setup-save"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button></footer>
    </section>
  </div>
  {{/if}}

  {{#if historyActive}}
  <div class="agmanager-panel">
    <h3>Recent import operations</h3>
    <p>History is a compact activity log, <strong>not</strong> an undo system. The manager downloads pre-change snapshots for updates and destructive operations. Keep a Foundry world backup.</p>
    {{#if hasHistory}}
      {{#each history}}
      <details class="agmanager-history">
        <summary><strong>{{packageId}}</strong> · v{{packageVersion}} · {{at}} · {{results.length}} record(s)</summary>
        <div class="agmanager-history-records">
        {{#each results}}
          <div><span class="agmanager-badge">{{status}}</span> <code>{{id}}</code> {{action}} {{message}} {{uuid}}</div>
        {{/each}}
        </div>
      </details>
      {{/each}}
    {{else}}<p>No imports recorded yet.</p>{{/if}}
  </div>
  {{/if}}
</section>
