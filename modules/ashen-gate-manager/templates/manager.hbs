<section class="agmanager-body ag-window">
  <header class="ag-header agmanager-top">
    <div class="ag-header__title"><h1><i class="agmanager-emblem fa-solid fa-boxes-stacked" aria-hidden="true"></i> <span class="ag-header__brand">Ashen Gate</span> | General Manager</h1></div>
    <div class="ag-header__meta">
      <div class="agmanager-appearance-menu" data-ag-appearance-menu>
        <button type="button" class="ag-btn ag-btn--ghost ag-btn--sm agmanager-appearance-toggle" data-ag-appearance-toggle aria-haspopup="dialog" aria-controls="agmanager-appearance-pop" aria-expanded="{{#if appearanceOpen}}true{{else}}false{{/if}}"><i class="fa-solid fa-palette" aria-hidden="true"></i> Appearance <i class="fa-solid fa-caret-down" aria-hidden="true"></i></button>
        <div id="agmanager-appearance-pop" class="agmanager-appearance-pop agmanager-appearance" role="dialog" aria-label="Appearance: GM world default" data-ag-appearance-pop {{#unless appearanceOpen}}hidden{{/unless}}>
          <h3>Appearance <span class="ag-badge ag-badge--accent">World default</span></h3>
          <p class="agmanager-tiny">The default skin for every player who has not picked their own (players see it live; anyone who has not reloaded since a module update needs one refresh, F5). Colour skins change interface colours; Stone Tablet and Tome Pages also reshape panels, tabs and buttons. It never changes Player Access, Actor progress, permissions or content.</p>
          <div class="agm-skin-picker" role="radiogroup" aria-label="Ashen Gate world default appearance" data-ag-skin-picker="world">
            {{#each appearanceSkinRows}}<button type="button" role="radio" class="agm-skin-card{{#if selected}} is-selected{{/if}}{{#if current}} is-current{{/if}}" aria-checked="{{#if selected}}true{{else}}false{{/if}}" tabindex="{{#if selected}}0{{else}}-1{{/if}}" data-ag-skin-value="{{id}}" aria-describedby="ag-wskin-desc-{{id}}"><span class="agm-swatch" aria-hidden="true">{{#each swatch}}<i style="background:{{this}}"></i>{{/each}}</span><span class="agm-skin-card__text"><span class="agm-skin-card__name">{{label}}</span><small id="ag-wskin-desc-{{id}}" class="agm-skin-card__desc">{{description}}</small>{{#if current}}<small class="agm-skin-card__now">Saved world default</small>{{/if}}</span></button>{{/each}}
          </div>
          <p role="status" class="ag-notice ag-notice--info"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{appearanceMessage}}</p>
          <p class="agmanager-tiny">Effective on your screen: {{appearanceCurrent.effective}} · Your override: {{#if appearanceCurrent.userOverride}}{{appearanceCurrent.userOverride}}{{else}}Inherit GM default{{/if}}</p>
          <div class="ag-field" data-ag-size-field="gm">
            <span id="ag-size-label-gm">Size</span>
            <div><div class="ag-segmented" role="radiogroup" aria-labelledby="ag-size-label-gm" aria-describedby="ag-size-hint-gm" data-ag-size-picker="gm">{{#each appearanceSizes}}<button type="button" role="radio" aria-checked="{{#if selected}}true{{else}}false{{/if}}" tabindex="{{#if selected}}0{{else}}-1{{/if}}" data-ag-size-value="{{id}}">{{label}}</button>{{/each}}</div></div>
            <small id="ag-size-hint-gm" class="ag-field__hint">Comfortable makes text and controls larger on this device only.</small>
          </div>
          <p class="agmanager-tiny">For all players: Foundry Game Settings → <strong>Ashen Gate | My Appearance</strong>. The separate player-safe screen cannot open this GM-only Manager. <button type="button" class="ag-btn ag-btn--ghost ag-btn--sm" data-ag-action="appearance-my-appearance">Open My Appearance</button></p>
          <footer class="ag-footer agmanager-appearance-actions">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="appearance-cancel">Cancel</button>
            <button type="button" class="ag-btn ag-btn--primary" data-ag-action="appearance-save-world" {{#if busy}}disabled{{/if}}>Save World Default</button>
          </footer>
        </div>
      </div>
      <span class="ag-gm-flag"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> GM only</span>
      <span class="ag-version">v{{version}}</span>
      <button type="button" class="ag-btn ag-btn--ghost ag-btn--sm" data-ag-action="help"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> Help</button>
    </div>
  </header>
  <nav class="ag-tabs ag-tabs--scroll agmanager-nav" role="tablist" aria-label="Manager tabs">
    <button type="button" role="tab" aria-selected="{{#if importActive}}true{{else}}false{{/if}}" data-ag-tab="import" class="{{#if importActive}}active{{/if}}"><i class="fa-solid fa-file-import" aria-hidden="true"></i> Import</button>
    <button type="button" role="tab" aria-selected="{{#if itemsActive}}true{{else}}false{{/if}}" data-ag-tab="items" class="{{#if itemsActive}}active{{/if}}"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> Items</button>
    <button type="button" role="tab" aria-selected="{{#if modulesActive}}true{{else}}false{{/if}}" data-ag-tab="modules" class="{{#if modulesActive}}active{{/if}}"><i class="fa-solid fa-grip" aria-hidden="true"></i> Modules</button>
    <button type="button" role="tab" aria-selected="{{#if scenesActive}}true{{else}}false{{/if}}" data-ag-tab="scenes" class="{{#if scenesActive}}active{{/if}}"><i class="fa-solid fa-cloud-sun" aria-hidden="true"></i> Scenes</button>
    <button type="button" role="tab" aria-selected="{{#if historyActive}}true{{else}}false{{/if}}" data-ag-tab="history" class="{{#if historyActive}}active{{/if}}"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> History</button>
    <button type="button" role="tab" aria-selected="{{#if setupActive}}true{{else}}false{{/if}}" data-ag-tab="setup" class="ag-tab--gm{{#if setupActive}} active{{/if}}"><i class="fa-solid fa-gears" aria-hidden="true"></i> GM Setup</button>
  </nav>

  <div class="ag-scroll agm-pane">
  {{#if importActive}}
  <section class="ag-section agm-import" aria-label="Import a package">
    <div class="ag-cluster">
      <label class="ag-btn agmanager-filelabel"><i class="fa-solid fa-folder-open" aria-hidden="true"></i> Choose JSON or ZIP package <input type="file" data-ag-file accept=".json,.zip,application/json,application/zip" {{#if busy}}disabled{{/if}} /></label>
      <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="reset">Clear</button>
      <button type="button" class="ag-btn" data-ag-action="export" {{#unless hasPackage}}disabled{{/unless}}><i class="fa-solid fa-download" aria-hidden="true"></i> Download report</button>
    </div>
    <dl class="agmanager-package">
      <div><dt>Package</dt><dd>{{packageId}}</dd></div>
      <div><dt>Version</dt><dd>{{packageVersion}}</dd></div>
      <div><dt>Schema</dt><dd>{{schemaVersion}}</dd></div>
      <div><dt>Records</dt><dd>{{recordCount}}</dd></div>
    </dl>
    {{#if zipBundle}}<div class="agmanager-zip-contents" aria-label="ZIP contents">
      <h3 class="ag-section__title">ZIP contents: {{zipBundle.source}}</h3>
      <p class="agmanager-tiny">{{zipBundle.summary}} Files import one at a time in this order (Manager packages first), each through the normal preview and Apply; nothing changes until you confirm each Apply.</p>
      <div class="ag-table-wrap"><table class="ag-table"><thead><tr><th scope="col">Import</th><th scope="col">File</th><th scope="col">Type</th><th scope="col" class="is-num">Records</th><th scope="col">Status</th></tr></thead><tbody>
      {{#each zipBundle.rows}}<tr class="{{#if isCurrent}}is-selected{{/if}}">
        <td><input type="checkbox" data-ag-zip-pick="{{filename}}" {{#if picked}}{{#unless isError}}checked{{/unless}}{{/if}} {{#unless canPick}}disabled{{else}}{{#if @root.busy}}disabled{{/if}}{{/unless}} aria-label="Import {{filename}}" /></td>
        <td><code>{{filename}}</code></td><td>{{label}}</td><td class="is-num">{{count}}</td>
        <td>{{status}}{{#if notice}}<div class="agmanager-tiny">{{notice}}</div>{{/if}}</td></tr>{{/each}}
      {{#each zipBundle.skipped}}<tr><td></td><td><code>{{filename}}</code></td><td>Skipped</td><td class="is-num">—</td><td class="agmanager-tiny">{{reason}}</td></tr>{{/each}}
      </tbody></table></div>
      <div class="ag-cluster agm-gap-top">
        {{#if zipBundle.running}}<button type="button" class="ag-btn ag-btn--ghost" data-ag-action="zip-cancel">Stop ZIP import</button><button type="button" class="ag-btn" data-ag-action="zip-skip">Skip this file</button>
        {{else}}<button type="button" class="ag-btn" data-ag-action="zip-start" {{#unless zipBundle.pickedCount}}disabled{{/unless}}><i class="fa-solid fa-list-check" aria-hidden="true"></i> Import selected files ({{zipBundle.pickedCount}})</button>{{/if}}
      </div>
    </div>{{/if}}
    <p class="agmanager-tiny"><strong>Source:</strong> {{packageSource}}. Supported: a Manager package (Item, Journal, Actor, RollTable, Macro, Location) or a Quest, Skill Tree, Headquarters facility or Factions file, which Manager recognises and hands to that module. A ZIP can hold one Manager package, or several import files (Manager packages plus Quest, Skill Tree, Headquarters and Factions files) that you pick from a ZIP contents list; source JSON and executable scripts are not run.</p>
    {{#if hasPackage}}<div class="ag-cluster">{{#each typeSummary}}<span class="ag-badge">{{name}}: {{count}}</span>{{/each}}</div>{{/if}}
    {{#if hasZipPortraits}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-upload-assets {{#if uploadZipArtwork}}checked{{/if}} {{#if busy}}disabled{{/if}}> Upload matching ZIP portraits into this world's <code>ashen-gate-imports</code> folder before creating documents ({{zipPortraitCount}} images available).</label>{{/if}}
    <details class="agm-details"><summary>Advanced import options</summary>
    <div class="ag-cluster">
      <label class="agmanager-search-label">Import profile
        <select data-ag-profile {{#if busy}}disabled{{/if}}>
          <option value="development" {{#if developmentProfile}}selected{{/if}}>Development — include unapproved</option>
          <option value="session-safe" {{#if sessionProfile}}selected{{/if}}>Session-safe — approved only</option>
        </select>
      </label>
      <span class="agmanager-tiny">Profiles change preview defaults only; they never apply changes automatically.</span>
    </div>
    <p class="agmanager-tiny"><strong>Advanced / sample files.</strong> Package templates (<code>templates</code> + <code>template_ref</code> in the JSON) are compiled automatically on load; they do not rewrite existing Items.</p>
    <div class="ag-cluster"><button type="button" class="ag-btn ag-btn--sm" data-ag-action="template-example"><i class="fa-solid fa-download" aria-hidden="true"></i> Download sample template package</button><button type="button" class="ag-btn ag-btn--sm" data-ag-action="import-format-example"><i class="fa-solid fa-download" aria-hidden="true"></i> Download v0.2 Import JSON starter</button><button type="button" class="ag-btn ag-btn--sm" data-ag-action="source-manifest-template"><i class="fa-solid fa-download" aria-hidden="true"></i> Download canonical source manifest</button></div>
    </details>
    {{#unless isSpecialist}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-drafts {{#if includeDrafts}}checked{{/if}} {{#if busy}}disabled{{/if}}> Include <strong>draft / proposed / example</strong> records (sandbox testing only)</label>{{/unless}}
    {{#if isSpecialist}}{{#if specialistCanUpdate}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Update existing {{specialistNoun}}</strong> (otherwise ones already in the world are kept as they are)</label>{{else}}<p class="agmanager-tiny">{{specialistLabel}} keeps {{specialistNoun}} that are already in the world; this file only adds new ones.</p>{{/if}}
    {{else}}{{#if hasLocationRecords}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-update-existing {{#if updateExisting}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Update existing locations, routes and shops</strong> (otherwise those already in the world are kept as they are; discovery, reveal and journey state, and shop stock, coins and sales are always kept)</label>{{/if}}
    {{#if hasActorRecords}}<label class="ag-field--inline agmanager-toggle"><input type="checkbox" data-ag-update-actors {{#if updateActors}}checked{{/if}} {{#if busy}}disabled{{/if}}> <strong>Update existing actors</strong> (name, image, token settings and package items only; HP, XP, level, conditions, player items, notes, ownership, folders and other modules' data are always kept. Off: actors already in the world are kept as they are)</label>{{/if}}{{/if}}
    <div class="ag-cluster">
      <button type="button" class="ag-btn" data-ag-action="preview" {{#unless hasPackage}}disabled{{/unless}}><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Validate &amp; Preview</button>
      <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="select" {{#unless hasPreview}}disabled{{/unless}}>Select eligible</button>
      <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="clear" {{#unless hasPreview}}disabled{{/unless}}>Deselect all</button>
    </div>
    <p class="agmanager-tiny">Folder destinations: <code>foundry.folder_path</code> (e.g. <code>Ashen Gate/Professions/Recipes</code>). Explicit links: <code>[[AGREF:MAT-EXAMPLE|Material]]</code>. Missing/ambiguous UUID targets are reported in History.</p>
    <p class="agmanager-tiny">Importer accepts versioned Foundry projection JSON, or a ZIP with one valid projection. Locations and campaign state remain with their specialist modules. Imported Macros are not executed.</p>
    <p class="ag-notice ag-notice--info" role="status"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{message}}</p>
    {{#if hasImportReports}}
    <section class="agmanager-result-panel" aria-label="Import results" aria-live="polite">
      <div class="ag-section__head"><h3 class="ag-section__title">Import results</h3><button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-action="clear-results">Clear results</button></div>
      {{#each importReports}}
      <article class="agmanager-result agmanager-result-{{tone}}">
        <header><span class="ag-badge {{#if isError}}ag-badge--danger{{else}}{{#if isWarn}}ag-badge--warn{{else}}ag-badge--ok{{/if}}{{/if}}">{{toneLabel}}</span> <strong>{{file}}</strong> <small>{{at}}</small></header>
        <p class="agmanager-result-headline">{{headline}}</p>
        {{#each notes}}<p class="agmanager-tiny">{{this}}</p>{{/each}}
        {{#each sections}}
        <div class="agmanager-result-module">
          <h4>{{module}} <small>{{countText}}</small></h4>
          {{#if where}}<p class="agmanager-tiny"><strong>Find it:</strong> {{where}}</p>{{/if}}
          <ul>
            {{#each lines}}
            <li class="agmanager-result-line agmanager-line-{{outcome}}"><span class="ag-badge">{{label}}</span> {{#if name}}{{name}} {{/if}}{{#if id}}<code>{{id}}</code>{{/if}}{{#if message}} — {{message}}{{/if}}{{#if fix}}<br><strong>Fix:</strong> {{fix}}{{/if}}</li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
      </article>
      {{/each}}
    </section>
    {{/if}}
    {{#if hasModuleLinks}}<div class="ag-notice ag-notice--info" role="status"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><div><strong>Links to other Ashen Gate modules</strong> (for information; those records are imported separately and their ids are kept)<ul>{{#each moduleLinks}}<li>{{message}}</li>{{/each}}</ul></div></div>{{/if}}
    {{#if hasWarnings}}<div class="ag-notice ag-notice--warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><div><strong>Import review notes</strong><ul>{{#each warnings}}<li>{{message}}</li>{{/each}}</ul></div></div>{{/if}}
    {{#if hasErrors}}
      <div class="ag-notice ag-notice--danger" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><div><strong>Validation failed — import blocked</strong><ul>{{#each errors}}<li>{{message}}</li>{{/each}}</ul></div></div>
    {{/if}}
  </section>

  {{#if hasPreview}}
  <section class="ag-section agmanager-results" aria-label="Import preview">
    <div class="ag-cluster agmanager-summary">
      <span class="ag-badge ag-badge--ok"><strong>{{summary.create}}</strong> new</span>
      <span class="ag-badge ag-badge--ok"><strong>{{summary.update}}</strong> update</span>
      <span class="ag-badge ag-badge--ok"><strong>{{summary.metadata}}</strong> metadata refresh</span>
      <span class="ag-badge"><strong>{{summary.unchanged}}</strong> unchanged</span>
      <span class="ag-badge ag-badge--danger"><strong>{{summary.conflict}}</strong> conflict</span>
      <span class="ag-badge ag-badge--danger"><strong>{{summary.blocked}}</strong> blocked</span>
      <span class="ag-badge"><strong>{{summary.skipped}}</strong> excluded</span>
      <span class="ag-badge"><strong>{{summary.local}}</strong> local edits</span>
    </div>
    <div class="ag-table-wrap">
    <table class="ag-table">
      <thead><tr><th scope="col">Apply?</th><th scope="col">ID / Name</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Reason</th></tr></thead>
      <tbody>
      {{#each rows}}
      <tr>
        <td><input type="checkbox" data-ag-select="{{id}}" {{#if selected}}checked{{/if}} {{#unless canSelect}}disabled{{else}}{{#if @root.busy}}disabled{{/if}}{{/unless}} aria-label="Select {{name}}" /></td>
        <td><strong>{{name}}</strong><code class="agm-id">{{id}}</code></td>
        <td>{{kind}}<div class="agmanager-tiny">{{lifecycle}}</div></td>
        <td><span class="ag-badge{{#if badgeTone}} ag-badge--{{badgeTone}}{{/if}}">{{badge}}</span></td>
        <td>{{reason}}{{#if changes.length}}<ul class="agmanager-changes">{{#each changes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{#if effectRows.length}}<ul class="agmanager-changes agmanager-effects" aria-label="Effects">{{#each effectRows}}<li><strong>{{label}}</strong> {{name}}{{#if effId}} <code>{{effId}}</code>{{/if}}: {{reason}}</li>{{/each}}</ul>{{/if}}</td>
      </tr>
      {{/each}}
      </tbody>
    </table>
    </div>
    <p class="agmanager-tiny"><strong>GM-controlled.</strong> New Actors, Tables and Macros can be created. Existing Actors change only with <strong>Update existing actors</strong> ticked; character progress is never overwritten. Back up your test world first.</p>
    {{#if actorUpdateCount}}<div class="ag-cluster"><button type="button" class="ag-btn" data-ag-action="backup-actors"><i class="fa-solid fa-download" aria-hidden="true"></i> Download backup of {{actorUpdateCount}} actor(s) to update</button></div>{{/if}}
    <footer class="ag-footer agmanager-footer">
      <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="reset">Cancel</button>
      <button type="button" class="ag-btn ag-btn--primary" data-ag-action="apply" {{#unless canApply}}disabled{{/unless}}><i class="fa-solid fa-check" aria-hidden="true"></i> Import Selected Documents</button>
    </footer>
  </section>
  {{/if}}
  {{/if}}

  {{#if itemsActive}}
  <div class="agitems">
    <div class="ag-toolbar agitems-filters" role="search" aria-label="Item filters (kept across the rail)">
      <label class="ag-search agitems-query"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-ag-items-query value="{{itemFilters.query}}" placeholder="Search name, id, tag, text… (id:MAT-HERB, type:weapon, tag:, status:)" aria-label="Search items" /></label>
      <div class="ag-toolbar__filters">
        <select data-ag-items-filter="source" aria-label="Source">{{#each itemFilters.sources}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select data-ag-items-filter="type" aria-label="Type">{{#each itemFilters.types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select data-ag-items-filter="origin" aria-label="Origin">{{#each itemFilters.origins}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select data-ag-items-filter="rarity" aria-label="Rarity">{{#each itemFilters.rarities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select data-ag-items-filter="folder" aria-label="Folder">{{#each itemFilters.folders}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <label class="ag-field--inline agitems-check"><input type="checkbox" data-ag-items-coreref {{#if itemFilters.coreRef}}checked{{/if}}> Has core_ref</label>
        {{#if itemsAll}}<span class="ag-toolbar__filters" data-ag-browse-tools></span>{{/if}}
      </div>
      <div class="ag-toolbar__end">
        <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-items-clear {{#unless itemFilters.active}}disabled{{/unless}}><span>Clear filters (<span data-ag-items-clear-count>{{itemFilters.active}}</span>)</span></button>
        <button type="button" class="ag-btn ag-btn--sm" data-ag-items-packs><i class="fa-solid fa-book-atlas" aria-hidden="true"></i> <span data-ag-items-packs-label>{{itemFilters.packsLabel}}</span></button>
      </div>
    </div>
    {{#if itemFilters.packsNote}}<p class="agmanager-tiny agitems-note">{{itemFilters.packsNote}}</p>{{/if}}
  <div class="aglib">
    <nav class="aglib-rail" aria-label="Items sections">
      {{#each itemsViews}}<button type="button" class="aglib-rail__tab {{#if active}}active{{/if}}" data-ag-items-view="{{id}}" data-tooltip="{{label}}" data-tooltip-class="ag-tooltip" aria-label="{{label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}"><i class="{{icon}}" aria-hidden="true"></i></button>{{/each}}
    </nav>
    <div class="aglib-main">
    <h3 class="agitems-title">{{itemsViewLabel}}</h3>
    {{#if itemsAll}}
    <div class="agbrowse" data-ag-browse></div>
    {{/if}}
    {{#if libraryRecordsActive}}
    <div class="aglib-split">
      <section class="aglib-list" aria-label="Managed records">
        <div class="aglib-tools">
          <div class="ag-chip-group" role="group" aria-label="System">
            {{#each librarySystemChips}}<button type="button" class="ag-chip" data-ag-library-system-chip="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{label}} <span class="aglib-num">{{count}}</span></button>{{/each}}
          </div>
          <details class="aglib-filters" {{#if libraryHasFilters}}open{{/if}}>
            <summary>More filters{{#if libraryHasFilters}} <span class="ag-badge ag-badge--accent">{{libraryFilterCount}}</span>{{/if}}</summary>
            <div class="aglib-filter-grid">
              <label>Status <select data-ag-library-status>{{#each libraryStatusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
              <label>Package <select data-ag-library-package>{{#each libraryPackageOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}{{#if count}} ({{count}}){{/if}}</option>{{/each}}</select></label>
              <label class="ag-field--inline aglib-check"><input type="checkbox" data-ag-library-show-archived {{#if libraryShowArchived}}checked{{/if}}> Show archived</label>
            </div>
          </details>
          {{#if libraryNarrowed}}<p class="agmanager-tiny">The filters above leave {{libraryInScope}} of {{libraryTotal}} records.</p>{{/if}}
          <div class="aglib-count"><span>{{libraryFilteredCount}} of {{libraryTotal}} records</span><span>{{libraryEditedCount}} edited · {{libraryActiveCount}} active</span></div>
        </div>
        <div class="aglib-rows">
          {{#each libraryGroups}}
          <div class="aglib-group"><span>{{label}}</span><span class="aglib-num">{{count}}</span></div>
          {{#each rows}}<div class="aglib-row {{#if focused}}is-focused{{/if}}">
            <input type="checkbox" data-ag-library-select="{{uuid}}" {{#if selected}}checked{{/if}} aria-label="Select {{name}}" />
            <button type="button" class="aglib-row__main" data-ag-library-inspect="{{uuid}}" {{#if focused}}aria-current="true"{{/if}}{{{tooltip}}}>
              <span class="aglib-row__name">{{name}}</span>
              <span class="aglib-row__meta"><code>{{sourceId}}</code><span class="ag-badge{{#if statusTone}} ag-badge--{{statusTone}}{{/if}}">{{status}}</span>{{#if archived}}<span class="ag-badge ag-badge--danger">archived</span>{{/if}}{{#if version}}<span class="ag-badge">v{{version}}</span>{{/if}}{{#if edited}}<span class="ag-badge ag-badge--warn">{{edited}} edit(s)</span>{{/if}}</span>
            </button>
          </div>{{/each}}
          {{else}}{{#if libraryTotal}}<div class="ag-empty aglib-empty"><p class="ag-empty__title">Nothing matches</p><p class="ag-empty__text">Clear the search or filters.</p></div>{{else}}<div class="ag-empty aglib-empty"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><p class="ag-empty__title">No Ashen Gate records yet</p><p class="ag-empty__text">Import an Ashen Gate package on the Import tab. Items from D&amp;D Beyond, Plutonium or compendiums are under All items.</p></div>{{/if}}{{/each}}
        </div>
        <div class="aglib-selbar">
          {{#if hasLibrarySelected}}<strong class="aglib-num">{{librarySelectedCount}} selected</strong>
          <details class="aglib-menu">
