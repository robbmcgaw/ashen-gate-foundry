            <button type="button" class="ag-btn" data-ag-action="cl-undo" {{#unless cl.history.length}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Undo last core link…</button></div>
          {{#if cl.history.length}}<ul>{{#each cl.history}}<li>{{at}} · {{count}} linked · {{adopted}} adopted</li>{{/each}}</ul>{{else}}<p class="agmanager-tiny">No core-link runs yet. The last 5 are kept for Undo.</p>{{/if}}
        </section>
      </div>
      {{/if}}
    </div>
  </div>
  </div>
  {{/if}}

  {{#if modulesActive}}
  <div class="agmanager-panel">
    <section class="ag-card agmanager-presession" aria-label="Pre-session check">
      <h3>Pre-session check</h3>
      <p class="agmanager-tiny">Checks module versions, GM storage, Player Access, [TEST] data, hidden names in player views, Locations migration and the Foundry version. Read-only: it never changes a document or setting. GM only.</p>
      <div class="agmanager-row agmanager-row-wrap">
        <button type="button" class="ag-btn ag-btn--primary" data-ag-action="presession-run"><i class="fa-solid fa-stethoscope"></i> Run pre-session check</button>
        <button type="button" class="ag-btn" data-ag-action="presession-copy" {{#unless preSession.hasText}}disabled{{/unless}}><i class="fa-solid fa-copy"></i> Copy report</button>
        <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="presession-download" {{#unless preSession.hasText}}disabled{{/unless}}><i class="fa-solid fa-download"></i> Download report</button>
      </div>
      {{#if preSession}}
      <p class="agmanager-presession-summary"><strong>{{preSession.summary}}</strong></p>
      <div class="agmanager-presession-rows">
      {{#each preSession.rows}}<div class="agmanager-presession-row agmanager-presession-{{css}}"><span class="agmanager-presession-status">{{status}}</span><span class="agmanager-presession-check">{{check}}</span><span>{{text}}</span></div>{{/each}}
      </div>
      {{/if}}
    </section>
    <h3>Ashen Gate Modules <span class="agmanager-beta">BETA</span></h3>
    <p>Open other Ashen Gate modules from one place. The Manager discovers <strong>installed modules</strong> and uses their published <code>api.open()</code> launcher or registered Foundry settings window; it doesn't assume a module has an interface.</p>
    <section class="agmanager-access-bar" aria-label="Player module access">
      <div class="agmanager-row agmanager-row-wrap agmanager-access-actions">
        <span class="agmanager-tiny">Player access: show or hide each module's player interface. Each module saves its own setting; hiding never deletes progress.</span>
        <button type="button" data-ag-action="player-access-refresh" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Refresh</button>
        <button type="button" data-ag-action="player-access-hide-all" {{#unless playerAccessHasVisible}}disabled{{/unless}}><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide all ({{playerAccessVisibleCount}})</button>
      </div>
      <p class="agmanager-notice" role="status">{{playerAccessMessage}}</p>
      {{#if playerAccessReport}}
        <details open class="agmanager-access-report"><summary>Hide all: {{playerAccessReport.changed.length}} hidden; {{playerAccessReport.failed.length}} failed; {{playerAccessReport.skipped.length}} skipped</summary>
          {{#each playerAccessReport.failed}}<p class="agmanager-missing">Failed: {{title}} — {{error}}</p>{{/each}}
          {{#each playerAccessReport.skipped}}<p>Skipped: {{title}} ({{reason}})</p>{{/each}}
        </details>
      {{/if}}
    </section>
    <div class="agmanager-module-grid">
    {{#each moduleCards}}
      <article class="agmanager-module-card" title="{{accessReason}}">
        <div class="agmanager-module-card__info"><h4>{{title}}</h4><code>{{id}}</code>
          <p class="agmanager-module-card__badge"><span class="ag-badge{{#if badge.tone}} ag-badge--{{badge.tone}}{{/if}}">{{badge.label}}</span></p>
          <p class="agmanager-tiny">v{{version}} · {{state}} · Player access: {{playerAccessState}} (GM launcher remains available)</p><p class="agmanager-tiny">{{role}}</p>
          {{#unless canToggle}}<p class="agmanager-tiny">{{accessReason}}</p>{{/unless}}</div>
        <div class="agmanager-module-card__actions">
          <button type="button" data-ag-module-open="{{id}}" {{#unless canOpen}}disabled{{/unless}}>Open</button>
          {{#if canToggle}}
            {{#if playerAccessEnabled}}<button type="button" data-ag-player-access-toggle="{{id}}" data-ag-player-access-enabled="false" {{#if @root.busy}}disabled{{/if}} aria-label="Hide {{title}} from players"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide from players</button>
            {{else}}<button type="button" data-ag-player-access-toggle="{{id}}" data-ag-player-access-enabled="true" {{#if @root.busy}}disabled{{/if}} aria-label="Reveal {{title}} to players"><i class="fa-solid fa-eye" aria-hidden="true"></i> Reveal to players</button>{{/if}}
          {{/if}}
        </div>
      </article>
    {{else}}<p>No other Ashen Gate modules were detected in this world. Enable a module and reopen this tab.</p>
    {{/each}}
    </div>
    <p class="agmanager-tiny">Reveal / Hide needs <code>ag-player-access/1</code>; older modules show Unsupported. GM-only editors (Manager, Location Builder) cannot be revealed.</p>
    <p class="agmanager-tiny">Disabled means the module is inactive or has not exposed an Open API / settings menu. Turn a module on in Manage Modules to open it from here. This tab never installs, enables or changes another module.</p>
  </div>
  {{/if}}

