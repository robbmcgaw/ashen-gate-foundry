          <div class="aglib-detail__title"><h3>{{name}}</h3>
            <div class="aglib-row__meta"><code>{{id}}</code>{{#if status}}<span class="aglib-pill">{{status}}</span>{{/if}}</div></div>
          <button type="button" class="ag-btn" data-ag-action="codex-open-actor"><i class="fa-solid fa-user" aria-hidden="true"></i> Actor sheet</button>
          <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="codex-close" aria-label="Close details"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
        <div class="agcodex-field agcodex-field--discovery">
          <div><div class="agcodex-label">Players know this NPC</div><p class="agmanager-tiny">Name and portrait. Nothing else shows to a player until this includes them.</p></div>
          {{#with discoverySeg}}<div class="agcodex-control"><div class="agcodex-seg" role="group" aria-label="Who knows: {{label}}">
            <button type="button" class="{{#if isHidden}}is-on{{/if}}" data-ag-codex-reveal="{{key}}" data-mode="hidden" aria-pressed="{{#if isHidden}}true{{else}}false{{/if}}">Hidden</button>
            <button type="button" class="{{#if isParty}}is-on is-party{{/if}}" data-ag-codex-reveal="{{key}}" data-mode="party" aria-pressed="{{#if isParty}}true{{else}}false{{/if}}">Party</button>
            <details class="aglib-menu agcodex-chars"><summary class="{{#if isActors}}is-on is-actors{{/if}}">Characters <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
              <div class="aglib-menu__pop agcodex-chars__pop">{{#each chars}}<label><input type="checkbox" data-ag-codex-actor="{{../key}}" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{else}}<p class="agmanager-tiny">No player characters yet (character Actors with a player owner).</p>{{/each}}</div>
            </details></div>
            {{#if isActors}}<p class="agcodex-who">Known by {{who}}</p>{{/if}}</div>{{/with}}
        </div>
        {{#each fields}}
        <div class="agcodex-field">
          <div class="agcodex-field__body"><div class="agcodex-label">{{label}}</div>
            {{#if isLinks}}{{#if ../links.length}}<div class="agcodex-links">{{#each ../links}}{{#if open}}<a class="agcodex-link agcodex-link--{{kind}}" role="button" data-ag-codex-deity="{{id}}" title="{{title}}"><i class="fa-solid fa-sun" aria-hidden="true"></i> {{name}}{{#if named}} <code>{{id}}</code>{{/if}}</a>{{else}}<span class="agcodex-link agcodex-link--{{kind}}"{{#if title}} title="{{title}}"{{/if}}>{{name}}{{#if named}} <code>{{id}}</code>{{/if}}</span>{{/if}}{{/each}}</div>{{else}}<p class="agmanager-tiny">No connections. Add ids below or in the record's <code>codex.links</code>.</p>{{/if}}
            {{else}}{{#if empty}}<p class="agmanager-tiny">Not set.</p>{{else}}<p class="agcodex-value">{{value}}</p>{{/if}}{{/if}}
          </div>
          <div class="agcodex-control"><div class="agcodex-seg" role="group" aria-label="Who knows: {{label}}">
            <button type="button" class="{{#if isHidden}}is-on{{/if}}" data-ag-codex-reveal="{{key}}" data-mode="hidden" aria-pressed="{{#if isHidden}}true{{else}}false{{/if}}">Hidden</button>
            <button type="button" class="{{#if isParty}}is-on is-party{{/if}}" data-ag-codex-reveal="{{key}}" data-mode="party" aria-pressed="{{#if isParty}}true{{else}}false{{/if}}">Party</button>
            <details class="aglib-menu agcodex-chars"><summary class="{{#if isActors}}is-on is-actors{{/if}}">Characters <i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary>
              <div class="aglib-menu__pop agcodex-chars__pop">{{#each chars}}<label><input type="checkbox" data-ag-codex-actor="{{../key}}" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{else}}<p class="agmanager-tiny">No player characters yet (character Actors with a player owner).</p>{{/each}}</div>
            </details></div>
            {{#if isActors}}<p class="agcodex-who">Known by {{who}}</p>{{/if}}</div>
        </div>
        {{/each}}
        <div class="agcodex-gm">
          <h4><i class="fa-solid fa-lock" aria-hidden="true"></i> GM only: never sent to players</h4>
          {{#each gmFields}}<div class="agcodex-gmrow"><span class="agcodex-label">{{label}}</span>{{#if items}}<ul class="agcodex-value">{{#each items}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p class="agcodex-value">{{text}}</p>{{/if}}</div>{{else}}<p class="agmanager-tiny">The record has no portrayal, session role, stat block or GM notes.</p>{{/each}}
        </div>
        <div class="agcodex-edit">
          <label class="ag-field">What the party has learned <textarea rows="3" data-ag-codex-learned>{{learned}}</textarea></label>
          <label class="ag-field">Connections (ids, space separated: LOC-, FAC-, DEITY-, QUEST-, NPC-) <input type="text" data-ag-codex-links value="{{linksText}}"></label>
          <label class="ag-field">Your notes (GM only) <textarea rows="3" data-ag-codex-notes>{{notes}}</textarea></label>
          <footer class="agcodex-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="codex-cancel">Cancel</button>
            <button type="button" class="ag-btn aglib-danger" data-ag-action="codex-hide-all"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Hide from players…</button>
            <button type="button" class="ag-btn ag-btn--primary" data-ag-action="codex-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Changes</button>
          </footer>
        </div>
        <div class="agcodex-preview">
          <label class="agcodex-preview__pick">Preview as <select data-ag-codex-preview>{{#each ../codex.previewOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{#if ../codex.previewing}}{{{../codex.previewHtml}}}{{else}}<p class="agmanager-tiny">Choose the party or a character to see exactly what they receive.</p>{{/if}}
        </div>
        {{else}}
        <div class="ag-empty aglib-empty"><i class="fa-solid fa-address-book" aria-hidden="true"></i><p>Choose an NPC to set who knows what.</p>
          <p class="agmanager-tiny">Content comes from the imported NPC record. Reveals, what the party has learned, connections and your notes are kept on re-import.</p></div>
        {{/with}}
        <p class="aglib-status" role="status">{{codex.message}}</p>
      </section>
    </div>
    {{/if}}

      {{#if organizeActive}}
      <div class="agmanager-panel agmanager-organize">
        <section class="ag-card agclean" aria-label="Clean compendiums">
          <div class="agmanager-row agmanager-row-wrap"><h3>Clean compendiums <span class="agmanager-beta">GM only</span></h3>
            <button type="button" class="ag-btn ag-btn--primary agclean-go" data-ag-action="clean-scan"><i class="fa-solid fa-broom" aria-hidden="true"></i> Clean compendiums</button></div>
          <p class="agmanager-tiny">One click checks the world sidebar (Items, Actors, Journals) and every compendium against the folder rules below (Ashen Gate, Core 5.5e, Homebrew) and lists every document that is not in its folder, including whole imported sets (DDB, Plutonium) sitting in their own folders. Nothing moves until you <strong>Commit</strong>. The filters above do not apply here. Protected folders, Keep here, player characters and player-owned actors are never moved. Locked, module and system compendiums cannot be changed: they are listed as skipped with what you can do.</p>
          <p class="agmanager-tiny" role="status" data-ag-clean-status>{{org.clean.status}}</p>
          {{#with org.clean.preview}}
          <div class="agmanager-row agmanager-row-wrap">
            <span class="agmanager-chip">To move: {{totals.moves}}</span>
            <span class="agmanager-chip">Ticked: <span data-ag-clean-count>{{ticked}}</span></span>
            <span class="agmanager-chip">New folders: {{totals.createFolders}}</span>
            <span class="agmanager-chip">Already in place: {{totals.inPlace}}</span>
            <span class="agmanager-chip">Skipped (protected / Keep here / left alone): {{totals.skipped}}</span>
            <span class="agmanager-chip">No rule: {{totals.unmatched}}</span>
          </div>
          {{#if weak}}<p class="agmanager-warnings">{{weak}} move(s) to Core 5.5e rest on weak evidence (copied from a dnd5e compendium, or a D&amp;D Beyond import with no core source book) and start <strong>unticked</strong>. Tick them only if they really are core items.</p>{{/if}}
          <p class="agmanager-tiny">Each move says why. Core 5.5e needs real evidence: a Plutonium import, a core source book (PHB, DMG, MM 2014 or 2024, SRD 5.1 or 5.2) or a dnd5e compendium. dnd5e gives every new item rules "2024", so that alone counts as Homebrew. To keep your own items where they are, press <strong>Keep here</strong> on a row, or protect their folder under <strong>Protected folders</strong> below.</p>
          {{#each withMoves}}
          <div class="agmanager-org-part">
            <h4>{{label}} — {{moveCount}} to move</h4>
            {{#each parts}}
            <div class="agclean-part">
              <div class="agmanager-row agmanager-row-wrap"><strong>{{label}}: {{moveCount}} to move</strong>{{#if createCount}}<span class="agmanager-tiny">{{createCount}} new folder(s)</span>{{/if}}
                <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-clean-part="{{partKey}}" data-on="true">Tick all</button>
                <button type="button" class="ag-btn ag-btn--sm ag-btn--ghost" data-ag-clean-part="{{partKey}}" data-on="false">Untick all</button></div>
              {{#if skippedCount}}<p class="agmanager-tiny">{{skippedCount}} skipped (protected folder, Keep here, or a rule that leaves them alone){{#if protectedFolders}}: protected {{protectedFolders}}{{/if}}.</p>{{/if}}
              {{#each groups}}
              <details class="agmanager-org-group"><summary>→ <strong>{{path}}</strong> ({{count}})</summary>
                <table class="agmanager-table"><thead><tr><th>Move</th><th>Document</th><th>From</th><th>Why</th><th></th></tr></thead><tbody>
                {{#each rows}}<tr><td><input type="checkbox" data-ag-clean-move="{{key}}" {{#if checked}}checked{{/if}} aria-label="Move {{name}}"></td><td>{{name}}</td><td>{{from}}</td>
                  <td>{{why}}{{#if weak}} <span class="ag-badge ag-badge--warn">weak evidence, unticked</span>{{/if}}</td>
                  <td>{{#if keep}}<button type="button" class="ag-btn ag-btn--sm" data-ag-clean-keep="{{keep.id}}" data-ag-clean-doctype="{{keep.documentName}}" data-ag-clean-key="{{key}}" title="Never move this document">Keep here</button>{{/if}}</td></tr>{{/each}}
                </tbody></table>
              </details>
              {{/each}}
            </div>
            {{/each}}
          </div>
          {{/each}}
          {{#if clean}}<p class="agmanager-tiny">Already sorted: {{clean}}.</p>{{/if}}
          {{#if skippedSources.length}}<details class="agmanager-org-group" open><summary>Skipped compendiums ({{skippedSources.length}})</summary><ul>
            {{#each skippedSources}}<li><strong>{{label}}</strong>: {{#if locked}}locked, skipped. {{/if}}{{hint}}</li>{{/each}}</ul></details>{{/if}}
          <footer class="agmanager-row agmanager-mood-footer">
            <button type="button" class="ag-btn ag-btn--ghost" data-ag-action="clean-cancel">Cancel</button>
            <span class="agmanager-row">
              <button type="button" class="ag-btn" data-ag-action="clean-backup" data-ag-clean-needs-ticks {{#unless ticked}}disabled{{/unless}}><i class="fa-solid fa-download"></i> Download backup</button>
              <button type="button" class="ag-btn ag-btn--primary" data-ag-action="clean-commit" data-ag-clean-needs-ticks {{#unless ticked}}disabled{{/unless}}><i class="fa-solid fa-broom"></i> Commit (<span data-ag-clean-count>{{ticked}}</span>)…</button>
            </span>
          </footer>
          {{/with}}
        </section>
        <section class="ag-card" aria-label="Organize folders">
          <h3>Organize folders <span class="agmanager-beta">GM only</span></h3>
          <p><strong>Where:</strong> {{org.whereLabel}}{{#unless org.whereWritable}} <span class="ag-badge ag-badge--warn">inspect only: {{org.whereReason}}</span>{{/unless}}
